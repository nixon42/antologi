---
interface Props {
  audioUrl: string;
  title?: string;
  author?: string;
}

const { audioUrl, title = "Musikalisasi Puisi", author = "Santri SMPI Yambu'ul Qur'an" } = Astro.props;
---

<div class="audio-player-card my-8 p-5 bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-sm">
  <div class="flex items-center justify-between gap-4 mb-3 flex-wrap">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-[var(--crimson-subtle)] text-[var(--crimson)] flex items-center justify-center">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
        </svg>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-[var(--ink)] m-0 font-['Fraunces',serif]">{title}</h4>
        <p class="text-xs text-[var(--ink-soft)] m-0 font-['Source_Serif_4',serif] italic">{author}</p>
      </div>
    </div>
    <span class="mono text-xs text-[var(--ink-faint)] tracking-wider">AUDIO SASTRA</span>
  </div>

  <audio id="audio-element" src={audioUrl} preload="metadata"></audio>

  <div class="flex items-center gap-3">
    <!-- Play/Pause Button -->
    <button id="audio-play-button" class="w-10 h-10 rounded-full border border-[var(--crimson)] text-[var(--crimson)] hover:bg-[var(--crimson)] hover:text-[var(--paper)] flex items-center justify-center transition-colors cursor-pointer flex-shrink-0" aria-label="Putar Musikalisasi">
      <svg id="play-icon" class="w-4 h-4 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
      <svg id="pause-icon" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
      </svg>
    </button>

    <!-- Progress Scrubber -->
    <div class="flex-grow flex items-center gap-2">
      <span id="current-time" class="mono text-xs text-[var(--ink-faint)] min-w-[36px]">0:00</span>
      <input id="seek-slider" type="range" min="0" max="100" value="0" class="w-full h-1 bg-[var(--paper-deep)] rounded appearance-none cursor-pointer accent-[var(--crimson)]" />
      <span id="duration-time" class="mono text-xs text-[var(--ink-faint)] min-w-[36px]">0:00</span>
    </div>
  </div>
</div>

<script>
  const audio = document.getElementById('audio-element') as HTMLAudioElement;
  const playBtn = document.getElementById('audio-play-button');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  const seekSlider = document.getElementById('seek-slider') as HTMLInputElement;
  const currentTimeSpan = document.getElementById('current-time');
  const durationSpan = document.getElementById('duration-time');

  function formatTime(seconds: number) {
    if (isNaN(seconds)) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  if (audio && playBtn) {
    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play();
        playIcon?.classList.add('hidden');
        pauseIcon?.classList.remove('hidden');
      } else {
        audio.pause();
        playIcon?.classList.remove('hidden');
        pauseIcon?.classList.add('hidden');
      }
    });

    audio.addEventListener('loadedmetadata', () => {
      if (durationSpan) durationSpan.textContent = formatTime(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      if (seekSlider) seekSlider.value = ((audio.currentTime / audio.duration) * 100).toString();
      if (currentTimeSpan) currentTimeSpan.textContent = formatTime(audio.currentTime);
    });

    seekSlider?.addEventListener('input', () => {
      const seekTo = audio.duration * (parseFloat(seekSlider.value) / 100);
      audio.currentTime = seekTo;
    });

    audio.addEventListener('ended', () => {
      playIcon?.classList.remove('hidden');
      pauseIcon?.classList.add('hidden');
      if (seekSlider) seekSlider.value = '0';
    });
  }
</script>
