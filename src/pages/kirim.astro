---
import Layout from '../layouts/Layout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout 
  title="Kirim Naskah Karya Siswa — Ruang Sastra SMPI YQ"
  description="Formulir submisi karya tulis ilmiah, puisi, cerpen, dan naskah drama untuk siswa dan santri SMPI Yambu'ul Qur'an."
>
  <div class="wrap py-10 md:py-16">
    
    <!-- Header -->
    <header class="mb-8 pb-6 border-b border-[var(--rule-strong)]">
      <div class="flex items-center gap-2 mono text-xs text-[var(--crimson)] mb-2 uppercase tracking-wider">
        <a href={`${basePath}/`} class="no-underline hover:underline">Beranda</a>
        <span>/</span>
        <span>Kirim Naskah</span>
      </div>
      <h1 class="font-['Fraunces',serif] font-semibold text-3xl md:text-4xl text-[var(--ink)] m-0">
        Ruang Submisi &amp; Kirim Karya
      </h1>
      <p class="font-['Source_Serif_4',serif] italic text-base md:text-lg text-[var(--ink-soft)] mt-3 max-w-2xl leading-relaxed">
        Punya karya tulis ilmiah, bait puisi, cerpen, atau naskah drama yang ingin diterbitkan di portal Ruang Sastra? Kirimkan naskah Anda melalui formulir di bawah ini.
      </p>
    </header>

    <!-- SECTION: AUTHOR STATUS STRIP (Penulis Active Card or Guest Prompt) -->
    
    <!-- 1. Penulis Logged In Active Card -->
    <div id="penulis-active-card" class="hidden mb-8 p-4 sm:p-5 bg-[var(--paper-card)] border border-[var(--crimson)] rounded-sm flex items-center justify-between flex-wrap gap-4 shadow-xs">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-full bg-[var(--crimson)] text-[var(--paper)] flex items-center justify-center font-['Fraunces',serif] font-bold text-base shadow-inner flex-shrink-0">
          ✍️
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="mono text-[0.68rem] uppercase text-[var(--crimson)] font-semibold tracking-wider">Akun Penulis Aktif</span>
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          </div>
          <h3 class="font-['Fraunces',serif] font-semibold text-base sm:text-lg text-[var(--ink)] m-0 flex items-center gap-2 flex-wrap">
            <span id="active-penulis-name">Penulis Santri</span>
            <span id="active-penulis-grade" class="text-xs font-normal text-[var(--ink-soft)] font-mono px-2 py-0.5 rounded bg-[var(--paper-deep)] border border-[var(--rule)]"></span>
          </h3>
          <span id="active-penulis-email" class="mono text-xs text-[var(--ink-faint)]"></span>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <button 
          id="btn-toggle-riwayat" 
          type="button" 
          class="mono text-xs px-3.5 py-1.5 rounded border border-[var(--rule-strong)] hover:border-[var(--crimson)] text-[var(--ink)] hover:text-[var(--crimson)] bg-[var(--paper)] transition-colors cursor-pointer flex items-center gap-2"
        >
          <span>Riwayat Naskah Saya</span>
          <span id="penulis-karya-badge" class="px-1.5 py-0.2 rounded-full bg-[var(--crimson)] text-[var(--paper)] text-[0.65rem] font-bold">0</span>
        </button>
        <button 
          id="btn-logout-penulis" 
          type="button" 
          class="mono text-xs px-2.5 py-1.5 text-[var(--crimson)] hover:underline cursor-pointer font-medium"
        >
          Keluar
        </button>
      </div>
    </div>

    <!-- 2. Guest Writer Prompt (Shown when not logged in) -->
    <div id="penulis-guest-prompt" class="mb-8 p-4 bg-[var(--paper-deep)] border border-[var(--rule-strong)] rounded-sm flex items-center justify-between flex-wrap gap-3.5 text-xs">
      <div class="flex items-center gap-3">
        <span class="text-lg text-[var(--gold)]">✦</span>
        <p class="m-0 font-['Source_Serif_4',serif] text-[var(--ink)] leading-relaxed text-xs sm:text-sm">
          <strong>Punya akun santri?</strong> Masuk atau daftarkan akun penulis terlebih dahulu agar riwayat naskah Anda tercatat dan dapat dipantau status kurasinya setiap saat.
        </p>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <a href={`${basePath}/admin/login?tab=penulis`} class="btn-literary btn-literary-solid !py-1 !px-3.5 !text-xs no-underline">
          Masuk Penulis →
        </a>
        <a href={`${basePath}/admin/login?tab=penulis&mode=daftar`} class="mono text-xs text-[var(--crimson)] font-semibold hover:underline px-2">
          Daftar Akun Baru ↗
        </a>
      </div>
    </div>

    <!-- 3. Expandable Author Manuscript Tracker -->
    <div id="penulis-riwayat-container" class="hidden mb-10 p-5 bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-sm space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[var(--rule)]">
        <div>
          <h3 class="font-['Fraunces',serif] font-semibold text-lg text-[var(--ink)] m-0">
            Daftar Naskah Kiriman Anda
          </h3>
          <p class="mono text-xs text-[var(--ink-faint)] m-0 mt-0.5">
            Pantau status kurasi naskah yang telah Anda kirimkan ke Dewan Redaksi.
          </p>
        </div>
        <button id="btn-close-riwayat" type="button" class="mono text-xs text-[var(--ink-faint)] hover:text-[var(--crimson)] cursor-pointer">
          ✕ Tutup
        </button>
      </div>

      <div id="riwayat-list" class="space-y-3">
        <p class="mono text-xs text-[var(--ink-faint)] text-center py-4">Memuat riwayat naskah...</p>
      </div>
    </div>

    <!-- MAIN FORM GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-start">
      
      <!-- Submission Form (2 Cols) -->
      <form id="submission-form" class="lg:col-span-2 p-6 md:p-8 bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-sm space-y-5">
        
        <!-- Judul -->
        <div>
          <label for="sub-title" class="block mono text-xs uppercase tracking-wider text-[var(--ink-soft)] mb-1.5 font-medium">
            Judul Karya *
          </label>
          <input 
            type="text" 
            id="sub-title" 
            required 
            placeholder="Misal: Lentera di Ujung Senja"
            class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Fraunces',serif] text-base"
          />
        </div>

        <!-- Penulis & Kelas -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="sub-author" class="block mono text-xs uppercase tracking-wider text-[var(--ink-soft)] mb-1.5 font-medium">
              Nama Penulis *
            </label>
            <input 
              type="text" 
              id="sub-author" 
              required 
              placeholder="Nama lengkap santri atau nama pena"
              class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif]"
            />
          </div>
          <div>
            <label for="sub-grade" class="block mono text-xs uppercase tracking-wider text-[var(--ink-soft)] mb-1.5 font-medium">
              Kelas / Peran *
            </label>
            <input 
              type="text" 
              id="sub-grade" 
              required 
              placeholder="Misal: Kelas XI-A / Guru Bahasa"
              class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif]"
            />
          </div>
        </div>

        <!-- Kategori & Kontak -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="sub-category" class="block mono text-xs uppercase tracking-wider text-[var(--ink-soft)] mb-1.5 font-medium">
              Kategori Karya *
            </label>
            <select 
              id="sub-category" 
              required 
              class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] mono text-xs"
            >
              <option value="puisi">Puisi &amp; Prosa</option>
              <option value="cerpen">Cerpen</option>
              <option value="ilmiah">Karya Tulis Ilmiah</option>
              <option value="drama">Naskah Drama</option>
              <option value="antologi">Antologi</option>
              <option value="quotes">Quotes / Kutipan Sastra</option>
            </select>
          </div>
          <div>
            <label for="sub-contact" class="block mono text-xs uppercase tracking-wider text-[var(--ink-soft)] mb-1.5 font-medium">
              Kontak (WhatsApp / Email)
            </label>
            <input 
              type="text" 
              id="sub-contact" 
              placeholder="Untuk konfirmasi kurasi redaksi"
              class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif]"
            />
          </div>
        </div>

        <!-- Sinopsis / Abstrak -->
        <div>
          <label for="sub-abstract" class="block mono text-xs uppercase tracking-wider text-[var(--ink-soft)] mb-1.5 font-medium">
            Abstrak / Sinopsis Singkat *
          </label>
          <textarea 
            id="sub-abstract" 
            rows="2" 
            required 
            placeholder="Ringkasan 1-3 kalimat mengenai isi atau pesan karya Anda..."
            class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif] italic"
          ></textarea>
        </div>

        <!-- Isi Naskah Lengkap -->
        <div>
          <label for="sub-body" class="block mono text-xs uppercase tracking-wider text-[var(--ink-soft)] mb-1.5 font-medium">
            Isi Naskah Karya Lengkap * (Mendukung Format Markdown)
          </label>
          <textarea 
            id="sub-body" 
            rows="10" 
            required 
            placeholder="Tuliskan bait puisi, dialog drama, atau narasi cerpen Anda di sini..."
            class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif] leading-relaxed"
          ></textarea>
        </div>

        <!-- Unggah Foto Sampul / Ilustrasi -->
        <div>
          <label for="sub-file" class="block mono text-xs uppercase tracking-wider text-[var(--ink-soft)] mb-1.5 font-medium">
            Lampiran Foto Sampul / Ilustrasi (Opsional)
          </label>
          <input 
            type="file" 
            id="sub-file" 
            accept="image/*"
            class="block w-full text-xs mono text-[var(--ink-soft)] file:mr-4 file:py-2 file:px-4 file:rounded file:border file:border-[var(--crimson)] file:text-xs file:mono file:bg-transparent file:text-[var(--crimson)] hover:file:bg-[var(--crimson)] hover:file:text-[var(--paper)] cursor-pointer"
          />
          <p class="mono text-[0.68rem] text-[var(--ink-faint)] mt-1">Format: JPG, PNG, atau WebP. Maksimal 5MB.</p>
        </div>

        <!-- Submit Button & Feedback -->
        <div class="pt-4 border-t border-[var(--rule)] flex items-center justify-between flex-wrap gap-4">
          <span id="sub-status-msg" class="mono text-xs text-[var(--ink-soft)]"></span>
          <button type="submit" id="sub-submit-btn" class="btn-literary btn-literary-solid !py-2.5 !px-6 cursor-pointer">
            Kirim Naskah ke Redaksi →
          </button>
        </div>
      </form>

      <!-- Sidebar Instructions & Guidelines (1 Col) -->
      <aside class="space-y-6">
        <div class="p-6 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-sm space-y-3">
          <h3 class="font-['Fraunces',serif] font-semibold text-lg text-[var(--ink)] m-0">
            Pedoman Pengiriman Naskah
          </h3>
          <ul class="text-xs font-['Source_Serif_4',serif] text-[var(--ink-soft)] space-y-2 list-disc list-inside m-0 p-0 leading-relaxed">
            <li><strong>Orisinalitas</strong>: Naskah merupakan karya asli siswa/guru SMPI YQ, belum pernah diplagiasi dari sumber lain.</li>
            <li><strong>Bahasa</strong>: Menggunakan Bahasa Indonesia yang baik dan santun. Istilah daerah atau bahasa Arab diperbolehkan dengan penulisan miring (italic).</li>
            <li><strong>Format Khusus</strong>: Untuk naskah drama, sebutkan nama tokoh dengan huruf kapital dan petunjuk lakuan dalam tanda kurung.</li>
            <li><strong>Kurasi</strong>: Naskah yang masuk akan ditinjau oleh Dewan Redaksi Sastra dalam 2–3 hari kerja sebelum terbit di Pojok Baca.</li>
          </ul>
        </div>

        <div class="p-6 bg-[var(--paper-deep)] border border-[var(--rule)] rounded-sm space-y-2">
          <span class="mono text-xs text-[var(--gold)] uppercase tracking-wider block font-semibold">Integrasi Database</span>
          <h4 class="font-['Fraunces',serif] font-semibold text-sm text-[var(--ink)] m-0">
            Penyimpanan Supabase &amp; Arsip Realtime
          </h4>
          <p class="font-['Source_Serif_4',serif] text-xs text-[var(--ink-soft)] leading-relaxed m-0">
            Naskah yang Anda kirimkan tersimpan secara aman di database Supabase PostgreSQL dan cadangan lokal. Setelah lolos kurasi redaksi, karya akan langsung dipublikasikan ke katalog pembaca.
          </p>
        </div>
      </aside>

    </div>

  </div>

  <script>
    import { 
      simpanKarya, 
      uploadFotoKarya, 
      getPenulisUser, 
      logoutPenulis, 
      getKaryaByPenulis,
      type PenulisUser 
    } from '../lib/supabase';
    import confetti from 'canvas-confetti';

    const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

    // Form Elements
    const form = document.getElementById('submission-form') as HTMLFormElement;
    const submitBtn = document.getElementById('sub-submit-btn') as HTMLButtonElement;
    const statusMsg = document.getElementById('sub-status-msg');

    const inputTitle = document.getElementById('sub-title') as HTMLInputElement;
    const inputAuthor = document.getElementById('sub-author') as HTMLInputElement;
    const inputGrade = document.getElementById('sub-grade') as HTMLInputElement;
    const inputCategory = document.getElementById('sub-category') as HTMLSelectElement;
    const inputContact = document.getElementById('sub-contact') as HTMLInputElement;
    const inputAbstract = document.getElementById('sub-abstract') as HTMLTextAreaElement;
    const inputBody = document.getElementById('sub-body') as HTMLTextAreaElement;
    const fileInput = document.getElementById('sub-file') as HTMLInputElement;

    // Author Status Elements
    const activeCard = document.getElementById('penulis-active-card');
    const guestPrompt = document.getElementById('penulis-guest-prompt');
    const activeName = document.getElementById('active-penulis-name');
    const activeGrade = document.getElementById('active-penulis-grade');
    const activeEmail = document.getElementById('active-penulis-email');
    const karyaBadge = document.getElementById('penulis-karya-badge');
    const btnToggleRiwayat = document.getElementById('btn-toggle-riwayat');
    const btnCloseRiwayat = document.getElementById('btn-close-riwayat');
    const btnLogoutPenulis = document.getElementById('btn-logout-penulis');
    const riwayatContainer = document.getElementById('penulis-riwayat-container');
    const riwayatList = document.getElementById('riwayat-list');

    let currentPenulis: PenulisUser | null = null;

    // 1. Check Author Session & Populate
    async function initAuthorSession() {
      currentPenulis = await getPenulisUser();
      if (currentPenulis) {
        // Show Active Card, Hide Guest Prompt
        activeCard?.classList.remove('hidden');
        guestPrompt?.classList.add('hidden');

        if (activeName) activeName.textContent = currentPenulis.nama;
        if (activeGrade) activeGrade.textContent = currentPenulis.kelas;
        if (activeEmail) activeEmail.textContent = currentPenulis.email;

        // Auto-fill form fields
        if (inputAuthor && !inputAuthor.value) inputAuthor.value = currentPenulis.nama;
        if (inputGrade && !inputGrade.value) inputGrade.value = currentPenulis.kelas;
        if (inputContact && !inputContact.value && currentPenulis.kontak) inputContact.value = currentPenulis.kontak;

        // Load Author's Submissions
        loadRiwayatNaskah(currentPenulis.nama, currentPenulis.email);
      } else {
        activeCard?.classList.add('hidden');
        guestPrompt?.classList.remove('hidden');
      }
    }

    // 2. Load Submitted Works Tracker
    async function loadRiwayatNaskah(nama: string, email?: string) {
      if (!riwayatList) return;
      const works = await getKaryaByPenulis(nama, email);
      if (karyaBadge) karyaBadge.textContent = works.length.toString();

      if (works.length === 0) {
        riwayatList.innerHTML = `
          <div class="text-center py-6 text-xs font-['Source_Serif_4',serif] italic text-[var(--ink-faint)]">
            Anda belum pernah mengirimkan naskah. Tulis dan kirim naskah pertama Anda di bawah ini!
          </div>
        `;
        return;
      }

      riwayatList.innerHTML = works.map(w => {
        let statusBadge = '<span class="px-2 py-0.5 rounded text-[0.65rem] mono font-semibold bg-amber-100 text-amber-900 border border-amber-300">⏳ Menunggu Kurasi Redaksi</span>';
        if (w.status === 'published') {
          statusBadge = '<span class="px-2 py-0.5 rounded text-[0.65rem] mono font-semibold bg-emerald-100 text-emerald-900 border border-emerald-300">🟢 Telah Terbit</span>';
        } else if (w.status === 'draft') {
          statusBadge = '<span class="px-2 py-0.5 rounded text-[0.65rem] mono font-semibold bg-gray-100 text-gray-800 border border-gray-300">📝 Draf</span>';
        }

        const dateStr = (w as any).created_at ? new Date((w as any).created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Baru saja';
        const linkHtml = w.status === 'published' 
          ? `<a href="${basePath}/karya/${w.slug}" class="mono text-xs text-[var(--crimson)] hover:underline ml-2">Buka Karya ↗</a>` 
          : '';

        return `
          <div class="p-3.5 bg-[var(--paper)] border border-[var(--rule)] rounded flex items-center justify-between flex-wrap gap-2 transition-colors hover:border-[var(--rule-strong)]">
            <div>
              <div class="flex items-center gap-2">
                <h4 class="font-['Fraunces',serif] font-semibold text-sm text-[var(--ink)] m-0">${w.title}</h4>
                <span class="mono text-[0.68rem] px-2 py-0.2 rounded-full border border-[var(--rule-strong)] text-[var(--ink-soft)] uppercase">${w.category_label || w.category}</span>
              </div>
              <p class="text-xs text-[var(--ink-faint)] mono mt-1 m-0">Terkirim: ${dateStr}</p>
            </div>
            <div class="flex items-center gap-2">
              ${statusBadge}
              ${linkHtml}
            </div>
          </div>
        `;
      }).join('');
    }

    // Toggle Riwayat
    btnToggleRiwayat?.addEventListener('click', () => {
      riwayatContainer?.classList.toggle('hidden');
    });
    btnCloseRiwayat?.addEventListener('click', () => {
      riwayatContainer?.classList.add('hidden');
    });

    // Logout Penulis
    btnLogoutPenulis?.addEventListener('click', async () => {
      await logoutPenulis();
      window.location.reload();
    });

    initAuthorSession();

    // 3. Form Submission Handler
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const title = inputTitle.value.trim();
        const author = inputAuthor.value.trim();
        const grade = inputGrade.value.trim();
        const category = inputCategory.value;
        const contact = inputContact.value.trim();
        const abstract = inputAbstract.value.trim();
        const body = inputBody.value.trim();

        if (!title || !author || !body) return;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Mengirim Naskah...';
        if (statusMsg) statusMsg.textContent = 'Memproses unggahan...';

        try {
          let fotoUrl = '';
          if (fileInput.files && fileInput.files[0]) {
            if (statusMsg) statusMsg.textContent = 'Mengunggah foto sampul ke Supabase Storage...';
            fotoUrl = await uploadFotoKarya(fileInput.files[0]);
          }

          if (statusMsg) statusMsg.textContent = 'Menyimpan naskah ke database...';

          const tags = [];
          if (contact) tags.push(`Kontak: ${contact}`);
          if (currentPenulis?.email) tags.push(`Email: ${currentPenulis.email}`);

          const res = await simpanKarya({
            title,
            author,
            author_grade: grade,
            category,
            description: abstract,
            content: body,
            cover_image_url: fotoUrl,
            tags,
            status: 'menunggu_kurasi',
          });

          if (res.success) {
            form.reset();
            // Re-populate author details if logged in
            if (currentPenulis) {
              if (inputAuthor) inputAuthor.value = currentPenulis.nama;
              if (inputGrade) inputGrade.value = currentPenulis.kelas;
              if (inputContact && currentPenulis.kontak) inputContact.value = currentPenulis.kontak;
              loadRiwayatNaskah(currentPenulis.nama, currentPenulis.email);
            }

            if (statusMsg) {
              statusMsg.textContent = 'Naskah berhasil terkirim ke Dewan Redaksi!';
              statusMsg.className = 'mono text-xs text-emerald-700 font-semibold';
            }

            // Confetti Celebration
            confetti({
              particleCount: 50,
              spread: 80,
              origin: { y: 0.6 },
              colors: ['#7c2d26', '#a6813c', '#6c7d5f']
            });

            alert(res.message);
          } else {
            if (statusMsg) statusMsg.textContent = res.message;
          }
        } catch (err: any) {
          console.error(err);
          if (statusMsg) statusMsg.textContent = 'Terjadi kesalahan saat mengirim: ' + (err.message || 'Error');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Kirim Naskah ke Redaksi →';
        }
      });
    }
  </script>
</Layout>
