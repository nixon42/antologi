          <p class="mono text-[0.68rem] text-[var(--crimson)] uppercase font-bold m-0">Tata Panggung &amp; Pementasan Drama</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="form-characters" class="block mono text-[0.65rem] uppercase text-[var(--ink-soft)] mb-1">Daftar Tokoh (Karakter)</label>
              <input type="text" id="form-characters" placeholder="Umar, Zaid, Narator, dll" class="w-full px-3 py-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-xs" />
