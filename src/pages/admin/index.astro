    // 15. Pengaturan Redaksi & Portal
    async function loadPengaturanData() {
      try {
        const settings = await getPengaturan();
        if (settings) {
          const namaEl = document.getElementById('setting-nama-portal') as HTMLInputElement;
          const edisiEl = document.getElementById('setting-edisi') as HTMLInputElement;
          const statusEl = document.getElementById('setting-status-penerimaan') as HTMLSelectElement;
          const waEl = document.getElementById('setting-whatsapp') as HTMLInputElement;
          const emailEl = document.getElementById('setting-email') as HTMLInputElement;
          const manifestoEl = document.getElementById('setting-manifesto') as HTMLTextAreaElement;

          if (namaEl && settings.nama_portal) namaEl.value = settings.nama_portal;
          if (edisiEl && settings.edisi) edisiEl.value = settings.edisi;
          if (statusEl && settings.status_penerimaan) statusEl.value = settings.status_penerimaan;
          if (waEl && settings.whatsapp) waEl.value = settings.whatsapp;
          if (emailEl && settings.email) emailEl.value = settings.email;
          if (manifestoEl && settings.manifesto) manifestoEl.value = settings.manifesto;
        }
      } catch (err) {
        console.warn('Gagal memuat pengaturan:', err);
      }
    }
    (window as any).loadPengaturanData = loadPengaturanData;

    document.getElementById('form-pengaturan')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const statusSpan = document.getElementById('setting-save-status');
      const btn = document.getElementById('btn-save-pengaturan') as HTMLButtonElement;
      if (btn) btn.disabled = true;
      if (statusSpan) {
        statusSpan.textContent = 'Menyimpan ke Google Sheets...';
        statusSpan.className = 'mono text-xs text-[var(--gold)]';
      }

      const payload = {
        nama_portal: (document.getElementById('setting-nama-portal') as HTMLInputElement)?.value || '',
        edisi: (document.getElementById('setting-edisi') as HTMLInputElement)?.value || '',
        status_penerimaan: (document.getElementById('setting-status-penerimaan') as HTMLSelectElement)?.value || 'buka',
        whatsapp: (document.getElementById('setting-whatsapp') as HTMLInputElement)?.value || '',
        email: (document.getElementById('setting-email') as HTMLInputElement)?.value || '',
        manifesto: (document.getElementById('setting-manifesto') as HTMLTextAreaElement)?.value || '',
      };

      try {
        await simpanPengaturan(payload);
        if (statusSpan) {
          statusSpan.textContent = '✓ Pengaturan berhasil disimpan!';
          statusSpan.className = 'mono text-xs text-emerald-700 font-bold';
          setTimeout(() => { if (statusSpan) statusSpan.textContent = ''; }, 3000);
        }
        confetti({ particleCount: 30, spread: 60, origin: { y: 0.8 } });
      } catch (err: any) {
        if (statusSpan) {
          statusSpan.textContent = 'Gagal menyimpan: ' + (err.message || 'Error');
          statusSpan.className = 'mono text-xs text-rose-700';
        }
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    // ==========================================================
    // 16. ANALISIS PENGUNJUNG (VISITOR COUNTER & ANALYTICS)
    // ==========================================================
    let currentVlogPeriod: 'today' | '7d' | '30d' | 'all' = '30d';
    let currentVlogCategory: string = 'all';
    let currentVlogData: VisitorAnalyticsData | null = null;
    let trendChartInstance: any = null;
    let doughnutChartInstance: any = null;

    const vlogPeriodLabels: Record<string, string> = {
      today: 'Hari Ini',
      '7d': '7 Hari',
      '30d': '30 Hari',
      all: 'Semua'
    };

    function setVlogLoading(isLoading: boolean) {
      const overlay = document.getElementById('vlog-loading-overlay');
      const tbSpinner = document.getElementById('vlog-toolbar-spinner');
      const periodBtns = document.getElementById('vlog-period-btns');
      const catFilter = document.getElementById('vlog-category-filter');
      const resetBtn = document.querySelector('button[onclick="resetVlogFilter()"]') as HTMLElement | null;
      const csvBtn = document.querySelector('button[onclick="exportVlogCsv()"]') as HTMLElement | null;

      if (isLoading) {
        overlay?.classList.remove('hidden');
        overlay?.classList.add('flex');
        tbSpinner?.classList.remove('hidden');
        tbSpinner?.classList.add('flex');
        periodBtns?.classList.add('opacity-60', 'pointer-events-none');
        catFilter?.classList.add('opacity-60', 'pointer-events-none');
        resetBtn?.classList.add('opacity-60', 'pointer-events-none');
        csvBtn?.classList.add('opacity-60', 'pointer-events-none');

        // Tampilkan mini-spinner pada tombol periode yang sedang aktif
        document.querySelectorAll('.vlog-p-btn').forEach(b => {
          const p = b.getAttribute('data-period');
          if (p === currentVlogPeriod) {
            b.innerHTML = `<svg class="w-3 h-3 animate-spin inline-block mr-1 text-[var(--paper)]" width="12" height="12" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>${vlogPeriodLabels[p] || p}`;
          }
        });
      } else {
        overlay?.classList.add('hidden');
        overlay?.classList.remove('flex');
        tbSpinner?.classList.add('hidden');
        tbSpinner?.classList.remove('flex');
        periodBtns?.classList.remove('opacity-60', 'pointer-events-none');
        catFilter?.classList.remove('opacity-60', 'pointer-events-none');
        resetBtn?.classList.remove('opacity-60', 'pointer-events-none');
        csvBtn?.classList.remove('opacity-60', 'pointer-events-none');

        // Kembalikan label bersih pada tombol
        document.querySelectorAll('.vlog-p-btn').forEach(b => {
          const p = b.getAttribute('data-period');
          if (p && vlogPeriodLabels[p]) {
            b.textContent = vlogPeriodLabels[p];
          }
        });
      }
    }

    async function loadVisitorAnalytics(period?: 'today' | '7d' | '30d' | 'all', category?: string, forceFresh: boolean = false) {
      if (period) currentVlogPeriod = period;
      if (category !== undefined) currentVlogCategory = category;

      // Update period buttons visual
      document.querySelectorAll('.vlog-p-btn').forEach(b => {
        const p = b.getAttribute('data-period');
        if (p === currentVlogPeriod) {
          b.className = 'vlog-p-btn px-3 py-1.5 rounded-lg text-xs font-bold transition cursor-pointer bg-[var(--crimson)] text-[var(--paper)] shadow-xs';
        } else {
          b.className = 'vlog-p-btn px-3 py-1.5 rounded-lg text-xs font-bold transition cursor-pointer text-[var(--ink-soft)] hover:text-[var(--ink)]';
        }
      });

      const catSelect = document.getElementById('vlog-category-filter') as HTMLSelectElement;
      if (catSelect && catSelect.value !== currentVlogCategory) {
        catSelect.value = currentVlogCategory;
      }

      setVlogLoading(true);

      try {
        const data = await getVisitorAnalytics(currentVlogPeriod, currentVlogCategory, forceFresh);
        if (!data) return;
        currentVlogData = data;

        // 1. KPI Cards
        const totalEl = document.getElementById('vlog-stat-total');
        const todayEl = document.getElementById('vlog-stat-today');
        const growthEl = document.getElementById('vlog-stat-growth');
        const uniqueEl = document.getElementById('vlog-stat-unique');
        const todayUniqueEl = document.getElementById('vlog-stat-today-unique');
        const karyaEl = document.getElementById('vlog-stat-karya');
        const karyaUniqueEl = document.getElementById('vlog-stat-karya-unique');
        const portalEl = document.getElementById('vlog-stat-portal');
        const portalUniqueEl = document.getElementById('vlog-stat-portal-unique');
        const mobilePctEl = document.getElementById('vlog-stat-mobile-pct');
        const mobileCountEl = document.getElementById('vlog-stat-mobile-count');

        if (totalEl) totalEl.textContent = data.summary.total_views.toLocaleString('id-ID');
        if (todayEl) todayEl.textContent = data.summary.today_views.toLocaleString('id-ID');
        if (growthEl) {
          growthEl.textContent = `${data.summary.growth_pct >= 0 ? '+' : ''}${data.summary.growth_pct}%`;
          growthEl.className = data.summary.growth_pct >= 0 ? 'font-bold text-emerald-700' : 'font-bold text-rose-700';
        }
        if (uniqueEl) uniqueEl.textContent = data.summary.unique_visitors.toLocaleString('id-ID');
        if (todayUniqueEl) todayUniqueEl.textContent = data.summary.today_unique.toLocaleString('id-ID');
        if (karyaEl) karyaEl.textContent = data.summary.categories.karya.total.toLocaleString('id-ID');
        if (karyaUniqueEl) karyaUniqueEl.textContent = data.summary.categories.karya.unique.toLocaleString('id-ID');
        if (portalEl) portalEl.textContent = data.summary.categories.portal.total.toLocaleString('id-ID');
        if (portalUniqueEl) portalUniqueEl.textContent = data.summary.categories.portal.unique.toLocaleString('id-ID');
        if (mobilePctEl) mobilePctEl.textContent = `${data.summary.devices.mobile_pct}%`;
        if (mobileCountEl) mobileCountEl.textContent = `${data.summary.devices.mobile} Akses HP`;

        // Devices
        const devMob = document.getElementById('vlog-dev-mobile');
        const devDesk = document.getElementById('vlog-dev-desktop');
        const devTab = document.getElementById('vlog-dev-tablet');
        if (devMob) devMob.textContent = `${data.summary.devices.mobile} (${data.summary.devices.mobile_pct}%)`;
        if (devDesk) devDesk.textContent = `${data.summary.devices.desktop} (${data.summary.devices.desktop_pct}%)`;
        if (devTab) devTab.textContent = `${data.summary.devices.tablet} (${data.summary.devices.tablet_pct}%)`;

        // 2. Render Charts
        renderVisitorCharts(data);

        // 3. Render Top Karya Leaderboard
        renderTopKaryaLeaderboard(data.top_karya);

        // 4. Render Referrers
        renderVisitorReferrers(data.top_referrers);

        // 5. Render Recent Logs
        renderVisitorLogsTable(data.recent_logs);

      } catch (e) {
        console.error('Error loading visitor analytics:', e);
      } finally {
        setVlogLoading(false);
      }
    }
    (window as any).loadVisitorAnalytics = loadVisitorAnalytics;

    function setVlogPeriod(p: 'today' | '7d' | '30d' | 'all') {
      loadVisitorAnalytics(p, currentVlogCategory);
    }
    (window as any).setVlogPeriod = setVlogPeriod;

    function setVlogCategory(c: string) {
      loadVisitorAnalytics(currentVlogPeriod, c);
    }
    (window as any).setVlogCategory = setVlogCategory;

    function resetVlogFilter() {
      loadVisitorAnalytics('30d', 'all', true);
    }
    (window as any).resetVlogFilter = resetVlogFilter;

    function renderVisitorCharts(data: VisitorAnalyticsData) {
      const ChartGlobal = (window as any).Chart;

      // 1. Trend Chart
      const trendCanvas = document.getElementById('visitorTrendChart') as HTMLCanvasElement;
      if (trendCanvas && ChartGlobal) {
        if (trendChartInstance) {
          trendChartInstance.destroy();
        }

        const labels = data.daily_trends.map(d => d.label);
        const karyaData = data.daily_trends.map(d => d.karya);
        const portalData = data.daily_trends.map(d => d.portal);
        const otherData = data.daily_trends.map(d => d.other);

        trendChartInstance = new ChartGlobal(trendCanvas, {
          type: 'bar',
          data: {
            labels,
            datasets: [
              {
                label: 'Karya Sastra',
                data: karyaData,
                backgroundColor: 'rgba(124, 45, 38, 0.85)',
                borderRadius: 4,
                stack: 'stack0',
              },
              {
                label: 'Portal & Beranda',
                data: portalData,
                backgroundColor: 'rgba(166, 129, 60, 0.85)',
                borderRadius: 4,
                stack: 'stack0',
              },
              {
                label: 'Lainnya',
                data: otherData,
                backgroundColor: 'rgba(46, 117, 89, 0.85)',
                borderRadius: 4,
                stack: 'stack0',
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'top',
                labels: {
                  font: { family: "'IBM Plex Mono', monospace", size: 11 },
                  boxWidth: 12,
                  usePointStyle: true,
                }
              },
              tooltip: {
                titleFont: { family: "'Fraunces', serif" },
                bodyFont: { family: "'IBM Plex Mono', monospace" }
              }
            },
            scales: {
              x: {
                stacked: true,
                grid: { display: false },
                ticks: {
                  font: { family: "'IBM Plex Mono', monospace", size: 10 },
                  maxRotation: 0,
                  autoSkip: true,
                  maxTicksLimit: 12
                }
              },
              y: {
                stacked: true,
                beginAtZero: true,
                ticks: {
                  font: { family: "'IBM Plex Mono', monospace", size: 10 },
                  precision: 0
                },
                grid: {
                  color: 'rgba(28, 36, 25, 0.08)'
                }
              }
            }
          }
        });
      }

      // 2. Category & Device Doughnut Chart
      const doughnutCanvas = document.getElementById('visitorCategoryDoughnut') as HTMLCanvasElement;
      if (doughnutCanvas && ChartGlobal) {
        if (doughnutChartInstance) {
          doughnutChartInstance.destroy();
        }

        doughnutChartInstance = new ChartGlobal(doughnutCanvas, {
          type: 'doughnut',
          data: {
            labels: ['Smartphone', 'Desktop', 'Tablet'],
            datasets: [{
              data: [
                data.summary.devices.mobile || 1,
                data.summary.devices.desktop || 0,
                data.summary.devices.tablet || 0
              ],
              backgroundColor: [
                '#7c2d26',
                '#a6813c',
                '#2e7559'
              ],
              borderWidth: 2,
              borderColor: '#efeae0'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '65%',
            plugins: {
              legend: {
                display: false
              },
              tooltip: {
                bodyFont: { family: "'IBM Plex Mono', monospace" }
              }
            }
          }
        });
      }
    }

    function renderTopKaryaLeaderboard(topKarya: TopKaryaItem[]) {
      const tbody = document.getElementById('vlog-top-karya-tbody');
      if (!tbody) return;

      if (!topKarya || topKarya.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="py-8 text-center text-xs mono text-[var(--ink-faint)] italic">
              Belum ada rekaman pembaca karya pada periode ini.
            </td>
          </tr>`;
        return;
      }

      tbody.innerHTML = topKarya.map((item, idx) => {
        let rankBadge = `<span class="mono text-xs font-bold text-[var(--ink-faint)]">${idx + 1}</span>`;
        if (idx === 0) rankBadge = `<span class="w-6 h-6 rounded-full bg-amber-100 text-amber-800 inline-flex items-center justify-center text-xs font-bold">🥇</span>`;
        else if (idx === 1) rankBadge = `<span class="w-6 h-6 rounded-full bg-slate-200 text-slate-800 inline-flex items-center justify-center text-xs font-bold">🥈</span>`;
        else if (idx === 2) rankBadge = `<span class="w-6 h-6 rounded-full bg-amber-100 text-amber-800 inline-flex items-center justify-center text-xs font-bold">🥉</span>`;

        return `
          <tr class="hover:bg-[var(--paper-deep)]/60 transition">
            <td class="py-3 px-3 text-center">${rankBadge}</td>
            <td class="py-3 px-3">
              <strong class="font-['Fraunces',serif] text-sm font-semibold text-[var(--ink)] block">
                ${item.title}
              </strong>
              <span class="mono text-[0.68rem] text-[var(--ink-faint)]">
                Oleh: ${item.author}
              </span>
            </td>
            <td class="py-3 px-3">
              <span class="mono text-[0.65rem] px-2 py-0.5 rounded-full border border-[var(--rule-strong)] text-[var(--crimson)] font-semibold uppercase">
                ${item.categoryLabel}
              </span>
            </td>
            <td class="py-3 px-3 text-right mono font-bold text-sm text-[var(--crimson)]">
              👁️ ${(item.views || 0).toLocaleString('id-ID')}
            </td>
            <td class="py-3 px-3 text-center">
              <a href="${basePath}/karya/${item.slug}" target="_blank" class="mono text-xs text-[var(--crimson)] hover:underline font-bold inline-flex items-center gap-1">
                <span>Buka</span>
                <span>→</span>
              </a>
            </td>
          </tr>`;
      }).join('');
    }

    function renderVisitorReferrers(referrers: TopReferrerItem[]) {
      const container = document.getElementById('vlog-referrers-container');
      if (!container) return;

      if (!referrers || referrers.length === 0) {
        container.innerHTML = `
          <div class="py-6 text-center text-xs mono text-[var(--ink-faint)] italic">
            Belum ada data kanal rujukan.
          </div>`;
        return;
      }

      container.innerHTML = referrers.map(r => `
        <div class="space-y-1">
          <div class="flex items-center justify-between mono text-xs">
            <span class="font-semibold text-[var(--ink)] truncate max-w-[180px]">${r.source}</span>
            <span class="text-[var(--ink-soft)] font-bold">${r.count.toLocaleString('id-ID')} <span class="text-[0.68rem] opacity-75">(${r.pct}%)</span></span>
          </div>
          <div class="w-full bg-[var(--paper-deep)] h-2 rounded-full overflow-hidden border border-[var(--rule)]">
            <div class="bg-[var(--gold)] h-full rounded-full transition-all duration-500" style="width: ${Math.min(100, Math.max(3, r.pct))}%"></div>
          </div>
        </div>
      `).join('');
    }

    function renderVisitorLogsTable(logs: RecentVisitorLog[]) {
      const tbody = document.getElementById('vlog-recent-logs-tbody');
      if (!tbody) return;

      if (!logs || logs.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="py-8 text-center text-xs mono text-[var(--ink-faint)] italic">
              Belum ada catatan aktivitas pengunjung.
            </td>
          </tr>`;
        return;
      }

      tbody.innerHTML = logs.map(l => {
        let catBadge = `<span class="px-2 py-0.5 rounded-full text-[0.68rem] font-bold bg-[var(--paper-deep)] text-[var(--ink)] uppercase">${l.category}</span>`;
        if (l.category === 'karya') {
          catBadge = `<span class="px-2 py-0.5 rounded-full text-[0.68rem] font-bold bg-[var(--crimson-subtle)] text-[var(--crimson)] border border-[var(--crimson)]/30 uppercase">Karya Sastra</span>`;
        } else if (l.category === 'portal') {
          catBadge = `<span class="px-2 py-0.5 rounded-full text-[0.68rem] font-bold bg-amber-50 text-amber-800 border border-amber-300 uppercase">Portal Beranda</span>`;
        } else if (l.category === 'quotes') {
          catBadge = `<span class="px-2 py-0.5 rounded-full text-[0.68rem] font-bold bg-purple-50 text-purple-800 border border-purple-300 uppercase">Quotes</span>`;
        } else if (l.category === 'panggung') {
          catBadge = `<span class="px-2 py-0.5 rounded-full text-[0.68rem] font-bold bg-blue-50 text-blue-800 border border-blue-300 uppercase">Panggung</span>`;
        }

        let devIcon = `<span class="inline-flex items-center gap-1 text-[var(--ink-soft)]">💻 Desktop</span>`;
        if (l.device_type === 'mobile') {
          devIcon = `<span class="inline-flex items-center gap-1 text-blue-700 font-bold">📱 Smartphone</span>`;
        } else if (l.device_type === 'tablet') {
          devIcon = `<span class="inline-flex items-center gap-1 text-emerald-700">📟 Tablet</span>`;
        }

        return `
          <tr class="vlog-row hover:bg-[var(--paper-deep)]/60 transition" data-path="${(l.path || '').toLowerCase()}" data-title="${(l.title || '').toLowerCase()}" data-ip="${(l.ip_masked || '').toLowerCase()}">
            <td class="py-2.5 px-3 text-[var(--ink-soft)] whitespace-nowrap">${l.timestamp || '-'}</td>
            <td class="py-2.5 px-3 whitespace-nowrap">${catBadge}</td>
            <td class="py-2.5 px-3">
              <strong class="text-[var(--ink)] font-semibold block truncate max-w-xs">${l.title || l.path}</strong>
              <span class="text-[0.65rem] text-[var(--ink-faint)] block truncate max-w-xs">${l.path}</span>
            </td>
            <td class="py-2.5 px-3 whitespace-nowrap">${devIcon}</td>
            <td class="py-2.5 px-3 text-[var(--ink-soft)] truncate max-w-[120px]">${l.referrer || 'direct'}</td>
            <td class="py-2.5 px-3 text-[var(--ink-faint)] font-mono text-[0.68rem]">${l.ip_masked || 'anonymized'}</td>
          </tr>`;
      }).join('');
    }

    function filterVlogTable(query: string) {
      const q = query.trim().toLowerCase();
      const rows = document.querySelectorAll('.vlog-row') as NodeListOf<HTMLTableRowElement>;
      rows.forEach(r => {
        const path = r.getAttribute('data-path') || '';
        const title = r.getAttribute('data-title') || '';
        const ip = r.getAttribute('data-ip') || '';
        if (!q || path.includes(q) || title.includes(q) || ip.includes(q)) {
          r.style.display = '';
        } else {
          r.style.display = 'none';
        }
      });
    }
    (window as any).filterVlogTable = filterVlogTable;

    function exportVlogCsv() {
      if (!currentVlogData || !currentVlogData.recent_logs || currentVlogData.recent_logs.length === 0) {
        alert('Belum ada data log pengunjung untuk diunduh.');
        return;
      }
      const headers = ['ID', 'Waktu WIB', 'Tanggal', 'Kategori', 'Path Halaman', 'Judul Karya/Halaman', 'Perangkat', 'Sumber Referrer', 'IP Masked'];
      const rows = currentVlogData.recent_logs.map(l => [
        `"${l.id}"`,
        `"${l.timestamp}"`,
        `"${l.visit_date}"`,
        `"${l.category}"`,
        `"${(l.path || '').replace(/"/g, '""')}"`,
        `"${(l.title || '').replace(/"/g, '""')}"`,
        `"${l.device_type}"`,
        `"${(l.referrer || '').replace(/"/g, '""')}"`,
        `"${l.ip_masked}"`
      ]);

      const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `log_pengunjung_ruang_sastra_${new Date().toISOString().substring(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
    (window as any).exportVlogCsv = exportVlogCsv;
  </script>
</Layout>
