            required 
            placeholder="Minimal 6 karakter" 
            class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-xl text-xs mono text-[var(--ink)] outline-none focus:border-[var(--crimson)]" 
          />
        </div>

        <div>
          <label for="my-confirm-pass" class="block mono text-[0.7rem] uppercase text-[var(--ink-soft)] font-bold mb-1">
            Ulangi Kata Sandi Baru *
          </label>
          <input 
            type="password" 
            id="my-confirm-pass" 
            required 
            placeholder="Ketik ulang sandi baru" 
            class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-xl text-xs mono text-[var(--ink)] outline-none focus:border-[var(--crimson)]" 
          />
