        formKaryaSlug.value = '';
        formTitle.value = '';
        formCategory.value = 'puisi';
        formAuthor.value = currentAdminUser?.email === 'redaksi@yq.sch.id' ? 'Dewan Redaksi SMPI YQ' : (currentAdminUser?.email || '');
        formGrade.value = 'Dewan Redaksi';
        formStatus.value = 'published';
        formDesc.value = '';
        formCoverUrl.value = '';
        formContent.value = '';

        if (previewSlugText) previewSlugText.textContent = 'draf-baru';
        if (btnPreviewKarya) {
          btnPreviewKarya.classList.add('hidden');
          btnPreviewKarya.classList.remove('inline-flex');
        }
        if (editorSaveIndicator) {
          editorSaveIndicator.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span><span>Naskah Baru (Draf Belum Disimpan)</span>';
        }
        if (btnDeleteCurrent) {
          btnDeleteCurrent.classList.add('hidden');
        }
        if (btnSaveKarya) {
          btnSaveKarya.innerHTML = '<span>Terbitkan Naskah ⚡</span>';
        }
        if (btnSaveKaryaSecondary) {
          btnSaveKaryaSecondary.innerHTML = '<span>Terbitkan Naskah ⚡</span>';
        }

        if (formSupervisor) formSupervisor.value = '';
        if (formPdfUrl) formPdfUrl.value = '';
        if (formAbstract) formAbstract.value = '';
        if (formAudioUrl) formAudioUrl.value = '';
        if (formReadingTime) formReadingTime.value = '';
        if (formCharacters) formCharacters.value = '';
        if (formStage) formStage.value = '';

        onCategoryChange('puisi');
        updateCoverPreview('');
      }

      updateWordCount();
      switchAdminSection('editor');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    (window as any).openEditorModal = openEditorModal;

    function closeEditorModal() {
      switchAdminSection('karya');
    }
    (window as any).closeEditorModal = closeEditorModal;

    function editKaryaBySlug(slug: string) {
      const found = fullDb.karya.find(k => k.slug === slug);
      if (found) {
        openEditorModal(found);
      }
    }
    (window as any).editKaryaBySlug = editKaryaBySlug;

    // Word and character count update
    function updateWordCount() {
      if (!formContent) return;
      const text = formContent.value;
      const words = text.trim().split(/\s+/).filter(Boolean).length;
      const chars = text.length;
      if (formWordCount) formWordCount.textContent = `${words} kata`;
      if (formCharCount) formCharCount.textContent = `${chars} karakter`;
    }
    formContent?.addEventListener('input', updateWordCount);

    // Cover image preview update
    function updateCoverPreview(url?: string) {
      if (!coverPreviewBox) return;
      if (url) {
        const directUrl = formatDriveImageUrl(url);
        coverPreviewBox.innerHTML = `
          <img src="${directUrl}" class="w-full h-full object-cover" alt="Sampul" />
          <button type="button" onclick="removeCoverImage()" class="absolute top-2 right-2 p-1.5 rounded-full bg-black/60 text-white hover:bg-black/80 transition-colors text-xs cursor-pointer shadow-sm" title="Hapus foto sampul">
            <svg class="w-3.5 h-3.5" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        `;
      } else {
        coverPreviewBox.innerHTML = '<span class="mono text-xs text-[var(--ink-faint)]">Belum ada foto sampul</span>';
      }
    }

    function removeCoverImage() {
      formCoverUrl.value = '';
      if (formCoverFile) formCoverFile.value = '';
      updateCoverPreview('');
      if (coverUploadStatus) coverUploadStatus.textContent = '';
    }
    (window as any).removeCoverImage = removeCoverImage;

    formCoverUrl?.addEventListener('input', () => updateCoverPreview(formCoverUrl.value));

    // Upload Cover Photo to Google Drive Storage
    formCoverFile?.addEventListener('change', async () => {
      if (!formCoverFile.files || !formCoverFile.files[0]) return;
      const file = formCoverFile.files[0];
      if (coverUploadStatus) {
        coverUploadStatus.textContent = 'Mengunggah ke Google Drive Storage...';
        coverUploadStatus.className = 'mono text-[0.68rem] text-[var(--gold)] block';
      }

      try {
        const publicUrl = await uploadFotoKarya(file);
        formCoverUrl.value = publicUrl;
        updateCoverPreview(publicUrl);
        if (coverUploadStatus) {
          coverUploadStatus.textContent = '✓ Foto berhasil diunggah ke Google Drive!';
          coverUploadStatus.className = 'mono text-[0.68rem] text-emerald-700 font-bold block';
        }
      } catch (err: any) {
        if (coverUploadStatus) {
          coverUploadStatus.textContent = 'Gagal upload: ' + (err.message || 'Error');
          coverUploadStatus.className = 'mono text-[0.68rem] text-rose-700 block';
        }
      }
    });

    // Save Karya Submit
    document.getElementById('admin-karya-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!formTitle.value || !formAuthor.value || !formContent.value) {
        alert('Harap lengkapi Judul, Penulis, dan Isi Naskah.');
        return;
      }

      const originalSubmitText = btnSaveKarya ? btnSaveKarya.innerHTML : 'Simpan';
      if (btnSaveKarya) {
        btnSaveKarya.disabled = true;
        btnSaveKarya.innerHTML = '<span>Menyimpan ke Cloud DB...</span>';
      }
      if (btnSaveKaryaSecondary) {
        btnSaveKaryaSecondary.disabled = true;
        btnSaveKaryaSecondary.innerHTML = '<span>Menyimpan ke Cloud DB...</span>';
      }

      const payload: KaryaInput = {
        id: formKaryaId.value || undefined,
        slug: formKaryaSlug.value || undefined,
        title: formTitle.value.trim(),
        category: formCategory.value,
        category_label: formCategory.options[formCategory.selectedIndex]?.text || 'Sastra',
        author: formAuthor.value.trim(),
        author_grade: formGrade.value.trim(),
        status: formStatus.value as any,
        description: formDesc.value.trim(),
        cover_image_url: formCoverUrl.value.trim() || undefined,
        content: formContent.value.trim(),
        supervisor: formSupervisor?.value.trim() || undefined,
        pdf_url: formPdfUrl?.value.trim() || undefined,
        abstract: formAbstract?.value.trim() || undefined,
        audio_url: formAudioUrl?.value.trim() || undefined,
        reading_time: formReadingTime?.value ? parseInt(formReadingTime.value, 10) : undefined,
        characters: formCharacters?.value.trim() ? formCharacters.value.split(',').map(s => s.trim()).filter(Boolean) : undefined,
        stage_setting: formStage?.value.trim() || undefined,
      };

      try {
        const res = await simpanKarya(payload);
        if (res.success) {
          confetti({ particleCount: 30, spread: 60, origin: { y: 0.6 } });
          await loadAllAdminData();
          if (formStatus.value === 'published') {
            switchAdminSection('karya');
          } else if (formStatus.value === 'menunggu_kurasi') {
            switchAdminSection('kurasi');
          } else {
            switchAdminSection('karya');
          }
        }
      } catch (err: any) {
        alert('Gagal menyimpan: ' + (err.message || 'Terjadi kesalahan sistem'));
      } finally {
        if (btnSaveKarya) {
          btnSaveKarya.disabled = false;
          btnSaveKarya.innerHTML = originalSubmitText;
        }
        if (btnSaveKaryaSecondary) {
          btnSaveKaryaSecondary.disabled = false;
          btnSaveKaryaSecondary.innerHTML = originalSubmitText;
        }
      }
    });

    // Download as Markdown
    document.getElementById('btn-download-md')?.addEventListener('click', () => {
      const slug = formKaryaSlug.value || slugify(formTitle.value) || 'naskah';
      const md = `---
title: "${formTitle.value.replace(/"/g, '\\"')}"
description: "${formDesc.value.replace(/"/g, '\\"')}"
author: "${formAuthor.value.replace(/"/g, '\\"')}"
authorGrade: "${formGrade.value.replace(/"/g, '\\"')}"
category: "${formCategory.value}"
categoryLabel: "${formCategory.options[formCategory.selectedIndex]?.text || 'Sastra'}"
publishDate: ${new Date().toISOString().split('T')[0]}
${formCoverUrl.value ? `coverImage: "${formCoverUrl.value}"\n` : ''}---

${formContent.value}
`;
      const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${slug}.md`;
      a.click();
    });

    // 14. Quotes Modal
    const modalQuote = document.getElementById('modal-quote-form');
    function openQuoteModal() {
      modalQuote?.classList.remove('hidden');
      modalQuote?.classList.add('flex');
    }
    (window as any).openQuoteModal = openQuoteModal;

    function closeQuoteModal() {
      modalQuote?.classList.add('hidden');
      modalQuote?.classList.remove('flex');
    }
    (window as any).closeQuoteModal = closeQuoteModal;

    document.getElementById('quote-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const quoteText = (document.getElementById('quote-text') as HTMLTextAreaElement).value.trim();
      const quoteAuthor = (document.getElementById('quote-author') as HTMLInputElement).value.trim();
      const quoteTitle = (document.getElementById('quote-title') as HTMLInputElement).value.trim();
      const quoteCat = (document.getElementById('quote-cat') as HTMLSelectElement).value;

      if (!quoteText || !quoteAuthor) return;

      await simpanQuote({
        quote: quoteText,
        author: quoteAuthor,
        author_title: quoteTitle,
        category: quoteCat
      });

