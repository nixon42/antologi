        <button type="submit" id="btn-save-quote" class="w-full py-2.5 rounded-xl bg-[var(--crimson)] hover:bg-[#63241e] text-[var(--paper)] font-bold text-xs mono shadow transition-all cursor-pointer">
          Simpan Kutipan
        </button>
