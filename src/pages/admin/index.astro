            class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-xl text-xs mono text-[var(--ink)] outline-none focus:border-[var(--crimson)] cursor-pointer"
          >
            <option value="Redaktur Utama">Redaktur Utama (Akses Penuh)</option>
            <option value="Dewan Guru &amp; Pembina">Dewan Guru &amp; Pembina Literasi</option>
            <option value="Tim Kurasi Redaksi">Tim Kurasi Redaksi Santri</option>
            <option value="Redaktur Pelaksana">Redaktur Pelaksana</option>
          </select>
        </div>

        <div id="admin-password-container">
          <label for="admin-form-password" class="block mono text-[0.7rem] uppercase text-[var(--ink-soft)] font-bold mb-1">
            <span id="admin-pass-label">Kata Sandi Baru *</span>
