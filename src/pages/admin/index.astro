    </div>
  </div>

  <!-- SCRIPT LOGIC FOR ADMIN DASHBOARD -->
  <script>
    import { 
      getAdminUser, 
      logoutAdmin, 
      getFullData, 
      simpanKarya, 
      hapusKarya, 
      updateStatusKarya, 
      uploadFotoKarya, 
      simpanQuote, 
      hapusQuote, 
      hapusKomentar,
      getPengaturan,
      simpanPengaturan,
      formatDriveImageUrl,
      getVisitorAnalytics,
      simpanAdminUser,
      hapusAdminUser,
      simpanPenulisUser,
      hapusPenulisUser,
      type KaryaInput,
      type FullDatabaseDump,
      type VisitorAnalyticsData,
      type TopKaryaItem,
      type TopReferrerItem,
      type RecentVisitorLog
    } from '../../lib/supabase';
    import confetti from 'canvas-confetti';

    const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

    // State Variables
    let currentAdminUser: any = null;
    let fullDb: FullDatabaseDump = {
      karya: [],
      quotes: [],
      komentar: [],
      apresiasi: [],
      penulis: [],
      admin: []
    };
    let currentUserSubTab: 'santri' | 'admin' = 'santri';
    let currentSantriSearch: string = '';
    let currentSantriKelasFilter: string = 'all';

    // DOM Elements
    const authBarrier = document.getElementById('auth-guard-barrier');
    const adminPanel = document.getElementById('admin-panel');
    const adminEmailDisplay = document.getElementById('admin-user-display-email');
    const adminRoleDisplay = document.getElementById('admin-user-display-role');
    const btnLogout = document.getElementById('btn-admin-logout');

    // KPI Elements
    const kpiSubmissions = document.getElementById('kpi-submissions');
    const kpiPublished = document.getElementById('kpi-published');
    const kpiDrafts = document.getElementById('kpi-drafts');
    const kpiComments = document.getElementById('kpi-comments');

    // Sidebar Badges
    const badgeKurasi = document.getElementById('sidebar-badge-kurasi');
    const badgeKarya = document.getElementById('sidebar-badge-karya');
    const badgeKomentar = document.getElementById('sidebar-badge-komentar');
    const badgeQuotes = document.getElementById('sidebar-badge-quotes');
    const badgePenulis = document.getElementById('sidebar-badge-penulis');
    const overviewBadgeQueue = document.getElementById('overview-badge-queue');

    // 1. Initial Authentication Guard
    async function initAdmin() {
      // Bersihkan residu cache lama yang menyimpan views dummy (344, 519, dst)
      if (typeof window !== 'undefined') {
        const cachedKaryaStr = localStorage.getItem('rs_cloud_karya_cache');
        if (cachedKaryaStr && (cachedKaryaStr.includes('"views":344') || cachedKaryaStr.includes('"views":519') || cachedKaryaStr.includes('"views":342') || cachedKaryaStr.includes('"views":518'))) {
          localStorage.removeItem('rs_cloud_karya_cache');
        }
      }

      currentAdminUser = await getAdminUser();
      if (!currentAdminUser) {
        authBarrier?.classList.remove('hidden');
        adminPanel?.classList.add('hidden');
        return;
      }

      authBarrier?.classList.add('hidden');
      adminPanel?.classList.remove('hidden');

      if (adminEmailDisplay) adminEmailDisplay.textContent = currentAdminUser.email;
      if (adminRoleDisplay) adminRoleDisplay.textContent = currentAdminUser.role || 'Redaktur Pelaksana';

      // Load all database items
      await loadAllAdminData();
    }
    initAdmin();

    // Logout Handler
    btnLogout?.addEventListener('click', async () => {
      if (confirm('Keluar dari sesi Studio Redaksi?')) {
        await logoutAdmin();
        window.location.href = `${basePath}/admin/login?logout=1`;
      }
    });

    // 2. Fetch Data from Google Sheets & Drive Cloud Backend
    async function loadAllAdminData() {
      const syncIcon = document.getElementById('sync-icon');
      const syncText = document.getElementById('sync-text');
      if (syncIcon) syncIcon.classList.add('animate-spin');
      if (syncText) syncText.textContent = 'Memuat Cloud...';

      try {
        fullDb = await getFullData();
        updateKpiMetrics();
        renderOverviewQueue();
        renderOverviewPublished();
        renderKurasiList();
        renderKaryaCatalog();
        renderKomentarList();
        renderQuotesGrid();
        renderPenulisList();
        renderAdminList();
        updateUserStatsCounter();
        (window as any).currentUserSubTab = currentUserSubTab;
        await loadPengaturanData();
      } catch (err) {
        console.warn('Gagal memuat database cloud:', err);
      } finally {
        if (syncIcon) syncIcon.classList.remove('animate-spin');
        if (syncText) syncText.textContent = 'Segarkan Data';
      }
    }
    (window as any).loadAllAdminData = loadAllAdminData;

    // 3. Update KPI Metrics
    function updateKpiMetrics() {
      const submissions = fullDb.karya.filter(k => k.status === 'menunggu_kurasi').length;
      const published = fullDb.karya.filter(k => k.status === 'published').length;
      const drafts = fullDb.karya.filter(k => k.status === 'draft').length;
      const comments = fullDb.komentar.length;
      const quotes = fullDb.quotes.length;
      const santriCount = fullDb.penulis?.length || 0;
      const adminCount = fullDb.admin?.length || 0;
      const totalViews = fullDb.karya.reduce((acc, k) => acc + (parseInt((k as any).views || 0, 10)), 0);

      if (kpiSubmissions) kpiSubmissions.textContent = submissions.toString();
      if (kpiPublished) kpiPublished.textContent = published.toString();
      if (kpiDrafts) kpiDrafts.textContent = drafts.toString();
      if (kpiComments) kpiComments.textContent = comments.toString();
      const kpiViewsTotal = document.getElementById('kpi-views-total');
      if (kpiViewsTotal) kpiViewsTotal.textContent = totalViews.toLocaleString('id-ID');

      if (badgeKurasi) badgeKurasi.textContent = submissions.toString();
      if (badgeKarya) badgeKarya.textContent = fullDb.karya.length.toString();
      if (badgeKomentar) badgeKomentar.textContent = comments.toString();
      if (badgeQuotes) badgeQuotes.textContent = quotes.toString();
      if (badgePenulis) badgePenulis.textContent = (santriCount + adminCount).toString();
      if (overviewBadgeQueue) overviewBadgeQueue.textContent = submissions.toString();
    }

    // 4. Section Switcher (like smpalmubarokweb)
    function switchAdminSection(sectionKey: string) {
      const sections = ['ringkasan', 'pengunjung', 'kurasi', 'karya', 'komentar', 'quotes', 'penulis', 'pengaturan', 'editor'];
      const titles: Record<string, string> = {
        ringkasan: 'Ringkasan & Statistik',
        pengunjung: 'Analisis Pengunjung & Pembaca',
        kurasi: 'Antrean Kurasi Naskah Masuk',
        karya: 'Katalog Karya Sastra Lengkap',
        komentar: 'Moderasi Catatan & Komentar',
        quotes: 'Quotes & Mutiara Sastra',
        penulis: 'Manajemen Pengguna (Santri & Redaksi)',
        pengaturan: 'Pengaturan Redaksi & Portal',
        editor: 'Studio Editor Naskah Sastra',
      };

      sections.forEach(k => {
        const secEl = document.getElementById(`section-${k}`);
        const navBtn = document.getElementById(`nav-btn-${k}`);
        if (k === sectionKey) {
          secEl?.classList.remove('hidden');
          navBtn?.classList.add('bg-[var(--paper-deep)]', 'text-[var(--crimson)]', 'font-bold', 'border', 'border-[var(--rule-strong)]', 'shadow-xs');
          navBtn?.classList.remove('text-[var(--ink-soft)]');
        } else {
          secEl?.classList.add('hidden');
          navBtn?.classList.remove('bg-[var(--paper-deep)]', 'text-[var(--crimson)]', 'font-bold', 'border', 'border-[var(--rule-strong)]', 'shadow-xs');
          navBtn?.classList.add('text-[var(--ink-soft)]');
        }
      });

      const topTitle = document.getElementById('topbar-section-title');
      if (topTitle) topTitle.textContent = titles[sectionKey] || 'Studio Redaksi';

      const btnTopWrite = document.getElementById('btn-top-write-naskah');
      if (btnTopWrite) {
        if (sectionKey === 'editor') {
          btnTopWrite.classList.add('hidden');
        } else {
          btnTopWrite.classList.remove('hidden');
        }
      }

      const mobileSelect = document.getElementById('admin-mobile-nav') as HTMLSelectElement;
      if (mobileSelect) mobileSelect.value = sectionKey;

      if (sectionKey === 'pengunjung') {
        loadVisitorAnalytics();
      }
    }
    (window as any).switchAdminSection = switchAdminSection;

    // 5. Render Overview Submissions Queue
    function renderOverviewQueue() {
      const container = document.getElementById('overview-queue-container');
      if (!container) return;
      const submissions = fullDb.karya.filter(k => k.status === 'menunggu_kurasi');

      if (submissions.length === 0) {
        container.innerHTML = `
          <div class="p-6 text-center text-xs mono text-[var(--ink-faint)] italic">
            Alhamdulillah! Tidak ada naskah santri yang tertunda kurasi saat ini.
          </div>
        `;
        return;
      }

      container.innerHTML = submissions.slice(0, 5).map(k => `
        <div class="p-4 flex items-center justify-between gap-3 flex-wrap hover:bg-[var(--paper-deep)]/50 transition-colors">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="mono text-[0.68rem] px-2 py-0.5 rounded-full border border-[var(--crimson)] text-[var(--crimson)] uppercase font-semibold">
                ${k.category_label || k.category}
              </span>
              <span class="mono text-[0.68rem] text-[var(--ink-faint)]">
                ${k.created_at ? new Date(k.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) : 'Baru'}
              </span>
            </div>
            <h4 class="font-['Fraunces',serif] font-bold text-sm text-[var(--ink)] m-0 truncate">
              ${k.title}
            </h4>
            <p class="mono text-[0.7rem] text-[var(--ink-soft)] m-0 mt-0.5">
              Oleh <span class="font-semibold text-[var(--ink)]">${k.author}</span> ${k.author_grade ? `(${k.author_grade})` : ''}
            </p>
          </div>

          <div class="flex items-center gap-2">
            <button 
              type="button" 
              onclick="quickPublish('${k.slug || k.id}')" 
              class="px-2.5 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white mono text-xs font-bold shadow-xs cursor-pointer flex items-center gap-1"
              title="Setujui dan langsung terbitkan ke publik"
            >
              <span>✓ Terbitkan</span>
            </button>
            <button 
              type="button" 
              onclick="editKaryaBySlug('${k.slug}')" 
              class="px-2.5 py-1.5 rounded-lg border border-[var(--rule-strong)] bg-[var(--paper)] hover:bg-[var(--paper-deep)] text-[var(--ink)] mono text-xs font-medium cursor-pointer"
            >
              <span>Sunting ✎</span>
            </button>
          </div>
        </div>
      `).join('');
    }

    // Helper: Build Pagination Range with Ellipsis
    function getPaginationRange(current: number, total: number): (number | string)[] {
      if (total <= 7) {
        return Array.from({ length: total }, (_, i) => i + 1);
      }
      if (current <= 3) {
        return [1, 2, 3, 4, '...', total];
      }
      if (current >= total - 2) {
        return [1, '...', total - 3, total - 2, total - 1, total];
      }
      return [1, '...', current - 1, current, current + 1, '...', total];
    }

    // Pagination state for Overview Published Works
    let overviewPubPage = 1;
    let overviewPubPerPage = 5;

    (window as any).changeOverviewPubPerPage = function(val: string) {
      overviewPubPerPage = val === 'all' ? 999999 : (parseInt(val, 10) || 5);
      overviewPubPage = 1;
      renderOverviewPublished();
    };

    (window as any).goToOverviewPubPage = function(page: number) {
      overviewPubPage = page;
      renderOverviewPublished();
    };

    // 6. Render Overview Recently Published (with Interactive Pagination)
    function renderOverviewPublished() {
      const container = document.getElementById('overview-published-container');
      const badgeTotal = document.getElementById('overview-published-total-badge');
      const paginationBar = document.getElementById('overview-published-pagination');
      const pageInfo = document.getElementById('overview-pub-page-info');
      const pageNav = document.getElementById('overview-pub-nav');
      if (!container) return;

      const published = fullDb.karya.filter(k => k.status === 'published');
      const totalItems = published.length;
      if (badgeTotal) badgeTotal.textContent = totalItems.toString();

      if (totalItems === 0) {
        container.innerHTML = '<div class="p-6 text-center text-xs mono text-[var(--ink-faint)] italic">Belum ada karya yang terpublikasi.</div>';
        if (paginationBar) paginationBar.classList.add('hidden');
        return;
      }

      if (paginationBar) paginationBar.classList.remove('hidden');

      const isAll = (overviewPubPerPage >= 999999);
      const perPage = isAll ? totalItems : overviewPubPerPage;
      const totalPages = Math.max(1, Math.ceil(totalItems / perPage));

      if (overviewPubPage < 1) overviewPubPage = 1;
      if (overviewPubPage > totalPages) overviewPubPage = totalPages;

      const startIndex = (overviewPubPage - 1) * perPage;
      const endIndex = Math.min(startIndex + perPage, totalItems);
      const pageItems = published.slice(startIndex, endIndex);

      container.innerHTML = pageItems.map(k => `
        <div class="p-4 flex items-center justify-between gap-3 hover:bg-[var(--paper-deep)]/50 transition-colors">
          <div class="min-w-0">
            <span class="mono text-[0.68rem] text-[var(--gold)] uppercase font-semibold">
              ${k.category_label || k.category}
            </span>
            <h4 class="font-['Fraunces',serif] font-bold text-sm text-[var(--ink)] m-0 truncate">
              ${k.title}
            </h4>
            <p class="mono text-[0.7rem] text-[var(--ink-faint)] m-0">
              Oleh ${k.author}
            </p>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <a 
              href="${basePath}/karya/${k.slug}" 
              target="_blank" 
              class="px-2.5 py-1 rounded-md border border-[var(--rule)] text-[var(--ink-soft)] hover:text-[var(--crimson)] text-xs mono no-underline flex items-center gap-1"
            >
              <span>Buka</span>
              <svg class="w-3 h-3" width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
            <button 
              type="button" 
              onclick="editKaryaBySlug('${k.slug}')" 
              class="px-2.5 py-1 rounded-md border border-[var(--rule-strong)] bg-[var(--paper)] text-xs mono text-[var(--ink)] hover:bg-[var(--paper-deep)] cursor-pointer"
            >
              Sunting
            </button>
          </div>
        </div>
      `).join('');

      // Update Page Info
      if (pageInfo) {
        if (isAll) {
          pageInfo.textContent = `Menampilkan semua ${totalItems} karya`;
        } else {
          pageInfo.textContent = `Menampilkan ${startIndex + 1}–${endIndex} dari ${totalItems} karya`;
        }
      }

      // Render Pagination Buttons
      if (pageNav) {
        if (totalPages <= 1) {
          pageNav.innerHTML = '';
          return;
        }

        let navHtml = '';
        const prevDisabled = overviewPubPage <= 1;
        navHtml += `
          <button type="button" onclick="goToOverviewPubPage(${overviewPubPage - 1})"
                  ${prevDisabled ? 'disabled' : ''}
                  class="px-2 py-1 text-xs rounded border border-[var(--rule-strong)] bg-[var(--paper)] text-[var(--ink)] hover:text-[var(--crimson)] hover:border-[var(--crimson)] disabled:opacity-30 disabled:pointer-events-none transition flex items-center gap-1 cursor-pointer font-medium"
                  title="Halaman Sebelumnya">
            <svg class="w-3 h-3" width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            <span class="hidden sm:inline">Sebelumnya</span>
          </button>
        `;

        const pages = getPaginationRange(overviewPubPage, totalPages);
        pages.forEach(p => {
          if (p === '...') {
            navHtml += `<span class="px-1.5 py-0.5 text-xs text-[var(--ink-faint)] select-none">…</span>`;
          } else {
            const isActive = (p === overviewPubPage);
            if (isActive) {
              navHtml += `
                <button type="button" class="w-7 h-7 flex items-center justify-center text-xs font-bold rounded bg-[var(--crimson)] text-[var(--paper)] shadow-2xs select-none">
                  ${p}
                </button>
              `;
            } else {
              navHtml += `
                <button type="button" onclick="goToOverviewPubPage(${p})"
                        class="w-7 h-7 flex items-center justify-center text-xs font-medium rounded border border-[var(--rule-strong)] bg-[var(--paper)] text-[var(--ink)] hover:text-[var(--crimson)] hover:border-[var(--crimson)] transition cursor-pointer select-none">
                  ${p}
                </button>
              `;
            }
          }
        });

        const nextDisabled = overviewPubPage >= totalPages;
        navHtml += `
          <button type="button" onclick="goToOverviewPubPage(${overviewPubPage + 1})"
                  ${nextDisabled ? 'disabled' : ''}
                  class="px-2 py-1 text-xs rounded border border-[var(--rule-strong)] bg-[var(--paper)] text-[var(--ink)] hover:text-[var(--crimson)] hover:border-[var(--crimson)] disabled:opacity-30 disabled:pointer-events-none transition flex items-center gap-1 cursor-pointer font-medium"
                  title="Halaman Selanjutnya">
            <span class="hidden sm:inline">Selanjutnya</span>
            <svg class="w-3 h-3" width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        `;

        pageNav.innerHTML = navHtml;
      }
    }

    // 7. Render Antrean Kurasi (Curator Hub)
    function renderKurasiList() {
      const container = document.getElementById('kurasi-list-container');
      if (!container) return;
      const searchVal = ((document.getElementById('search-kurasi') as HTMLInputElement)?.value || '').toLowerCase();
      
      let list = fullDb.karya.filter(k => k.status === 'menunggu_kurasi');
      if (searchVal) {
        list = list.filter(k => k.title.toLowerCase().includes(searchVal) || k.author.toLowerCase().includes(searchVal));
      }

      if (list.length === 0) {
        container.innerHTML = `
          <div class="p-12 text-center bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-xl">
            <p class="font-['Fraunces',serif] text-base text-[var(--ink)] m-0">Semua kiriman santri telah selesai dikurasi.</p>
            <p class="mono text-xs text-[var(--ink-faint)] mt-1 mb-0">Naskah baru yang dikirim siswa melalui formulir akan muncul di sini.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = list.map(k => `
        <div class="p-5 bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-xl shadow-xs space-y-3">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
              <div class="flex items-center gap-2 mb-1.5">
