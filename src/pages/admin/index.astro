    // Pagination state for Catalog Table
    let karyaCatalogPage = 1;
    let karyaCatalogPerPage = 10;

    (window as any).changeKaryaCatalogPerPage = function(val: string) {
      karyaCatalogPerPage = val === 'all' ? 999999 : (parseInt(val, 10) || 10);
      karyaCatalogPage = 1;
      renderKaryaCatalog();
    };

    (window as any).goToKaryaCatalogPage = function(page: number) {
      karyaCatalogPage = page;
      renderKaryaCatalog();
    };

    // 8. Render Karya Catalog Table (with Interactive Pagination)
    function renderKaryaCatalog(resetPage = false) {
      const tbody = document.getElementById('karya-table-body');
      const paginationBar = document.getElementById('karya-catalog-pagination');
      const pageInfo = document.getElementById('karya-catalog-page-info');
      const pageNav = document.getElementById('karya-catalog-nav');
      if (!tbody) return;

      if (resetPage) karyaCatalogPage = 1;

      const searchVal = ((document.getElementById('search-karya') as HTMLInputElement)?.value || '').toLowerCase();
      const filterCat = (document.getElementById('filter-karya-kategori') as HTMLSelectElement)?.value || 'all';
      const filterStat = (document.getElementById('filter-karya-status') as HTMLSelectElement)?.value || 'all';

      let list = [...fullDb.karya];
      if (searchVal) {
        list = list.filter(k => k.title.toLowerCase().includes(searchVal) || k.author.toLowerCase().includes(searchVal));
      }
      if (filterCat !== 'all') {
        list = list.filter(k => k.category === filterCat);
      }
      if (filterStat !== 'all') {
        list = list.filter(k => k.status === filterStat);
      }

      const totalFiltered = list.length;

      if (totalFiltered === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center mono text-xs text-[var(--ink-faint)] italic">Tidak ada karya yang sesuai dengan filter.</td></tr>';
        if (paginationBar) paginationBar.classList.add('hidden');
        return;
      }

      if (paginationBar) paginationBar.classList.remove('hidden');

      const isAll = (karyaCatalogPerPage >= 999999);
      const perPage = isAll ? totalFiltered : karyaCatalogPerPage;
      const totalPages = Math.max(1, Math.ceil(totalFiltered / perPage));

      if (karyaCatalogPage < 1) karyaCatalogPage = 1;
      if (karyaCatalogPage > totalPages) karyaCatalogPage = totalPages;

      const startIndex = (karyaCatalogPage - 1) * perPage;
      const endIndex = Math.min(startIndex + perPage, totalFiltered);
      const pageList = list.slice(startIndex, endIndex);

      tbody.innerHTML = pageList.map(k => {
        let statusBadge = '';
        if (k.status === 'published') {
          statusBadge = '<span class="px-2 py-0.5 rounded-full text-[0.68rem] mono font-bold bg-emerald-100 text-emerald-800">Tayang</span>';
        } else if (k.status === 'menunggu_kurasi') {
          statusBadge = '<span class="px-2 py-0.5 rounded-full text-[0.68rem] mono font-bold bg-rose-100 text-rose-800">Kurasi</span>';
        } else {
          statusBadge = '<span class="px-2 py-0.5 rounded-full text-[0.68rem] mono font-bold bg-amber-100 text-amber-800">Draf</span>';
        }

        const formattedImgUrl = k.cover_image_url ? formatDriveImageUrl(k.cover_image_url) : '';
        const coverImg = formattedImgUrl 
          ? `<img src="${formattedImgUrl}" class="w-9 h-9 rounded object-cover border border-[var(--rule)]" alt="Sampul" />`
          : `<div class="w-9 h-9 rounded bg-[var(--paper-deep)] border border-[var(--rule)] flex items-center justify-center mono text-[0.68rem] text-[var(--ink-faint)]">N/A</div>`;

        return `
          <tr class="hover:bg-[var(--paper-deep)]/40 transition-colors">
            <td class="px-4 py-3">${coverImg}</td>
            <td class="px-4 py-3">
              <a href="${basePath}/karya/${k.slug}" target="_blank" class="font-['Fraunces',serif] font-bold text-xs text-[var(--ink)] hover:text-[var(--crimson)] no-underline block max-w-xs truncate">
                ${k.title}
              </a>
              <span class="mono text-[0.68rem] text-[var(--ink-faint)] truncate block">${k.slug}</span>
            </td>
            <td class="px-4 py-3">
              <span class="font-semibold text-xs text-[var(--ink)] block">${k.author}</span>
              <span class="mono text-[0.68rem] text-[var(--ink-faint)]">${k.author_grade || '-'}</span>
            </td>
            <td class="px-4 py-3">
              <span class="mono text-[0.65rem] px-2 py-0.5 rounded border border-[var(--rule)] text-[var(--ink-soft)] uppercase">
                ${k.category_label || k.category}
              </span>
            </td>
            <td class="px-4 py-3 mono text-xs font-semibold text-[var(--ink)]">
              👁️ ${(k.views || 0).toLocaleString('id-ID')}
            </td>
            <td class="px-4 py-3">${statusBadge}</td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <div class="inline-flex items-center gap-1.5">
                <a href="${basePath}/karya/${k.slug}" target="_blank" title="Lihat di Web" class="p-1 text-[var(--ink-soft)] hover:text-[var(--crimson)]">
                  👁️
                </a>
                <button type="button" onclick="editKaryaBySlug('${k.slug}')" title="Sunting Naskah" class="p-1 text-[var(--ink-soft)] hover:text-[var(--crimson)] cursor-pointer">
                  ✎
                </button>
                <button type="button" onclick="quickToggleStatus('${k.slug || k.id}', '${k.status}')" title="Ubah Status" class="p-1 text-[var(--gold)] hover:underline cursor-pointer">
                  ⇄
                </button>
                <button type="button" onclick="quickDelete('${k.slug || k.id}', '${k.title}')" title="Hapus Permanen" class="p-1 text-rose-700 hover:text-rose-900 cursor-pointer">
                  🗑
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      // Update Page Info
      if (pageInfo) {
        const isFiltered = totalFiltered < fullDb.karya.length;
        const filterNote = isFiltered ? ` (difilter dari ${fullDb.karya.length} karya)` : '';
        if (isAll) {
          pageInfo.textContent = `Menampilkan semua ${totalFiltered} karya${filterNote}`;
        } else {
          pageInfo.textContent = `Menampilkan ${startIndex + 1}–${endIndex} dari ${totalFiltered} karya${filterNote}`;
        }
      }

      // Render Pagination Buttons
      if (pageNav) {
        if (totalPages <= 1) {
          pageNav.innerHTML = '';
          return;
        }

        let navHtml = '';
        const prevDisabled = karyaCatalogPage <= 1;
        navHtml += `
          <button type="button" onclick="goToKaryaCatalogPage(${karyaCatalogPage - 1})"
                  ${prevDisabled ? 'disabled' : ''}
                  class="px-2 py-1 text-xs rounded border border-[var(--rule-strong)] bg-[var(--paper)] text-[var(--ink)] hover:text-[var(--crimson)] hover:border-[var(--crimson)] disabled:opacity-30 disabled:pointer-events-none transition flex items-center gap-1 cursor-pointer font-medium"
                  title="Halaman Sebelumnya">
            <svg class="w-3 h-3" width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            <span class="hidden sm:inline">Sebelumnya</span>
          </button>
        `;

        const pages = getPaginationRange(karyaCatalogPage, totalPages);
        pages.forEach(p => {
          if (p === '...') {
            navHtml += `<span class="px-1.5 py-0.5 text-xs text-[var(--ink-faint)] select-none">…</span>`;
          } else {
            const isActive = (p === karyaCatalogPage);
            if (isActive) {
              navHtml += `
                <button type="button" class="w-7 h-7 flex items-center justify-center text-xs font-bold rounded bg-[var(--crimson)] text-[var(--paper)] shadow-2xs select-none">
                  ${p}
                </button>
              `;
            } else {
              navHtml += `
                <button type="button" onclick="goToKaryaCatalogPage(${p})"
                        class="w-7 h-7 flex items-center justify-center text-xs font-medium rounded border border-[var(--rule-strong)] bg-[var(--paper)] text-[var(--ink)] hover:text-[var(--crimson)] hover:border-[var(--crimson)] transition cursor-pointer select-none">
                  ${p}
                </button>
              `;
            }
          }
        });

        const nextDisabled = karyaCatalogPage >= totalPages;
        navHtml += `
          <button type="button" onclick="goToKaryaCatalogPage(${karyaCatalogPage + 1})"
                  ${nextDisabled ? 'disabled' : ''}
                  class="px-2 py-1 text-xs rounded border border-[var(--rule-strong)] bg-[var(--paper)] text-[var(--ink)] hover:text-[var(--crimson)] hover:border-[var(--crimson)] disabled:opacity-30 disabled:pointer-events-none transition flex items-center gap-1 cursor-pointer font-medium"
                  title="Halaman Selanjutnya">
            <span class="hidden sm:inline">Selanjutnya</span>
            <svg class="w-3 h-3" width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        `;

        pageNav.innerHTML = navHtml;
      }
    }

    // 9. Render Komentar List
    function renderKomentarList() {
