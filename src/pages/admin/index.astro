          >
            Batal
          </button>
          <button 
            type="submit" 
            id="btn-confirm-ganti-password-saya" 
            class="px-5 py-2 rounded-xl bg-[var(--crimson)] hover:bg-[#63241e] text-[var(--paper)] font-bold text-xs mono shadow-xs transition-all cursor-pointer"
          >
            Perbarui Sandi
          </button>
        </div>
