    // ==========================================================
    // 11. MANAJEMEN PENGGUNA (PENULIS SANTRI & DEWAN REDAKSI)
    // ==========================================================
    function escapeHtml(str: string): string {
      return (str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function generateRandomPassword(prefix = 'yq'): string {
      const chars = '23456789abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ';
      let rand = '';
      for (let i = 0; i < 6; i++) {
        rand += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return `${prefix}-${rand}`;
    }

    function switchUserSubTab(tab: 'santri' | 'admin') {
      currentUserSubTab = tab;
      const btnSantri = document.getElementById('subtab-btn-santri');
      const btnAdmin = document.getElementById('subtab-btn-admin');
      const panelSantri = document.getElementById('subpanel-santri');
      const panelAdmin = document.getElementById('subpanel-admin');

      if (tab === 'santri') {
        panelSantri?.classList.remove('hidden');
        panelAdmin?.classList.add('hidden');

        btnSantri?.classList.add('bg-[var(--paper-card)]', 'text-[var(--crimson)]', 'shadow-xs', 'font-bold');
        btnSantri?.classList.remove('text-[var(--ink-soft)]');

        btnAdmin?.classList.remove('bg-[var(--paper-card)]', 'text-[var(--crimson)]', 'shadow-xs', 'font-bold');
        btnAdmin?.classList.add('text-[var(--ink-soft)]');

        renderPenulisList();
      } else {
        panelSantri?.classList.add('hidden');
        panelAdmin?.classList.remove('hidden');

        btnAdmin?.classList.add('bg-[var(--paper-card)]', 'text-[var(--crimson)]', 'shadow-xs', 'font-bold');
        btnAdmin?.classList.remove('text-[var(--ink-soft)]');

        btnSantri?.classList.remove('bg-[var(--paper-card)]', 'text-[var(--crimson)]', 'shadow-xs', 'font-bold');
        btnSantri?.classList.add('text-[var(--ink-soft)]');

        renderAdminList();
      }
    }
    (window as any).switchUserSubTab = switchUserSubTab;

    function updateUserStatsCounter() {
      const santriCount = fullDb.penulis?.length || 0;
      const adminCount = fullDb.admin?.length || 0;

      const badgeSantri = document.getElementById('subtab-badge-santri');
      const badgeAdmin = document.getElementById('subtab-badge-admin');
      const userStats = document.getElementById('user-mgmt-stats');
      const sideBadgePenulis = document.getElementById('sidebar-badge-penulis');

      if (badgeSantri) badgeSantri.textContent = santriCount.toString();
      if (badgeAdmin) badgeAdmin.textContent = adminCount.toString();
      if (userStats) userStats.textContent = `${santriCount} Santri Terdaftar · ${adminCount} Dewan Redaksi`;
      if (sideBadgePenulis) sideBadgePenulis.textContent = (santriCount + adminCount).toString();
    }

    function onSantriSearch(val: string) {
      currentSantriSearch = (val || '').toLowerCase().trim();
      renderPenulisList();
    }
    (window as any).onSantriSearch = onSantriSearch;

    function onSantriKelasChange(val: string) {
      currentSantriKelasFilter = val || 'all';
      renderPenulisList();
    }
    (window as any).onSantriKelasChange = onSantriKelasChange;

    // Render Santri Table
    function renderPenulisList() {
      const tbody = document.getElementById('penulis-table-body');
      if (!tbody) return;

      let list = fullDb.penulis || [];
      if (currentSantriKelasFilter !== 'all') {
        list = list.filter(p => (p.kelas || '').toLowerCase().includes(currentSantriKelasFilter.toLowerCase()));
      }
      if (currentSantriSearch) {
        list = list.filter(p => 
          (p.nama || '').toLowerCase().includes(currentSantriSearch) ||
          (p.email || '').toLowerCase().includes(currentSantriSearch) ||
          (p.kelas || '').toLowerCase().includes(currentSantriSearch)
        );
      }

      if (list.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="p-8 text-center mono text-xs text-[var(--ink-faint)] italic">
              ${(currentSantriSearch || currentSantriKelasFilter !== 'all') 
                ? 'Tidak ada santri yang cocok dengan filter pencarian.' 
                : 'Belum ada akun santri terdaftar. Klik "+ Tambah Akun Santri" untuk menambahkan.'}
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = list.map(p => {
        const pNamaEsc = escapeHtml(p.nama);
        const pEmailEsc = escapeHtml(p.email);
        const pIdEsc = escapeHtml(p.id || p.email);
        const initials = (p.nama || 'S').trim().split(/\s+/).slice(0, 2).map(w => w[0]).join('').toUpperCase() || 'S';
        
        const karyaCount = (fullDb.karya || []).filter(k => 
          (k.author && k.author.toLowerCase() === p.nama.toLowerCase()) ||
          ((k as any).author_email && (k as any).author_email.toLowerCase() === p.email.toLowerCase())
        ).length;

        const cleanWa = (p.kontak || '').replace(/[^0-9]/g, '');
        const waDisplay = cleanWa
          ? `<a href="https://wa.me/${cleanWa}" target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:underline flex items-center gap-1 font-semibold">
              <svg class="w-3.5 h-3.5" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              <span>${escapeHtml(p.kontak || '')}</span>
            </a>`
          : '<span class="text-[var(--ink-faint)]">-</span>';

        return `
          <tr class="hover:bg-[var(--paper-deep)]/40 transition-colors">
            <td class="px-4 py-3">
              <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-full bg-[var(--paper-deep)] border border-[var(--rule-strong)] text-[var(--crimson)] font-['Fraunces',serif] font-bold text-xs flex items-center justify-center shrink-0">
                  ${initials}
                </div>
                <div>
                  <p class="font-bold text-xs text-[var(--ink)] m-0">${pNamaEsc}</p>
                  <p class="mono text-[0.62rem] text-[var(--ink-faint)] m-0">ID: ${pIdEsc}</p>
                </div>
              </div>
            </td>
            <td class="px-4 py-3">
              <span class="mono text-[0.68rem] px-2 py-0.5 rounded-full bg-[var(--paper-deep)] border border-[var(--rule)] text-[var(--ink)] font-medium">
                ${escapeHtml(p.kelas || '-')}
              </span>
            </td>
            <td class="px-4 py-3 mono text-xs text-[var(--crimson)]">
              ${pEmailEsc}
            </td>
            <td class="px-4 py-3 mono text-xs">
              ${waDisplay}
            </td>
            <td class="px-4 py-3 text-center">
              <span class="mono text-xs font-bold ${karyaCount > 0 ? 'text-[var(--crimson)] bg-rose-50 border border-rose-200' : 'text-[var(--ink-faint)] bg-[var(--paper-deep)]'} px-2 py-0.5 rounded-full">
                ${karyaCount} naskah
              </span>
            </td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-1.5">
                <button 
                  type="button" 
                  onclick="openSantriModal('${pIdEsc}')" 
                  class="px-2 py-1 rounded-lg border border-[var(--rule-strong)] hover:border-[var(--crimson)] hover:text-[var(--crimson)] text-[var(--ink-soft)] text-[0.68rem] mono transition-colors cursor-pointer"
                  title="Edit Profil Santri"
                >
                  Edit
                </button>
                <button 
                  type="button" 
                  onclick="openResetSandiSantriModal('${pIdEsc}', '${pNamaEsc}', '${pEmailEsc}')" 
                  class="px-2 py-1 rounded-lg border border-amber-300 bg-amber-50/60 hover:bg-amber-100 text-amber-900 text-[0.68rem] mono font-bold transition-colors cursor-pointer"
                  title="Reset Kata Sandi Santri"
