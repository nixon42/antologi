---
import Layout from '../../layouts/Layout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout 
  title="Studio Redaksi & Dashboard Admin — Ruang Sastra SMPI YQ"
  description="Pusat kerja dewan redaksi SMPI Yambu'ul Qur'an: kurasi kiriman santri, kelola karya sastra terpublikasi, moderasi komentar, dan kutipan sastra real-time ke Cloud Database."
>
  <!-- AUTH GUARD BARRIER (Shown when not logged in) -->
  <div id="auth-guard-barrier" class="wrap py-16 md:py-24 text-center hidden">
    <div class="max-w-md mx-auto bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-2xl p-8 shadow-xl">
      <div class="w-14 h-14 rounded-full border-2 border-[var(--crimson)] bg-[var(--paper)] flex items-center justify-center font-['Fraunces',serif] font-bold text-lg text-[var(--crimson)] mx-auto mb-4 shadow-inner">
        YQ
      </div>
      <span class="mono text-[0.68rem] text-[var(--gold)] uppercase tracking-widest font-semibold block mb-1">
        Akses Terproteksi
      </span>
      <h2 class="font-['Fraunces',serif] font-bold text-2xl text-[var(--ink)] m-0">
        Studio Dewan Redaksi
      </h2>
      <p class="font-['Source_Serif_4',serif] italic text-xs sm:text-sm text-[var(--ink-soft)] mt-2 leading-relaxed">
        Anda harus masuk dengan kredensial Dewan Redaksi SMPI Yambu'ul Qur'an untuk mengakses dashboard manajemen literatur ini.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={`${basePath}/admin/login`} class="btn-literary btn-literary-solid !w-full sm:!w-auto !py-2.5 !px-5 text-xs no-underline text-center">
          Masuk ke Studio Redaksi →
        </a>
        <a href={`${basePath}/`} class="mono text-xs text-[var(--ink-faint)] hover:text-[var(--crimson)] no-underline">
          Kembali ke Beranda
        </a>
      </div>
    </div>
  </div>

  <!-- MAIN ADMIN DASHBOARD INTERFACE (like smpalmubarokweb) -->
  <div id="admin-panel" class="hidden min-h-[85vh] bg-[var(--paper)] flex flex-col md:flex-row border-t border-[var(--rule)]">
    
    <!-- DESKTOP LEFT SIDEBAR -->
    <aside class="w-full md:w-64 lg:w-72 bg-[var(--paper-card)] border-r border-[var(--rule-strong)] flex-shrink-0 flex flex-col justify-between hidden md:flex">
      
      <!-- Top Brand Section -->
      <div>
        <div class="p-5 border-b border-[var(--rule)] flex items-center gap-3">
          <div class="w-10 h-10 rounded-full border border-[var(--crimson)] bg-[var(--paper)] flex items-center justify-center font-['Fraunces',serif] font-bold text-sm text-[var(--crimson)] flex-shrink-0 shadow-inner">
            YQ
          </div>
          <div class="min-w-0">
            <h2 class="font-['Fraunces',serif] font-bold text-base text-[var(--ink)] m-0 truncate">
              Studio Redaksi
            </h2>
            <p class="mono text-[0.65rem] text-[var(--gold)] font-medium uppercase tracking-wider m-0 truncate">
              SMPI Yambu'ul Qur'an
            </p>
          </div>
        </div>

        <!-- Cloud Status Pill -->
        <div class="px-5 py-3 border-b border-[var(--rule)] bg-[var(--paper-deep)] flex items-center justify-between">
          <div class="flex items-center gap-2 mono text-[0.68rem] text-[var(--ink)]">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Cloud Database Aktif</span>
          </div>
          <span class="mono text-[0.62rem] text-[var(--gold)] font-bold">Sheets &amp; Drive</span>
        </div>

        <!-- Sidebar Navigation Menu Items -->
        <nav class="py-3 px-3 space-y-1">
          <button 
            type="button" 
            onclick="switchAdminSection('ringkasan')" 
            id="nav-btn-ringkasan" 
            class="admin-nav-item w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all cursor-pointer bg-[var(--paper-deep)] text-[var(--crimson)] font-bold border-l-4 border-[var(--crimson)]"
          >
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-[var(--crimson)]" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
              <span>Ringkasan &amp; Statistik</span>
            </div>
          </button>

          <button 
            type="button" 
            onclick="switchAdminSection('kurasi')" 
            id="nav-btn-kurasi" 
            class="admin-nav-item w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all cursor-pointer text-[var(--ink-soft)] hover:bg-[var(--paper-deep)] hover:text-[var(--ink)]"
          >
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-[var(--gold)]" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
              </svg>
              <span>Antrean Kurasi</span>
            </div>
            <span id="sidebar-badge-kurasi" class="px-2 py-0.5 rounded-full text-[0.62rem] mono font-bold bg-rose-100 text-rose-800">0</span>
          </button>

          <button 
            type="button" 
            onclick="switchAdminSection('karya')" 
            id="nav-btn-karya" 
            class="admin-nav-item w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all cursor-pointer text-[var(--ink-soft)] hover:bg-[var(--paper-deep)] hover:text-[var(--ink)]"
          >
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-[var(--crimson)]" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
              <span>Karya Sastra (Katalog)</span>
            </div>
            <span id="sidebar-badge-karya" class="px-2 py-0.5 rounded-full text-[0.62rem] mono font-bold bg-[var(--paper-deep)] text-[var(--ink)]">0</span>
          </button>

          <button 
            type="button" 
            onclick="switchAdminSection('komentar')" 
            id="nav-btn-komentar" 
            class="admin-nav-item w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all cursor-pointer text-[var(--ink-soft)] hover:bg-[var(--paper-deep)] hover:text-[var(--ink)]"
          >
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-emerald-700" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
              </svg>
              <span>Catatan &amp; Komentar</span>
            </div>
            <span id="sidebar-badge-komentar" class="px-2 py-0.5 rounded-full text-[0.62rem] mono font-bold bg-[var(--paper-deep)] text-[var(--ink)]">0</span>
          </button>

          <button 
            type="button" 
            onclick="switchAdminSection('quotes')" 
            id="nav-btn-quotes" 
            class="admin-nav-item w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all cursor-pointer text-[var(--ink-soft)] hover:bg-[var(--paper-deep)] hover:text-[var(--ink)]"
          >
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-[var(--gold)]" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
              </svg>
              <span>Quotes &amp; Mutiara</span>
            </div>
            <span id="sidebar-badge-quotes" class="px-2 py-0.5 rounded-full text-[0.62rem] mono font-bold bg-[var(--paper-deep)] text-[var(--ink)]">0</span>
          </button>

          <button 
            type="button" 
            onclick="switchAdminSection('penulis')" 
            id="nav-btn-penulis" 
            class="admin-nav-item w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all cursor-pointer text-[var(--ink-soft)] hover:bg-[var(--paper-deep)] hover:text-[var(--ink)]"
          >
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-blue-700" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
              <span>Penulis Santri</span>
            </div>
            <span id="sidebar-badge-penulis" class="px-2 py-0.5 rounded-full text-[0.62rem] mono font-bold bg-[var(--paper-deep)] text-[var(--ink)]">0</span>
          </button>

          <button 
            type="button" 
            onclick="switchAdminSection('pengaturan')" 
            id="nav-btn-pengaturan" 
            class="admin-nav-item w-full text-left px-3.5 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between transition-all cursor-pointer text-[var(--ink-soft)] hover:bg-[var(--paper-deep)] hover:text-[var(--ink)]"
          >
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-[var(--ink-soft)]" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span>Pengaturan Portal</span>
            </div>
            <span class="mono text-[0.62rem] text-[var(--gold)]">Cloud</span>
          </button>

          <div class="pt-2">
            <button 
              type="button" 
              onclick="openEditorModal(null)" 
              class="w-full py-2.5 px-3.5 rounded-xl bg-[var(--crimson)] hover:bg-[#63241e] text-[var(--paper)] font-['Fraunces',serif] font-bold text-xs shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <svg class="w-3.5 h-3.5" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <span>+ Tulis Karya Baru</span>
            </button>
          </div>
        </nav>
      </div>

      <!-- Bottom Profile & Logout -->
      <div class="p-4 border-t border-[var(--rule)] bg-[var(--paper)] space-y-2.5">
        <div class="flex items-center justify-between">
          <div class="min-w-0">
            <p id="admin-user-display-email" class="mono text-[0.72rem] font-bold text-[var(--ink)] truncate m-0">
              redaksi@yq.sch.id
            </p>
            <p id="admin-user-display-role" class="mono text-[0.62rem] text-[var(--crimson)] uppercase font-semibold m-0">
              Redaktur Utama
            </p>
          </div>
          <a href={`${basePath}/`} target="_blank" class="p-1.5 rounded-lg border border-[var(--rule)] text-[var(--ink-soft)] hover:text-[var(--crimson)] hover:bg-[var(--paper-deep)] transition-colors" title="Buka Portal Beranda di tab baru">
            <svg class="w-4 h-4" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        </div>

        <button 
          type="button" 
          id="btn-admin-logout" 
          class="w-full py-2 px-3 rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-800 mono text-xs font-semibold transition-colors flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          <span>Keluar dari Sesi</span>
        </button>
      </div>

    </aside>

    <!-- RIGHT MAIN CONTENT AREA -->
    <div class="flex-1 min-w-0 flex flex-col overflow-hidden">
      
      <!-- TOP ACTION BAR -->
      <div class="bg-[var(--paper-card)] border-b border-[var(--rule-strong)] px-5 py-3.5 flex items-center justify-between gap-3 flex-wrap">
        
        <!-- Mobile Selector & Title -->
        <div class="flex items-center gap-3">
          <select 
            id="admin-mobile-nav" 
            onchange="switchAdminSection(this.value)" 
            class="md:hidden px-3 py-1.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-lg text-xs mono font-bold text-[var(--ink)] outline-none"
          >
            <option value="ringkasan">📊 Ringkasan &amp; Statistik</option>
            <option value="kurasi">📥 Antrean Kurasi Naskah</option>
            <option value="karya">📚 Seluruh Karya Sastra</option>
            <option value="komentar">💬 Catatan &amp; Komentar</option>
            <option value="quotes">📜 Quotes &amp; Mutiara</option>
            <option value="penulis">👥 Penulis Santri</option>
            <option value="pengaturan">⚙️ Pengaturan Portal</option>
          </select>

          <div class="hidden md:block">
            <h1 id="topbar-section-title" class="font-['Fraunces',serif] font-bold text-lg text-[var(--ink)] m-0">
              Ringkasan &amp; Statistik
            </h1>
            <p id="topbar-section-sub" class="mono text-[0.68rem] text-[var(--ink-soft)] m-0">
              Studio Redaksi SMPI Yambu'ul Qur'an
            </p>
          </div>
        </div>

        <!-- Top Right Actions -->
        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="btn-sync-cloud" 
            onclick="loadAllAdminData()" 
            class="px-3 py-1.5 rounded-lg border border-[var(--rule-strong)] bg-[var(--paper)] hover:bg-[var(--paper-deep)] text-[var(--ink)] mono text-xs font-medium cursor-pointer transition-colors flex items-center gap-1.5"
            title="Segarkan data dari Google Sheets &amp; Drive"
          >
            <svg id="sync-icon" class="w-3.5 h-3.5 text-[var(--crimson)]" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            <span id="sync-text">Segarkan Data</span>
          </button>

          <button 
            type="button" 
            onclick="openEditorModal(null)" 
            class="px-3.5 py-1.5 rounded-lg bg-[var(--crimson)] hover:bg-[#63241e] text-[var(--paper)] font-['Fraunces',serif] font-bold text-xs shadow-sm transition-all cursor-pointer flex items-center gap-1.5"
          >
            <span>+ Tulis Naskah</span>
          </button>
        </div>
      </div>

      <!-- BODY SECTIONS CONTAINER -->
      <div class="flex-1 p-4 md:p-6 lg:p-8 overflow-y-auto space-y-6">
        
        <!-- SECTION 1: RINGKASAN & OVERVIEW -->
        <div id="section-ringkasan" class="admin-section space-y-6">
          
          <!-- 4 KPI Metrics Strip -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            
            <!-- Antrean Kurasi -->
            <div class="p-4 bg-[var(--paper-card)] border border-[var(--crimson)] rounded-xl shadow-xs relative overflow-hidden">
              <span class="mono text-[0.68rem] text-[var(--crimson)] uppercase tracking-wider font-bold">Antrean Kurasi</span>
              <div class="flex items-baseline justify-between mt-2">
                <span id="kpi-submissions" class="font-['Fraunces',serif] font-bold text-3xl text-[var(--crimson)]">0</span>
                <span class="mono text-[0.68rem] text-rose-700 font-semibold bg-rose-50 px-2 py-0.5 rounded-full">Perlu Review</span>
              </div>
              <p class="mono text-[0.65rem] text-[var(--ink-faint)] mt-1.5 mb-0">Naskah santri menunggu persetujuan</p>
            </div>

            <!-- Terpublikasi -->
            <div class="p-4 bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-xl shadow-xs">
              <span class="mono text-[0.68rem] text-emerald-800 uppercase tracking-wider font-bold">Karya Tayang</span>
              <div class="flex items-baseline justify-between mt-2">
                <span id="kpi-published" class="font-['Fraunces',serif] font-bold text-3xl text-[var(--ink)]">0</span>
                <span class="mono text-[0.68rem] text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded-full">Publik</span>
              </div>
              <p class="mono text-[0.65rem] text-[var(--ink-faint)] mt-1.5 mb-0">Dapat dibaca oleh umum di Pojok Baca</p>
            </div>

            <!-- Draf Redaksi -->
            <div class="p-4 bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-xl shadow-xs">
              <span class="mono text-[0.68rem] text-[var(--gold)] uppercase tracking-wider font-bold">Draf Redaksi</span>
              <div class="flex items-baseline justify-between mt-2">
                <span id="kpi-drafts" class="font-['Fraunces',serif] font-bold text-3xl text-[var(--ink)]">0</span>
                <span class="mono text-[0.68rem] text-amber-800 font-semibold bg-amber-50 px-2 py-0.5 rounded-full">Proses</span>
              </div>
              <p class="mono text-[0.65rem] text-[var(--ink-faint)] mt-1.5 mb-0">Naskah dalam penyuntingan redaksi</p>
            </div>

            <!-- Catatan Pembaca -->
            <div class="p-4 bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-xl shadow-xs">
              <span class="mono text-[0.68rem] text-blue-800 uppercase tracking-wider font-bold">Catatan Pembaca</span>
              <div class="flex items-baseline justify-between mt-2">
                <span id="kpi-comments" class="font-['Fraunces',serif] font-bold text-3xl text-[var(--ink)]">0</span>
                <span class="mono text-[0.68rem] text-blue-700 font-semibold bg-blue-50 px-2 py-0.5 rounded-full">Komentar</span>
              </div>
              <p class="mono text-[0.65rem] text-[var(--ink-faint)] mt-1.5 mb-0">Respon dan catatan dari pembaca</p>
            </div>

          </div>

          <!-- Quick Submission Queue (Antrean Cepat Kurasi) -->
          <div class="bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-xl shadow-sm overflow-hidden">
            <div class="p-4 border-b border-[var(--rule)] flex items-center justify-between">
              <div class="flex items-center gap-2">
                <h3 class="font-['Fraunces',serif] font-bold text-base text-[var(--ink)] m-0">
                  Antrean Naskah Santri Menunggu Kurasi
                </h3>
                <span id="overview-badge-queue" class="mono text-xs px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 font-bold">0</span>
              </div>
              <button onclick="switchAdminSection('kurasi')" class="mono text-xs text-[var(--crimson)] hover:underline font-semibold cursor-pointer">
                Buka Seluruh Antrean →
              </button>
            </div>
            
            <div id="overview-queue-container" class="divide-y divide-[var(--rule)]">
              <p class="p-6 text-center mono text-xs text-[var(--ink-faint)] italic">Memuat antrean naskah...</p>
            </div>
          </div>

          <!-- Recently Published Works -->
          <div class="bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-xl shadow-sm overflow-hidden">
            <div class="p-4 border-b border-[var(--rule)] flex items-center justify-between">
              <h3 class="font-['Fraunces',serif] font-bold text-base text-[var(--ink)] m-0">
                Karya Sastra Terpublikasi Terbaru
              </h3>
              <button onclick="switchAdminSection('karya')" class="mono text-xs text-[var(--crimson)] hover:underline font-semibold cursor-pointer">
                Kelola Semua Karya →
              </button>
            </div>
