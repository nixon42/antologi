  <!-- SCRIPT LOGIC FOR ADMIN DASHBOARD -->
  <script>
    import { 
      getAdminUser, 
      logoutAdmin, 
      getFullData, 
      simpanKarya, 
      hapusKarya, 
      updateStatusKarya, 
      uploadFotoKarya, 
      simpanQuote, 
      hapusQuote, 
      hapusKomentar,
      getPengaturan,
      simpanPengaturan,
      formatDriveImageUrl,
      type KaryaInput,
      type FullDatabaseDump 
    } from '../../lib/supabase';
    import confetti from 'canvas-confetti';

    const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

    // State Variables
    let currentAdminUser: any = null;
    let fullDb: FullDatabaseDump = {
      karya: [],
      quotes: [],
      komentar: [],
      apresiasi: [],
      penulis: []
    };

    // DOM Elements
    const authBarrier = document.getElementById('auth-guard-barrier');
    const adminPanel = document.getElementById('admin-panel');
    const adminEmailDisplay = document.getElementById('admin-user-display-email');
    const adminRoleDisplay = document.getElementById('admin-user-display-role');
    const btnLogout = document.getElementById('btn-admin-logout');

    // KPI Elements
    const kpiSubmissions = document.getElementById('kpi-submissions');
    const kpiPublished = document.getElementById('kpi-published');
    const kpiDrafts = document.getElementById('kpi-drafts');
    const kpiComments = document.getElementById('kpi-comments');

    // Sidebar Badges
    const badgeKurasi = document.getElementById('sidebar-badge-kurasi');
    const badgeKarya = document.getElementById('sidebar-badge-karya');
    const badgeKomentar = document.getElementById('sidebar-badge-komentar');
    const badgeQuotes = document.getElementById('sidebar-badge-quotes');
    const badgePenulis = document.getElementById('sidebar-badge-penulis');
    const overviewBadgeQueue = document.getElementById('overview-badge-queue');

    // 1. Initial Authentication Guard
    async function initAdmin() {
      currentAdminUser = await getAdminUser();
      if (!currentAdminUser) {
        authBarrier?.classList.remove('hidden');
        adminPanel?.classList.add('hidden');
        return;
      }

      authBarrier?.classList.add('hidden');
      adminPanel?.classList.remove('hidden');

      if (adminEmailDisplay) adminEmailDisplay.textContent = currentAdminUser.email;
      if (adminRoleDisplay) adminRoleDisplay.textContent = currentAdminUser.role || 'Redaktur Pelaksana';

      // Load all database items
      await loadAllAdminData();
    }
    initAdmin();

    // Logout Handler
    btnLogout?.addEventListener('click', async () => {
      if (confirm('Keluar dari sesi Studio Redaksi?')) {
        await logoutAdmin();
        window.location.href = `${basePath}/admin/login?logout=1`;
      }
    });

    // 2. Fetch Data from Google Sheets & Drive Cloud Backend
    async function loadAllAdminData() {
      const syncIcon = document.getElementById('sync-icon');
      const syncText = document.getElementById('sync-text');
      if (syncIcon) syncIcon.classList.add('animate-spin');
      if (syncText) syncText.textContent = 'Memuat Cloud...';

      try {
        fullDb = await getFullData();
        updateKpiMetrics();
        renderOverviewQueue();
        renderOverviewPublished();
        renderKurasiList();
        renderKaryaCatalog();
        renderKomentarList();
        renderQuotesGrid();
        renderPenulisList();
        await loadPengaturanData();
      } catch (err) {
        console.warn('Gagal memuat database cloud:', err);
      } finally {
        if (syncIcon) syncIcon.classList.remove('animate-spin');
        if (syncText) syncText.textContent = 'Segarkan Data';
      }
    }
    (window as any).loadAllAdminData = loadAllAdminData;

    // 3. Update KPI Metrics
    function updateKpiMetrics() {
      const submissions = fullDb.karya.filter(k => k.status === 'menunggu_kurasi').length;
      const published = fullDb.karya.filter(k => k.status === 'published').length;
      const drafts = fullDb.karya.filter(k => k.status === 'draft').length;
      const comments = fullDb.komentar.length;
      const quotes = fullDb.quotes.length;
      const penulis = fullDb.penulis.length;

      if (kpiSubmissions) kpiSubmissions.textContent = submissions.toString();
      if (kpiPublished) kpiPublished.textContent = published.toString();
      if (kpiDrafts) kpiDrafts.textContent = drafts.toString();
      if (kpiComments) kpiComments.textContent = comments.toString();

      if (badgeKurasi) badgeKurasi.textContent = submissions.toString();
      if (badgeKarya) badgeKarya.textContent = fullDb.karya.length.toString();
      if (badgeKomentar) badgeKomentar.textContent = comments.toString();
      if (badgeQuotes) badgeQuotes.textContent = quotes.toString();
      if (badgePenulis) badgePenulis.textContent = penulis.toString();
      if (overviewBadgeQueue) overviewBadgeQueue.textContent = submissions.toString();
    }

    // 4. Section Switcher (like smpalmubarokweb)
    function switchAdminSection(sectionKey: string) {
      const sections = ['ringkasan', 'kurasi', 'karya', 'komentar', 'quotes', 'penulis', 'pengaturan'];
      const titles: Record<string, string> = {
        ringkasan: 'Ringkasan & Statistik',
        kurasi: 'Antrean Kurasi Naskah Masuk',
        karya: 'Katalog Karya Sastra Lengkap',
        komentar: 'Moderasi Catatan & Komentar',
        quotes: 'Quotes & Mutiara Sastra',
        penulis: 'Direktori Penulis Santri',
        pengaturan: 'Pengaturan Redaksi & Portal',
      };

      sections.forEach(k => {
        const secEl = document.getElementById(`section-${k}`);
        const navBtn = document.getElementById(`nav-btn-${k}`);
        if (k === sectionKey) {
          secEl?.classList.remove('hidden');
          navBtn?.classList.add('bg-[var(--paper-deep)]', 'text-[var(--crimson)]', 'font-bold', 'border-l-4', 'border-[var(--crimson)]');
          navBtn?.classList.remove('text-[var(--ink-soft)]');
        } else {
          secEl?.classList.add('hidden');
          navBtn?.classList.remove('bg-[var(--paper-deep)]', 'text-[var(--crimson)]', 'font-bold', 'border-l-4', 'border-[var(--crimson)]');
          navBtn?.classList.add('text-[var(--ink-soft)]');
        }
      });

      const topTitle = document.getElementById('topbar-section-title');
      if (topTitle) topTitle.textContent = titles[sectionKey] || 'Studio Redaksi';

      const mobileSelect = document.getElementById('admin-mobile-nav') as HTMLSelectElement;
      if (mobileSelect) mobileSelect.value = sectionKey;
    }
    (window as any).switchAdminSection = switchAdminSection;

    // 5. Render Overview Submissions Queue
    function renderOverviewQueue() {
      const container = document.getElementById('overview-queue-container');
      if (!container) return;
      const submissions = fullDb.karya.filter(k => k.status === 'menunggu_kurasi');

      if (submissions.length === 0) {
        container.innerHTML = `
          <div class="p-6 text-center text-xs mono text-[var(--ink-faint)] italic">
            Alhamdulillah! Tidak ada naskah santri yang tertunda kurasi saat ini.
          </div>
        `;
        return;
      }

      container.innerHTML = submissions.slice(0, 5).map(k => `
        <div class="p-4 flex items-center justify-between gap-3 flex-wrap hover:bg-[var(--paper-deep)]/50 transition-colors">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="mono text-[0.62rem] px-2 py-0.5 rounded-full border border-[var(--crimson)] text-[var(--crimson)] uppercase font-semibold">
                ${k.category_label || k.category}
              </span>
              <span class="mono text-[0.62rem] text-[var(--ink-faint)]">
                ${k.created_at ? new Date(k.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) : 'Baru'}
              </span>
            </div>
            <h4 class="font-['Fraunces',serif] font-bold text-sm text-[var(--ink)] m-0 truncate">
              ${k.title}
            </h4>
            <p class="mono text-[0.7rem] text-[var(--ink-soft)] m-0 mt-0.5">
              Oleh <span class="font-semibold text-[var(--ink)]">${k.author}</span> ${k.author_grade ? `(${k.author_grade})` : ''}
            </p>
          </div>

          <div class="flex items-center gap-2">
            <button 
              type="button" 
              onclick="quickPublish('${k.slug || k.id}')" 
              class="px-2.5 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white mono text-xs font-bold shadow-xs cursor-pointer flex items-center gap-1"
              title="Setujui dan langsung terbitkan ke publik"
            >
              <span>✓ Terbitkan</span>
            </button>
            <button 
              type="button" 
              onclick="editKaryaBySlug('${k.slug}')" 
              class="px-2.5 py-1.5 rounded-lg border border-[var(--rule-strong)] bg-[var(--paper)] hover:bg-[var(--paper-deep)] text-[var(--ink)] mono text-xs font-medium cursor-pointer"
            >
              <span>Sunting ✎</span>
            </button>
          </div>
        </div>
      `).join('');
    }

    // 6. Render Overview Recently Published
    function renderOverviewPublished() {
      const container = document.getElementById('overview-published-container');
      if (!container) return;
      const published = fullDb.karya.filter(k => k.status === 'published');

      if (published.length === 0) {
        container.innerHTML = '<div class="p-6 text-center text-xs mono text-[var(--ink-faint)] italic">Belum ada karya yang terpublikasi.</div>';
        return;
      }

      container.innerHTML = published.slice(0, 5).map(k => `
        <div class="p-4 flex items-center justify-between gap-3 hover:bg-[var(--paper-deep)]/50 transition-colors">
          <div class="min-w-0">
            <span class="mono text-[0.62rem] text-[var(--gold)] uppercase font-semibold">
              ${k.category_label || k.category}
            </span>
            <h4 class="font-['Fraunces',serif] font-bold text-sm text-[var(--ink)] m-0 truncate">
              ${k.title}
            </h4>
            <p class="mono text-[0.7rem] text-[var(--ink-faint)] m-0">
              Oleh ${k.author}
            </p>
          </div>
          <div class="flex items-center gap-2">
            <a 
              href="${basePath}/karya/${k.slug}" 
              target="_blank" 
              class="px-2.5 py-1 rounded-md border border-[var(--rule)] text-[var(--ink-soft)] hover:text-[var(--crimson)] text-xs mono no-underline flex items-center gap-1"
            >
              <span>Buka</span>
              <svg class="w-3 h-3" width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
            <button 
              type="button" 
              onclick="editKaryaBySlug('${k.slug}')" 
              class="px-2.5 py-1 rounded-md border border-[var(--rule-strong)] bg-[var(--paper)] text-xs mono text-[var(--ink)] hover:bg-[var(--paper-deep)] cursor-pointer"
            >
              Sunting
            </button>
          </div>
        </div>
      `).join('');
    }

    // 7. Render Antrean Kurasi (Curator Hub)
    function renderKurasiList() {
      const container = document.getElementById('kurasi-list-container');
      if (!container) return;
      const searchVal = ((document.getElementById('search-kurasi') as HTMLInputElement)?.value || '').toLowerCase();
      
      let list = fullDb.karya.filter(k => k.status === 'menunggu_kurasi');
      if (searchVal) {
        list = list.filter(k => k.title.toLowerCase().includes(searchVal) || k.author.toLowerCase().includes(searchVal));
      }

      if (list.length === 0) {
        container.innerHTML = `
          <div class="p-12 text-center bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-xl">
            <p class="font-['Fraunces',serif] text-base text-[var(--ink)] m-0">Semua kiriman santri telah selesai dikurasi.</p>
            <p class="mono text-xs text-[var(--ink-faint)] mt-1 mb-0">Naskah baru yang dikirim siswa melalui formulir akan muncul di sini.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = list.map(k => `
        <div class="p-5 bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-xl shadow-xs space-y-3">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
              <div class="flex items-center gap-2 mb-1.5">
                <span class="mono text-[0.65rem] px-2.5 py-0.5 rounded-full border border-[var(--crimson)] text-[var(--crimson)] uppercase font-bold">
                  ${k.category_label || k.category}
                </span>
                <span class="mono text-[0.65rem] px-2 py-0.5 rounded-full bg-rose-50 text-rose-800 border border-rose-200 font-semibold">
                  Menunggu Persetujuan
                </span>
              </div>
              <h3 class="font-['Fraunces',serif] font-bold text-lg text-[var(--ink)] m-0">
                ${k.title}
              </h3>
              <p class="mono text-xs text-[var(--ink-soft)] m-0 mt-0.5">
                Pengirim: <strong class="text-[var(--ink)]">${k.author}</strong> ${k.author_grade ? `· ${k.author_grade}` : ''}
              </p>
            </div>

            <div class="flex items-center gap-2">
              <button 
                type="button" 
                onclick="quickPublish('${k.slug || k.id}')" 
                class="px-3.5 py-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-['Fraunces',serif] font-bold text-xs shadow-xs cursor-pointer flex items-center gap-1.5"
              >
                <span>✓ Setujui &amp; Terbitkan</span>
              </button>
              <button 
                type="button" 
                onclick="editKaryaBySlug('${k.slug}')" 
                class="px-3 py-2 rounded-xl border border-[var(--rule-strong)] bg-[var(--paper)] hover:bg-[var(--paper-deep)] text-xs mono text-[var(--ink)] cursor-pointer"
              >
                <span>Sunting ✎</span>
              </button>
              <button 
                type="button" 
                onclick="quickDraft('${k.slug || k.id}')" 
                class="px-3 py-2 rounded-xl border border-[var(--rule-strong)] bg-[var(--paper)] text-xs mono text-[var(--gold)] cursor-pointer"
                title="Pindahkan ke draf untuk ditinjau nanti"
              >
                <span>Jadikan Draf</span>
              </button>
              <button 
                type="button" 
                onclick="quickDelete('${k.slug || k.id}', '${k.title}')" 
                class="p-2 rounded-xl text-rose-700 hover:bg-rose-50 cursor-pointer" 
                title="Hapus naskah ini"
              >
                🗑
              </button>
            </div>
          </div>

          <div class="p-3.5 bg-[var(--paper-deep)] rounded-lg text-xs font-['Source_Serif_4',serif] italic text-[var(--ink-soft)] leading-relaxed">
            "${k.description || (k.content ? k.content.slice(0, 160) + '...' : 'Tidak ada sinopsis singkat.')}"
          </div>
        </div>
      `).join('');
    }

    // 8. Render Karya Catalog Table
    function renderKaryaCatalog() {
      const tbody = document.getElementById('karya-table-body');
      if (!tbody) return;

      const searchVal = ((document.getElementById('search-karya') as HTMLInputElement)?.value || '').toLowerCase();
      const filterCat = (document.getElementById('filter-karya-kategori') as HTMLSelectElement)?.value || 'all';
      const filterStat = (document.getElementById('filter-karya-status') as HTMLSelectElement)?.value || 'all';

      let list = [...fullDb.karya];
      if (searchVal) {
        list = list.filter(k => k.title.toLowerCase().includes(searchVal) || k.author.toLowerCase().includes(searchVal));
      }
      if (filterCat !== 'all') {
        list = list.filter(k => k.category === filterCat);
      }
      if (filterStat !== 'all') {
        list = list.filter(k => k.status === filterStat);
      }

      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center mono text-xs text-[var(--ink-faint)] italic">Tidak ada karya yang sesuai dengan filter.</td></tr>';
        return;
      }

      tbody.innerHTML = list.map(k => {
        let statusBadge = '';
        if (k.status === 'published') {
          statusBadge = '<span class="px-2 py-0.5 rounded-full text-[0.62rem] mono font-bold bg-emerald-100 text-emerald-800">Tayang</span>';
        } else if (k.status === 'menunggu_kurasi') {
          statusBadge = '<span class="px-2 py-0.5 rounded-full text-[0.62rem] mono font-bold bg-rose-100 text-rose-800">Kurasi</span>';
        } else {
          statusBadge = '<span class="px-2 py-0.5 rounded-full text-[0.62rem] mono font-bold bg-amber-100 text-amber-800">Draf</span>';
        }

        const formattedImgUrl = k.cover_image_url ? formatDriveImageUrl(k.cover_image_url) : '';
        const coverImg = formattedImgUrl 
          ? `<img src="${formattedImgUrl}" class="w-9 h-9 rounded object-cover border border-[var(--rule)]" alt="Sampul" />`
          : `<div class="w-9 h-9 rounded bg-[var(--paper-deep)] border border-[var(--rule)] flex items-center justify-center mono text-[0.55rem] text-[var(--ink-faint)]">N/A</div>`;

        return `
          <tr class="hover:bg-[var(--paper-deep)]/40 transition-colors">
            <td class="px-4 py-3">${coverImg}</td>
            <td class="px-4 py-3">
              <a href="${basePath}/karya/${k.slug}" target="_blank" class="font-['Fraunces',serif] font-bold text-xs text-[var(--ink)] hover:text-[var(--crimson)] no-underline block max-w-xs truncate">
                ${k.title}
              </a>
              <span class="mono text-[0.62rem] text-[var(--ink-faint)] truncate block">${k.slug}</span>
            </td>
            <td class="px-4 py-3">
              <span class="font-semibold text-xs text-[var(--ink)] block">${k.author}</span>
              <span class="mono text-[0.62rem] text-[var(--ink-faint)]">${k.author_grade || '-'}</span>
            </td>
            <td class="px-4 py-3">
              <span class="mono text-[0.65rem] px-2 py-0.5 rounded border border-[var(--rule)] text-[var(--ink-soft)] uppercase">
                ${k.category_label || k.category}
              </span>
            </td>
            <td class="px-4 py-3 mono text-xs font-semibold text-[var(--ink)]">
              👁️ ${(k.views || 0).toLocaleString('id-ID')}
            </td>
            <td class="px-4 py-3">${statusBadge}</td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <div class="inline-flex items-center gap-1.5">
                <a href="${basePath}/karya/${k.slug}" target="_blank" title="Lihat di Web" class="p-1 text-[var(--ink-soft)] hover:text-[var(--crimson)]">
                  👁️
                </a>
                <button type="button" onclick="editKaryaBySlug('${k.slug}')" title="Sunting Naskah" class="p-1 text-[var(--ink-soft)] hover:text-[var(--crimson)] cursor-pointer">
                  ✎
                </button>
                <button type="button" onclick="quickToggleStatus('${k.slug || k.id}', '${k.status}')" title="Ubah Status" class="p-1 text-[var(--gold)] hover:underline cursor-pointer">
                  ⇄
                </button>
                <button type="button" onclick="quickDelete('${k.slug || k.id}', '${k.title}')" title="Hapus Permanen" class="p-1 text-rose-700 hover:text-rose-900 cursor-pointer">
                  🗑
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    // 9. Render Komentar List
    function renderKomentarList() {
      const tbody = document.getElementById('komentar-table-body');
      if (!tbody) return;

      if (fullDb.komentar.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center mono text-xs text-[var(--ink-faint)] italic">Belum ada catatan pembaca.</td></tr>';
        return;
      }

      tbody.innerHTML = fullDb.komentar.map(c => `
        <tr class="hover:bg-[var(--paper-deep)]/40 transition-colors">
          <td class="px-4 py-3 font-semibold text-xs text-[var(--ink)]">${c.nama}</td>
          <td class="px-4 py-3">
            <span class="mono text-[0.65rem] px-2 py-0.5 rounded bg-[var(--paper-deep)] border border-[var(--rule)]">${c.peran || 'Pembaca'}</span>
          </td>
          <td class="px-4 py-3 mono text-xs text-[var(--crimson)]">${c.karya_id}</td>
          <td class="px-4 py-3 font-['Source_Serif_4',serif] italic text-xs max-w-sm">${c.pesan}</td>
          <td class="px-4 py-3 mono text-[0.65rem] text-[var(--ink-faint)] whitespace-nowrap">
            ${c.created_at ? new Date(c.created_at).toLocaleDateString('id-ID') : '-'}
          </td>
          <td class="px-4 py-3 text-right">
            <button type="button" onclick="hapusKomentarItem('${c.id}')" class="p-1 text-rose-700 hover:underline cursor-pointer mono text-xs font-bold" title="Hapus Komentar">
              Hapus
            </button>
          </td>
        </tr>
      `).join('');
    }

    // 10. Render Quotes Grid
    function renderQuotesGrid() {
      const container = document.getElementById('quotes-grid-container');
      if (!container) return;

      if (fullDb.quotes.length === 0) {
        container.innerHTML = '<p class="col-span-full p-8 text-center mono text-xs text-[var(--ink-faint)] italic">Belum ada quotes sastra.</p>';
        return;
      }

      container.innerHTML = fullDb.quotes.map(q => `
        <div class="p-5 bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-xl shadow-xs flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <span class="mono text-[0.62rem] px-2 py-0.5 rounded-full border border-[var(--gold)] text-[var(--gold)] uppercase font-semibold">
              ${q.category || 'Quotes'}
            </span>
            <p class="font-['Fraunces',serif] italic text-sm text-[var(--ink)] m-0 leading-relaxed">
              "${q.quote}"
            </p>
          </div>
          <div class="pt-2 border-t border-[var(--rule)] flex items-center justify-between text-xs">
            <div>
              <p class="font-bold text-[var(--ink)] m-0 text-xs">${q.author}</p>
              <p class="mono text-[0.65rem] text-[var(--ink-faint)] m-0">${q.author_title || q.source || ''}</p>
            </div>
            <button type="button" onclick="hapusQuoteItem('${q.id}')" class="p-1 text-rose-700 hover:underline text-xs mono cursor-pointer" title="Hapus Quote">
              🗑
            </button>
          </div>
        </div>
      `).join('');
    }

    // 11. Render Penulis Santri List
    function renderPenulisList() {
      const tbody = document.getElementById('penulis-table-body');
      if (!tbody) return;

      if (fullDb.penulis.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center mono text-xs text-[var(--ink-faint)] italic">Belum ada akun santri terdaftar.</td></tr>';
        return;
      }

      tbody.innerHTML = fullDb.penulis.map(p => `
        <tr class="hover:bg-[var(--paper-deep)]/40 transition-colors">
          <td class="px-4 py-3 font-semibold text-xs text-[var(--ink)]">${p.nama}</td>
          <td class="px-4 py-3 mono text-xs">${p.kelas || '-'}</td>
          <td class="px-4 py-3 mono text-xs text-[var(--crimson)]">${p.email}</td>
          <td class="px-4 py-3 mono text-xs">
            ${p.kontak ? `<a href="https://wa.me/${p.kontak.replace(/[^0-9]/g, '')}" target="_blank" class="text-emerald-700 hover:underline">WA: ${p.kontak}</a>` : '-'}
          </td>
          <td class="px-4 py-3">
            <span class="mono text-[0.65rem] px-2 py-0.5 rounded bg-[var(--paper-deep)] border border-[var(--rule)] uppercase">Santri</span>
          </td>
        </tr>
      `).join('');
    }

    // 12. Quick Actions
    async function quickPublish(idOrSlug: string) {
      if (confirm('Terbitkan karya ini langsung ke publik?')) {
        await updateStatusKarya(idOrSlug, 'published');
        confetti({ particleCount: 35, spread: 60, origin: { y: 0.6 } });
        await loadAllAdminData();
      }
    }
    (window as any).quickPublish = quickPublish;

    async function quickDraft(idOrSlug: string) {
      await updateStatusKarya(idOrSlug, 'draft');
      await loadAllAdminData();
    }
    (window as any).quickDraft = quickDraft;

    async function quickToggleStatus(idOrSlug: string, currentStatus: string) {
      const nextStatus = currentStatus === 'published' ? 'draft' : 'published';
      const promptMsg = `Ubah status karya menjadi: "${nextStatus}"?`;
      if (confirm(promptMsg)) {
        await updateStatusKarya(idOrSlug, nextStatus as any);
        await loadAllAdminData();
      }
    }
    (window as any).quickToggleStatus = quickToggleStatus;

    async function quickDelete(idOrSlug: string, title: string) {
      if (confirm(`Hapus permanen karya "${title}" dari database cloud?`)) {
        await hapusKarya(idOrSlug);
        await loadAllAdminData();
      }
    }
    (window as any).quickDelete = quickDelete;

    async function hapusKomentarItem(id: string) {
      if (confirm('Hapus komentar ini?')) {
        await hapusKomentar(id);
        await loadAllAdminData();
      }
    }
    (window as any).hapusKomentarItem = hapusKomentarItem;

    async function hapusQuoteItem(id: string) {
      if (confirm('Hapus quote ini?')) {
        await hapusQuote(id);
        await loadAllAdminData();
      }
    }
    (window as any).hapusQuoteItem = hapusQuoteItem;

    // 13. Studio Editor Modal Handlers
    const modalEditor = document.getElementById('modal-editor-karya');
    const formKaryaId = document.getElementById('form-karya-id') as HTMLInputElement;
    const formKaryaSlug = document.getElementById('form-karya-slug') as HTMLInputElement;
    const formTitle = document.getElementById('form-title') as HTMLInputElement;
    const formCategory = document.getElementById('form-category') as HTMLSelectElement;
    const formAuthor = document.getElementById('form-author') as HTMLInputElement;
    const formGrade = document.getElementById('form-grade') as HTMLInputElement;
    const formStatus = document.getElementById('form-status') as HTMLSelectElement;
    const formDesc = document.getElementById('form-desc') as HTMLInputElement;
    const formCoverUrl = document.getElementById('form-cover-url') as HTMLInputElement;
    const formCoverFile = document.getElementById('form-cover-file') as HTMLInputElement;
    const coverPreviewBox = document.getElementById('cover-preview-box');
    const coverUploadStatus = document.getElementById('cover-upload-status');
    const formContent = document.getElementById('form-content') as HTMLTextAreaElement;
    const formWordCount = document.getElementById('form-word-count');
    const modalEditorTitle = document.getElementById('modal-editor-title');
    const btnSaveKarya = document.getElementById('btn-save-karya-submit') as HTMLButtonElement;

    // Category specific fields
    const fieldsIlmiah = document.getElementById('fields-ilmiah');
    const fieldsPuisi = document.getElementById('fields-puisi');
    const fieldsCerpen = document.getElementById('fields-cerpen');
    const fieldsDrama = document.getElementById('fields-drama');
    const formSupervisor = document.getElementById('form-supervisor') as HTMLInputElement;
    const formPdfUrl = document.getElementById('form-pdf-url') as HTMLInputElement;
    const formAbstract = document.getElementById('form-abstract') as HTMLTextAreaElement;
    const formAudioUrl = document.getElementById('form-audio-url') as HTMLInputElement;
    const formReadingTime = document.getElementById('form-reading-time') as HTMLInputElement;
    const formCharacters = document.getElementById('form-characters') as HTMLInputElement;
    const formStage = document.getElementById('form-stage') as HTMLInputElement;

    function onCategoryChange(cat: string) {
      [fieldsIlmiah, fieldsPuisi, fieldsCerpen, fieldsDrama].forEach(el => el?.classList.add('hidden'));
      if (cat === 'ilmiah') fieldsIlmiah?.classList.remove('hidden');
      else if (cat === 'puisi') fieldsPuisi?.classList.remove('hidden');
      else if (cat === 'cerpen') fieldsCerpen?.classList.remove('hidden');
      else if (cat === 'drama') fieldsDrama?.classList.remove('hidden');
    }
    (window as any).onCategoryChange = onCategoryChange;

    function openEditorModal(karya: KaryaInput | null) {
      if (!modalEditor) return;

      if (karya) {
        if (modalEditorTitle) modalEditorTitle.textContent = `Sunting Naskah: "${karya.title}"`;
        formKaryaId.value = karya.id || '';
        formKaryaSlug.value = karya.slug || '';
        formTitle.value = karya.title || '';
        formCategory.value = karya.category || 'puisi';
        formAuthor.value = karya.author || '';
        formGrade.value = karya.author_grade || '';
        formStatus.value = karya.status || 'published';
        formDesc.value = karya.description || '';
        formCoverUrl.value = karya.cover_image_url || '';
        formContent.value = karya.content || '';

        // Category specific
        if (formSupervisor) formSupervisor.value = karya.supervisor || '';
        if (formPdfUrl) formPdfUrl.value = karya.pdf_url || '';
        if (formAbstract) formAbstract.value = karya.abstract || '';
        if (formAudioUrl) formAudioUrl.value = karya.audio_url || '';
        if (formReadingTime) formReadingTime.value = (karya.reading_time || '').toString();
        if (formCharacters) formCharacters.value = Array.isArray(karya.characters) ? karya.characters.join(', ') : (karya.characters || '');
        if (formStage) formStage.value = karya.stage_setting || '';

        onCategoryChange(karya.category || 'puisi');
        updateCoverPreview(karya.cover_image_url);
      } else {
        if (modalEditorTitle) modalEditorTitle.textContent = 'Tulis Naskah Sastra Baru';
        formKaryaId.value = '';
        formKaryaSlug.value = '';
        formTitle.value = '';
        formCategory.value = 'puisi';
        formAuthor.value = currentAdminUser?.email === 'redaksi@yq.sch.id' ? 'Dewan Redaksi SMPI YQ' : (currentAdminUser?.email || '');
        formGrade.value = 'Dewan Redaksi';
        formStatus.value = 'published';
        formDesc.value = '';
        formCoverUrl.value = '';
        formContent.value = '';

        if (formSupervisor) formSupervisor.value = '';
        if (formPdfUrl) formPdfUrl.value = '';
        if (formAbstract) formAbstract.value = '';
        if (formAudioUrl) formAudioUrl.value = '';
        if (formReadingTime) formReadingTime.value = '';
        if (formCharacters) formCharacters.value = '';
        if (formStage) formStage.value = '';

        onCategoryChange('puisi');
        updateCoverPreview('');
      }

      updateWordCount();
      modalEditor.classList.remove('hidden');
      modalEditor.classList.add('flex');
    }
    (window as any).openEditorModal = openEditorModal;

    function closeEditorModal() {
      if (!modalEditor) return;
      modalEditor.classList.add('hidden');
      modalEditor.classList.remove('flex');
    }
    (window as any).closeEditorModal = closeEditorModal;

    function editKaryaBySlug(slug: string) {
      const found = fullDb.karya.find(k => k.slug === slug);
      if (found) {
        openEditorModal(found);
      }
    }
    (window as any).editKaryaBySlug = editKaryaBySlug;

    // Word count update
    function updateWordCount() {
      if (!formContent || !formWordCount) return;
      const words = formContent.value.trim().split(/\s+/).filter(Boolean).length;
      formWordCount.textContent = `${words} kata`;
    }
    formContent?.addEventListener('input', updateWordCount);

    // Cover image preview update
    function updateCoverPreview(url?: string) {
      if (!coverPreviewBox) return;
      if (url) {
        const directUrl = formatDriveImageUrl(url);
        coverPreviewBox.innerHTML = `<img src="${directUrl}" class="w-full h-full object-cover" alt="Sampul" />`;
      } else {
        coverPreviewBox.innerHTML = '<span class="mono text-[0.6rem] text-[var(--ink-faint)]">Foto</span>';
      }
    }
    formCoverUrl?.addEventListener('input', () => updateCoverPreview(formCoverUrl.value));

    // Upload Cover Photo to Google Drive Storage
    formCoverFile?.addEventListener('change', async () => {
      if (!formCoverFile.files || !formCoverFile.files[0]) return;
      const file = formCoverFile.files[0];
      if (coverUploadStatus) {
        coverUploadStatus.textContent = 'Mengunggah ke Google Drive Storage...';
        coverUploadStatus.className = 'mono text-[0.65rem] text-[var(--gold)] block';
      }

      try {
        const publicUrl = await uploadFotoKarya(file);
        formCoverUrl.value = publicUrl;
        updateCoverPreview(publicUrl);
        if (coverUploadStatus) {
          coverUploadStatus.textContent = '✓ Foto berhasil diunggah ke Google Drive!';
          coverUploadStatus.className = 'mono text-[0.65rem] text-emerald-700 block';
        }
      } catch (err: any) {
        if (coverUploadStatus) {
          coverUploadStatus.textContent = 'Gagal upload: ' + (err.message || 'Error');
          coverUploadStatus.className = 'mono text-[0.65rem] text-rose-700 block';
        }
      }
    });

    // Save Karya Submit
    document.getElementById('admin-karya-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!formTitle.value || !formAuthor.value || !formContent.value) {
        alert('Harap lengkapi Judul, Penulis, dan Isi Naskah.');
        return;
      }

      btnSaveKarya.disabled = true;
      btnSaveKarya.innerHTML = '<span>Menyimpan ke Cloud DB...</span>';

      const payload: KaryaInput = {
        id: formKaryaId.value || undefined,
        slug: formKaryaSlug.value || undefined,
        title: formTitle.value.trim(),
        category: formCategory.value,
        category_label: formCategory.options[formCategory.selectedIndex]?.text || 'Sastra',
        author: formAuthor.value.trim(),
        author_grade: formGrade.value.trim(),
        status: formStatus.value as any,
        description: formDesc.value.trim(),
        cover_image_url: formCoverUrl.value.trim() || undefined,
        content: formContent.value.trim(),
        supervisor: formSupervisor?.value.trim() || undefined,
        pdf_url: formPdfUrl?.value.trim() || undefined,
        abstract: formAbstract?.value.trim() || undefined,
        audio_url: formAudioUrl?.value.trim() || undefined,
        reading_time: formReadingTime?.value ? parseInt(formReadingTime.value, 10) : undefined,
        characters: formCharacters?.value.trim() ? formCharacters.value.split(',').map(s => s.trim()).filter(Boolean) : undefined,
        stage_setting: formStage?.value.trim() || undefined,
      };

      try {
        const res = await simpanKarya(payload);
        if (res.success) {
          confetti({ particleCount: 30, spread: 60, origin: { y: 0.6 } });
          closeEditorModal();
          await loadAllAdminData();
          if (formStatus.value === 'published') {
            switchAdminSection('karya');
          } else if (formStatus.value === 'menunggu_kurasi') {
            switchAdminSection('kurasi');
          }
        }
      } catch (err: any) {
        alert('Gagal menyimpan: ' + (err.message || 'Terjadi kesalahan sistem'));
      } finally {
        btnSaveKarya.disabled = false;
        btnSaveKarya.innerHTML = '<span>Simpan ke Cloud Database ⚡</span>';
      }
    });

    // Download as Markdown
    document.getElementById('btn-download-md')?.addEventListener('click', () => {
      const slug = formTitle.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'naskah';
      const md = `---
title: "${formTitle.value.replace(/"/g, '\\"')}"
description: "${formDesc.value.replace(/"/g, '\\"')}"
author: "${formAuthor.value.replace(/"/g, '\\"')}"
authorGrade: "${formGrade.value.replace(/"/g, '\\"')}"
category: "${formCategory.value}"
categoryLabel: "${formCategory.options[formCategory.selectedIndex]?.text || 'Sastra'}"
publishDate: ${new Date().toISOString().split('T')[0]}
${formCoverUrl.value ? `coverImage: "${formCoverUrl.value}"\n` : ''}---

${formContent.value}
`;
      const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${slug}.md`;
      a.click();
    });

    // 14. Quotes Modal
    const modalQuote = document.getElementById('modal-quote-form');
    function openQuoteModal() {
      modalQuote?.classList.remove('hidden');
      modalQuote?.classList.add('flex');
    }
    (window as any).openQuoteModal = openQuoteModal;

    function closeQuoteModal() {
      modalQuote?.classList.add('hidden');
      modalQuote?.classList.remove('flex');
    }
    (window as any).closeQuoteModal = closeQuoteModal;

    document.getElementById('quote-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const quoteText = (document.getElementById('quote-text') as HTMLTextAreaElement).value.trim();
      const quoteAuthor = (document.getElementById('quote-author') as HTMLInputElement).value.trim();
      const quoteTitle = (document.getElementById('quote-title') as HTMLInputElement).value.trim();
      const quoteCat = (document.getElementById('quote-cat') as HTMLSelectElement).value;

      if (!quoteText || !quoteAuthor) return;

      await simpanQuote({
        quote: quoteText,
        author: quoteAuthor,
        author_title: quoteTitle,
        category: quoteCat
      });

      closeQuoteModal();
      await loadAllAdminData();
    });

    // 15. Pengaturan Redaksi & Portal
    async function loadPengaturanData() {
      try {
        const settings = await getPengaturan();
        if (settings) {
          const namaEl = document.getElementById('setting-nama-portal') as HTMLInputElement;
          const edisiEl = document.getElementById('setting-edisi') as HTMLInputElement;
          const statusEl = document.getElementById('setting-status-penerimaan') as HTMLSelectElement;
          const waEl = document.getElementById('setting-whatsapp') as HTMLInputElement;
          const emailEl = document.getElementById('setting-email') as HTMLInputElement;
          const manifestoEl = document.getElementById('setting-manifesto') as HTMLTextAreaElement;

          if (namaEl && settings.nama_portal) namaEl.value = settings.nama_portal;
          if (edisiEl && settings.edisi) edisiEl.value = settings.edisi;
          if (statusEl && settings.status_penerimaan) statusEl.value = settings.status_penerimaan;
          if (waEl && settings.whatsapp) waEl.value = settings.whatsapp;
          if (emailEl && settings.email) emailEl.value = settings.email;
          if (manifestoEl && settings.manifesto) manifestoEl.value = settings.manifesto;
        }
      } catch (err) {
        console.warn('Gagal memuat pengaturan:', err);
      }
    }
    (window as any).loadPengaturanData = loadPengaturanData;

    document.getElementById('form-pengaturan')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const statusSpan = document.getElementById('setting-save-status');
      const btn = document.getElementById('btn-save-pengaturan') as HTMLButtonElement;
      if (btn) btn.disabled = true;
      if (statusSpan) {
        statusSpan.textContent = 'Menyimpan ke Google Sheets...';
        statusSpan.className = 'mono text-xs text-[var(--gold)]';
      }

      const payload = {
        nama_portal: (document.getElementById('setting-nama-portal') as HTMLInputElement)?.value || '',
        edisi: (document.getElementById('setting-edisi') as HTMLInputElement)?.value || '',
        status_penerimaan: (document.getElementById('setting-status-penerimaan') as HTMLSelectElement)?.value || 'buka',
        whatsapp: (document.getElementById('setting-whatsapp') as HTMLInputElement)?.value || '',
        email: (document.getElementById('setting-email') as HTMLInputElement)?.value || '',
        manifesto: (document.getElementById('setting-manifesto') as HTMLTextAreaElement)?.value || '',
      };

      try {
        await simpanPengaturan(payload);
        if (statusSpan) {
          statusSpan.textContent = '✓ Pengaturan berhasil disimpan!';
          statusSpan.className = 'mono text-xs text-emerald-700 font-bold';
          setTimeout(() => { if (statusSpan) statusSpan.textContent = ''; }, 3000);
        }
        confetti({ particleCount: 30, spread: 60, origin: { y: 0.8 } });
      } catch (err: any) {
        if (statusSpan) {
          statusSpan.textContent = 'Gagal menyimpan: ' + (err.message || 'Error');
          statusSpan.className = 'mono text-xs text-rose-700';
        }
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  </script>
</Layout>
