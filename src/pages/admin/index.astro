    const formPdfUrl = document.getElementById('form-pdf-url') as HTMLInputElement;
    const formAbstract = document.getElementById('form-abstract') as HTMLTextAreaElement;
    const formAudioUrl = document.getElementById('form-audio-url') as HTMLInputElement;
    const formReadingTime = document.getElementById('form-reading-time') as HTMLInputElement;
    const formCharacters = document.getElementById('form-characters') as HTMLInputElement;
    const formStage = document.getElementById('form-stage') as HTMLInputElement;

    function onCategoryChange(cat: string) {
      [fieldsIlmiah, fieldsPuisi, fieldsCerpen, fieldsDrama].forEach(el => el?.classList.add('hidden'));
      if (cat === 'ilmiah') fieldsIlmiah?.classList.remove('hidden');
      else if (cat === 'puisi') fieldsPuisi?.classList.remove('hidden');
      else if (cat === 'cerpen') fieldsCerpen?.classList.remove('hidden');
      else if (cat === 'drama') fieldsDrama?.classList.remove('hidden');
    }
    (window as any).onCategoryChange = onCategoryChange;

    function slugify(text: string) {
      return text.toLowerCase()
        .replace(/[^\w\s-]/g, '')
        .trim()
        .replace(/[\s_-]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    formTitle?.addEventListener('input', () => {
      if (!formKaryaId.value) {
        const generated = slugify(formTitle.value);
        formKaryaSlug.value = generated;
        if (previewSlugText) previewSlugText.textContent = generated || 'draf-baru';
      }
    });

    function promptEditSlug() {
      const current = formKaryaSlug.value || slugify(formTitle.value) || 'naskah';
      const custom = prompt('Tentukan tautan permalink (slug) naskah:', current);
      if (custom !== null) {
        const cleaned = slugify(custom);
        if (cleaned) {
          formKaryaSlug.value = cleaned;
          if (previewSlugText) previewSlugText.textContent = cleaned;
        }
      }
    }
    (window as any).promptEditSlug = promptEditSlug;

    function insertFormat(prefix: string, suffix: string = '') {
      if (!formContent) return;
      const start = formContent.selectionStart;
      const end = formContent.selectionEnd;
      const text = formContent.value;
      const selected = text.substring(start, end);
      const replacement = prefix + (selected || 'teks') + suffix;
      formContent.setRangeText(replacement, start, end, 'select');
      formContent.focus();
      updateWordCount();
    }
    (window as any).insertFormat = insertFormat;

    function triggerKaryaSubmit() {
      const form = document.getElementById('admin-karya-form') as HTMLFormElement;
      if (form) {
        if (form.reportValidity()) {
          form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
        }
      }
    }
    (window as any).triggerKaryaSubmit = triggerKaryaSubmit;

    async function deleteCurrentKarya() {
      const idOrSlug = formKaryaSlug.value || formKaryaId.value;
      const title = formTitle.value || 'Naskah ini';
      if (!idOrSlug) return;
      if (confirm(`Hapus permanen naskah "${title}" dari database cloud?`)) {
        await hapusKarya(idOrSlug);
        await loadAllAdminData();
        switchAdminSection('karya');
      }
    }
    (window as any).deleteCurrentKarya = deleteCurrentKarya;

    function openEditorModal(karya: KaryaInput | null) {
      if (karya) {
        if (editorDocTitle) editorDocTitle.textContent = `Sunting Naskah: "${karya.title}"`;
        formKaryaId.value = karya.id || '';
        formKaryaSlug.value = karya.slug || '';
        formTitle.value = karya.title || '';
        formCategory.value = karya.category || 'puisi';
        formAuthor.value = karya.author || '';
        formGrade.value = karya.author_grade || '';
        formStatus.value = karya.status || 'published';
        formDesc.value = karya.description || '';
        formCoverUrl.value = karya.cover_image_url || '';
        formContent.value = karya.content || '';

        if (previewSlugText) previewSlugText.textContent = karya.slug || 'naskah';
        if (btnPreviewKarya) {
          btnPreviewKarya.href = `${basePath}/karya/${karya.slug}`;
          btnPreviewKarya.classList.remove('hidden');
          btnPreviewKarya.classList.add('inline-flex');
        }
        if (editorSaveIndicator) {
          editorSaveIndicator.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span><span>Tersimpan di Cloud Database</span>';
        }
        if (btnDeleteCurrent) {
          btnDeleteCurrent.classList.remove('hidden');
        }
        if (btnSaveKarya) {
          btnSaveKarya.innerHTML = '<span>Perbarui Naskah ⚡</span>';
        }
        if (btnSaveKaryaSecondary) {
          btnSaveKaryaSecondary.innerHTML = '<span>Perbarui Naskah ⚡</span>';
        }

        // Category specific
        if (formSupervisor) formSupervisor.value = karya.supervisor || '';
        if (formPdfUrl) formPdfUrl.value = karya.pdf_url || '';
        if (formAbstract) formAbstract.value = karya.abstract || '';
        if (formAudioUrl) formAudioUrl.value = karya.audio_url || '';
        if (formReadingTime) formReadingTime.value = (karya.reading_time || '').toString();
        if (formCharacters) formCharacters.value = Array.isArray(karya.characters) ? karya.characters.join(', ') : (karya.characters || '');
        if (formStage) formStage.value = karya.stage_setting || '';

        onCategoryChange(karya.category || 'puisi');
        updateCoverPreview(karya.cover_image_url);
      } else {
        if (editorDocTitle) editorDocTitle.textContent = 'Tulis Naskah Sastra Baru';
