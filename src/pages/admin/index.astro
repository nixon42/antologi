    // Santri Modal Handlers
    function openSantriModal(id: string | null) {
      const modal = document.getElementById('modal-santri-form');
      const titleEl = document.getElementById('modal-santri-title');
      const formId = document.getElementById('santri-form-id') as HTMLInputElement;
      const formIsNew = document.getElementById('santri-form-is-new') as HTMLInputElement;
      const formNama = document.getElementById('santri-form-nama') as HTMLInputElement;
      const formKelas = document.getElementById('santri-form-kelas') as HTMLInputElement;
      const formKontak = document.getElementById('santri-form-kontak') as HTMLInputElement;
      const formEmail = document.getElementById('santri-form-email') as HTMLInputElement;
      const formPass = document.getElementById('santri-form-password') as HTMLInputElement;
      const passLabel = document.getElementById('santri-pass-label');
      const passHint = document.getElementById('santri-pass-hint');

      if (!modal) return;

      if (id) {
        const santri = (fullDb.penulis || []).find(p => p.id === id || p.email === id);
        if (titleEl) titleEl.textContent = 'Edit Profil Santri';
        if (formId) formId.value = santri?.id || id;
        if (formIsNew) formIsNew.value = 'false';
        if (formNama) formNama.value = santri?.nama || '';
        if (formKelas) formKelas.value = santri?.kelas || '';
        if (formKontak) formKontak.value = santri?.kontak || '';
        if (formEmail) {
          formEmail.value = santri?.email || '';
          formEmail.readOnly = true;
          formEmail.classList.add('opacity-70');
        }
        if (formPass) {
          formPass.value = '';
          formPass.required = false;
        }
        if (passLabel) passLabel.textContent = 'Ubah Kata Sandi (Opsional)';
        if (passHint) passHint.textContent = 'Kosongkan jika tidak ingin mengubah kata sandi santri.';
      } else {
        if (titleEl) titleEl.textContent = 'Tambah Akun Santri Baru';
        if (formId) formId.value = '';
        if (formIsNew) formIsNew.value = 'true';
        if (formNama) formNama.value = '';
        if (formKelas) formKelas.value = 'VII';
        if (formKontak) formKontak.value = '';
        if (formEmail) {
          formEmail.value = '';
          formEmail.readOnly = false;
          formEmail.classList.remove('opacity-70');
        }
        if (formPass) {
          formPass.value = generateRandomPassword('yq');
          formPass.required = true;
        }
        if (passLabel) passLabel.textContent = 'Kata Sandi Awal *';
        if (passHint) passHint.textContent = 'Sandi ini akan digunakan santri saat login di portal kirim naskah.';
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    (window as any).openSantriModal = openSantriModal;

    function closeSantriModal() {
      const modal = document.getElementById('modal-santri-form');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }
