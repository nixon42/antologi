          <span class="mono text-[0.65rem] uppercase text-[var(--paper)]/80 tracking-widest block">Keamanan Redaksi</span>
          <h3 class="font-['Fraunces',serif] font-bold text-base text-[var(--paper)] m-0">Ganti Kata Sandi Saya</h3>
        </div>
