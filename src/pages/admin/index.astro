        </div>

        <!-- Isi Naskah Lengkap -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="form-content" class="block mono text-[0.7rem] uppercase tracking-wider text-[var(--ink-soft)] font-semibold">
              Isi Naskah Karya Sastra Lengkap *
            </label>
            <span id="form-word-count" class="mono text-[0.65rem] text-[var(--ink-faint)]">0 kata</span>
          </div>
          <textarea 
            id="form-content" 
            required 
            rows="10" 
            placeholder="Tuliskan naskah karya secara lengkap di sini. Mendukung pemisahan bait dan paragraf sastra..." 
            class="w-full p-4 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-xl text-sm font-['Source_Serif_4',serif] text-[var(--ink)] outline-none focus:border-[var(--crimson)] leading-relaxed"
          ></textarea>
        </div>

        <!-- Submit Footer -->
        <div class="pt-3 border-t border-[var(--rule)] flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center gap-2">
            <button 
              type="button" 
              id="btn-download-md" 
              class="px-3 py-2 rounded-lg border border-[var(--rule-strong)] bg-[var(--paper)] hover:bg-[var(--paper-deep)] text-xs mono text-[var(--ink)] cursor-pointer"
            >
              Unduh .MD
            </button>
            <button 
              type="button" 
              onclick="closeEditorModal()" 
              class="px-3 py-2 rounded-lg border border-transparent text-xs mono text-[var(--ink-faint)] hover:text-[var(--ink)] cursor-pointer"
            >
              Batal
            </button>
          </div>

          <button 
            type="submit" 
            id="btn-save-karya-submit" 
            class="px-5 py-2.5 rounded-xl bg-[var(--crimson)] hover:bg-[#63241e] text-[var(--paper)] font-['Fraunces',serif] font-bold text-xs shadow-md transition-all cursor-pointer flex items-center gap-2"
