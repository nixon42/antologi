---
import Layout from '../../layouts/Layout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout 
  title="Masuk Studio Redaksi — Ruang Sastra SMPI YQ"
  description="Halaman autentikasi pengurus, dewan redaksi, dan pembina literasi SMPI Yambu'ul Qur'an."
>
  <div class="wrap py-12 md:py-20 flex items-center justify-center min-h-[70vh]">
    <div class="w-full max-w-md bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-sm p-7 sm:p-9 shadow-lg relative">
      
      <!-- Monogram Header -->
      <div class="text-center mb-7">
        <div class="w-12 h-12 rounded-full border-[1.5px] border-[var(--crimson)] flex items-center justify-center font-['Fraunces',serif] font-bold text-base text-[var(--crimson)] mx-auto mb-3 shadow-inner">
          YQ
        </div>
        <span class="mono text-xs text-[var(--crimson)] uppercase tracking-wider block mb-1">Akses Dewan Redaksi</span>
        <h1 class="font-['Fraunces',serif] font-semibold text-2xl sm:text-3xl text-[var(--ink)] m-0">
          Studio Redaksi
        </h1>
        <p class="font-['Source_Serif_4',serif] italic text-xs sm:text-sm text-[var(--ink-soft)] mt-1.5 leading-relaxed">
          Silakan masuk untuk mengurasi kiriman naskah santri, menyunting naskah, dan mengelola arsip literatur.
        </p>
      </div>

      <!-- Active Session Banner (if already logged in) -->
      <div id="already-logged-in-banner" class="hidden mb-5 p-3.5 bg-[var(--paper-deep)] border border-[var(--rule-strong)] rounded text-xs space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="mono text-[0.72rem] text-[var(--ink)] font-semibold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Sesi Redaksi Aktif:
          </span>
          <span id="banner-user-email" class="mono text-[0.72rem] text-[var(--crimson)] font-bold"></span>
        </div>
        <p class="text-[0.75rem] text-[var(--ink-soft)] font-['Source_Serif_4',serif] italic m-0">
          Anda saat ini masih dalam keadaan masuk. Anda dapat langsung membuka Studio Redaksi atau keluar dari sesi ini.
        </p>
        <div class="pt-1 flex items-center gap-3">
          <a href={`${basePath}/admin`} class="btn-literary btn-literary-solid !py-1 !px-3.5 !text-xs no-underline">
            Ke Studio Redaksi →
          </a>
          <button id="btn-banner-logout" type="button" class="mono text-xs text-[var(--crimson)] hover:underline cursor-pointer font-semibold">
            Keluar dari Sesi
          </button>
        </div>
      </div>

      <!-- Alert Box -->
      <div id="login-alert" class="hidden mb-5 p-3 rounded text-xs mono border transition-all"></div>

      <!-- Login Form -->
      <form id="login-form" class="space-y-4">
        <div>
          <label for="login-email" class="block mono text-xs uppercase tracking-wider text-[var(--ink-soft)] mb-1 font-medium">
            Alamat Email Redaksi *
          </label>
          <input 
            type="email" 
            id="login-email" 
            required 
            placeholder="redaksi@yq.sch.id" 
            class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif]"
            autocomplete="email"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="login-password" class="block mono text-xs uppercase tracking-wider text-[var(--ink-soft)] font-medium">
              Kata Sandi *
            </label>
            <button 
              type="button" 
              id="toggle-pwd-btn" 
              class="mono text-[0.68rem] text-[var(--ink-faint)] hover:text-[var(--crimson)] cursor-pointer"
            >
              Lihat Sandi
            </button>
          </div>
          <input 
            type="password" 
            id="login-password" 
            required 
            placeholder="••••••••" 
            class="w-full px-3.5 py-2.5 bg-[var(--paper)] border border-[var(--rule-strong)] rounded text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif]"
            autocomplete="current-password"
          />
        </div>

        <button 
          type="submit" 
          id="btn-submit-login" 
          class="btn-literary btn-literary-solid !w-full !py-2.5 !text-sm cursor-pointer mt-2"
        >
          Masuk ke Studio Redaksi →
        </button>
      </form>

      <!-- Literary Divider -->
      <div class="my-6 border-t border-[var(--rule)] relative text-center">
        <span class="bg-[var(--paper-card)] px-3 text-[var(--gold)] text-xs relative -top-2.5 font-serif">❧</span>
      </div>

      <!-- Security & Colophon Note (No password exposed) -->
      <div class="p-3.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[0.75rem] text-[var(--ink-soft)] text-center leading-relaxed">
        <p class="m-0 text-[var(--ink-faint)] font-['Source_Serif_4',serif] italic">
          Khusus Dewan Redaksi dan Pembina Literasi SMPI Yambu'ul Qur'an. Hubungi administrator madrasah jika Anda memerlukan akses atau lupa kata sandi.
        </p>
      </div>

      <!-- Back Link -->
      <div class="mt-6 text-center">
        <a href={`${basePath}/`} class="mono text-xs text-[var(--ink-faint)] hover:text-[var(--crimson)] no-underline">
          ← Kembali ke Halaman Utama Ruang Sastra
        </a>
      </div>

    </div>
  </div>

  <script>
    import { loginAdmin, getAdminUser, logoutAdmin } from '../../lib/supabase';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const emailInput = document.getElementById('login-email') as HTMLInputElement;
    const pwdInput = document.getElementById('login-password') as HTMLInputElement;
    const togglePwdBtn = document.getElementById('toggle-pwd-btn');
    const submitBtn = document.getElementById('btn-submit-login') as HTMLButtonElement;
    const alertBox = document.getElementById('login-alert');
    const alreadyLoggedInBanner = document.getElementById('already-logged-in-banner');
    const bannerUserEmail = document.getElementById('banner-user-email');
    const bannerLogoutBtn = document.getElementById('btn-banner-logout');

    const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

    // Check URL parameters for explicit logout
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('logout')) {
      logoutAdmin().then(() => {
        showAlert('Anda telah berhasil keluar dari sesi Studio Redaksi.', 'info');
        if (window.history && window.history.replaceState) {
          window.history.replaceState({}, document.title, window.location.pathname);
        }
      });
    } else {
      // Check if already authenticated to show active session banner
      getAdminUser().then(user => {
        if (user && alreadyLoggedInBanner && bannerUserEmail) {
          bannerUserEmail.textContent = user.email;
          alreadyLoggedInBanner.classList.remove('hidden');
        }
      });
    }

    // Logout button from banner
    bannerLogoutBtn?.addEventListener('click', async () => {
      if (bannerLogoutBtn) bannerLogoutBtn.textContent = 'Mengeluarkan...';
      await logoutAdmin();
      alreadyLoggedInBanner?.classList.add('hidden');
      showAlert('Anda telah berhasil keluar dari akun redaksi.', 'info');
    });

    // Toggle Password Visibility
    togglePwdBtn?.addEventListener('click', () => {
      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        togglePwdBtn.textContent = 'Sembunyikan';
      } else {
        pwdInput.type = 'password';
        togglePwdBtn.textContent = 'Lihat Sandi';
      }
    });

    function showAlert(msg: string, type: 'error' | 'success' | 'info') {
      if (!alertBox) return;
      alertBox.textContent = msg;
      alertBox.classList.remove('hidden', 'bg-rose-50', 'text-rose-900', 'border-rose-600', 'bg-emerald-50', 'text-emerald-900', 'border-emerald-600', 'bg-amber-50', 'text-amber-900', 'border-amber-600');
      
      if (type === 'error') {
        alertBox.classList.add('bg-rose-50', 'text-rose-900', 'border-rose-600');
      } else if (type === 'success') {
        alertBox.classList.add('bg-emerald-50', 'text-emerald-900', 'border-emerald-600');
      } else {
        alertBox.classList.add('bg-amber-50', 'text-amber-900', 'border-amber-600');
      }
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      const password = pwdInput.value;

      if (!email || !password) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Memeriksa Kredensial...';

      try {
        const res = await loginAdmin(email, password);
        if (res.success) {
          showAlert('Kredensial valid! Mengalihkan ke Studio Redaksi...', 'success');
          setTimeout(() => {
            window.location.href = `${basePath}/admin`;
          }, 600);
        } else {
          showAlert(res.message, 'error');
        }
      } catch (err: any) {
        showAlert('Terjadi kesalahan: ' + (err.message || 'Gagal masuk'), 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Masuk ke Studio Redaksi →';
      }
    });
  </script>
</Layout>
