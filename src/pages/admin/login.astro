---
import Layout from '../../layouts/Layout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout 
  title="Masuk Studio Redaksi — Ruang Sastra SMPI YQ"
  description="Portal masuk dewan redaksi, pembina literasi, dan pengirim naskah SMPI Yambu'ul Qur'an."
>
  <div class="wrap py-12 md:py-20 flex items-center justify-center min-h-[75vh]">
    <div class="w-full max-w-md bg-[var(--paper-card)] border border-[var(--rule-strong)] rounded-2xl p-7 sm:p-9 shadow-xl relative transition-all">
      
      <!-- Brand & Monogram Header -->
      <div class="text-center mb-6">
        <div class="w-14 h-14 rounded-full border-2 border-[var(--crimson)] bg-[var(--paper)] flex items-center justify-center font-['Fraunces',serif] font-bold text-lg text-[var(--crimson)] mx-auto mb-3 shadow-inner">
          YQ
        </div>
        <span class="mono text-[0.68rem] text-[var(--gold)] uppercase tracking-widest font-semibold block mb-1">
          SMPI Yambu'ul Qur'an
        </span>
        <h1 class="font-['Fraunces',serif] font-bold text-2xl sm:text-3xl text-[var(--ink)] m-0 tracking-tight">
          Studio Redaksi
        </h1>
        <p class="font-['Source_Serif_4',serif] italic text-xs sm:text-sm text-[var(--ink-soft)] mt-1.5 leading-relaxed">
          Pusat kurasi naskah, penerbitan karya santri, dan manajemen literatur.
        </p>
      </div>

      <!-- Active Session Quick Resume Card (if already logged in) -->
      <div id="session-active-card" class="hidden mb-5 p-4 bg-[var(--paper-deep)] border border-[var(--rule-strong)] rounded-xl text-center space-y-3">
        <div class="flex items-center justify-center gap-2 mono text-xs text-emerald-800 font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Sesi Masuk Aktif:</span>
          <span id="session-user-email" class="text-[var(--crimson)] font-bold"></span>
        </div>
        <div class="flex items-center justify-center gap-3 pt-1">
          <a id="session-direct-btn" href={`${basePath}/admin`} class="btn-literary btn-literary-solid !py-2 !px-4 !text-xs no-underline">
            Buka Studio Redaksi →
          </a>
          <button id="btn-session-logout" type="button" class="mono text-xs text-[var(--ink-faint)] hover:text-rose-700 hover:underline cursor-pointer">
            Ganti Akun
          </button>
        </div>
      </div>

      <!-- Alert Box -->
      <div id="auth-alert" class="hidden mb-4 p-3.5 rounded-xl text-xs mono border transition-all text-center"></div>

      <!-- MAIN UNIFIED LOGIN FORM -->
      <form id="form-login" class="space-y-4">
        <div>
          <label for="login-username" class="block mono text-[0.72rem] uppercase tracking-wider text-[var(--ink-soft)] mb-1.5 font-semibold">
            Nama Pengguna atau Email *
          </label>
          <div class="relative">
            <input 
              type="text" 
              id="login-username" 
              required 
              placeholder="admin atau redaksi@yq.sch.id" 
              class="w-full px-4 py-3 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-xl text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] focus:ring-1 focus:ring-[var(--crimson)] font-['Source_Serif_4',serif] transition-all"
              autocomplete="username"
              autocapitalize="none"
              spellcheck="false"
            />
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="login-password" class="block mono text-[0.72rem] uppercase tracking-wider text-[var(--ink-soft)] font-semibold">
              Kata Sandi *
            </label>
            <button 
              type="button" 
              id="btn-toggle-eye" 
              class="mono text-[0.68rem] text-[var(--ink-faint)] hover:text-[var(--crimson)] cursor-pointer flex items-center gap-1"
            >
              <svg id="eye-icon" class="w-3.5 h-3.5" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
              <span id="eye-text">Lihat</span>
            </button>
          </div>
          <input 
            type="password" 
            id="login-password" 
            required 
            placeholder="••••••••" 
            class="w-full px-4 py-3 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-xl text-sm text-[var(--ink)] outline-none focus:border-[var(--crimson)] focus:ring-1 focus:ring-[var(--crimson)] font-['Source_Serif_4',serif] transition-all"
            autocomplete="current-password"
          />
        </div>

        <button 
          type="submit" 
          id="btn-login-submit" 
          class="w-full py-3.5 rounded-xl bg-[var(--crimson)] hover:bg-[#63241e] text-[var(--paper)] font-['Fraunces',serif] font-bold text-sm tracking-wide shadow-md transition-all cursor-pointer flex items-center justify-center gap-2 mt-2"
        >
          <span>Masuk ke Studio Redaksi →</span>
        </button>
      </form>

      <!-- Literary Divider -->
      <div class="my-6 border-t border-[var(--rule)] relative text-center">
        <span class="bg-[var(--paper-card)] px-3 text-[var(--gold)] text-xs relative -top-2.5 font-serif">❧</span>
      </div>

      <!-- Secondary: Student Registration Expandable -->
      <div class="space-y-3">
        <div class="text-center">
          <button 
            type="button" 
            id="btn-toggle-daftar" 
            class="mono text-xs text-[var(--crimson)] hover:underline font-semibold cursor-pointer inline-flex items-center gap-1"
          >
            <span>Santri / Penulis ingin mendaftar akun baru?</span>
            <span id="daftar-arrow">↓</span>
          </button>
        </div>

        <!-- FORM DAFTAR SANTRI BARU (Collapsed by default) -->
        <form id="form-daftar-santri" class="hidden pt-2 space-y-3 border-t border-[var(--rule)]">
          <p class="mono text-[0.7rem] text-[var(--ink-soft)] text-center m-0 pb-1">
            Daftarkan akun santri agar nama &amp; kelas otomatis tercantum pada setiap naskah yang dikirim.
          </p>

          <div>
            <label for="daftar-nama" class="block mono text-[0.68rem] uppercase tracking-wider text-[var(--ink-soft)] mb-1">
              Nama Lengkap Santri *
            </label>
            <input 
              type="text" 
              id="daftar-nama" 
              placeholder="Nama lengkap santri atau nama pena" 
              class="w-full px-3 py-2 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-lg text-xs text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif]"
            />
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="daftar-kelas" class="block mono text-[0.68rem] uppercase tracking-wider text-[var(--ink-soft)] mb-1">
                Kelas / Angkatan *
              </label>
              <input 
                type="text" 
                id="daftar-kelas" 
                placeholder="Misal: IX-A" 
                class="w-full px-3 py-2 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-lg text-xs text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif]"
              />
            </div>
            <div>
              <label for="daftar-kontak" class="block mono text-[0.68rem] uppercase tracking-wider text-[var(--ink-soft)] mb-1">
                WhatsApp (Opsional)
              </label>
              <input 
                type="text" 
                id="daftar-kontak" 
                placeholder="0812xxxxxxxx" 
                class="w-full px-3 py-2 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-lg text-xs text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif]"
              />
            </div>
          </div>

          <div>
            <label for="daftar-email" class="block mono text-[0.68rem] uppercase tracking-wider text-[var(--ink-soft)] mb-1">
              Alamat Email *
            </label>
            <input 
              type="email" 
              id="daftar-email" 
              placeholder="santri@yq.sch.id" 
              class="w-full px-3 py-2 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-lg text-xs text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif]"
            />
          </div>

          <div>
            <label for="daftar-password" class="block mono text-[0.68rem] uppercase tracking-wider text-[var(--ink-soft)] mb-1">
              Buat Kata Sandi * (Min. 6 Karakter)
            </label>
            <input 
              type="password" 
              id="daftar-password" 
              minlength="6"
              placeholder="••••••••" 
              class="w-full px-3 py-2 bg-[var(--paper)] border border-[var(--rule-strong)] rounded-lg text-xs text-[var(--ink)] outline-none focus:border-[var(--crimson)] font-['Source_Serif_4',serif]"
            />
          </div>

          <button 
            type="submit" 
            id="btn-daftar-submit" 
            class="btn-literary btn-literary-solid !w-full !py-2.5 !text-xs cursor-pointer mt-1"
          >
            Daftarkan Akun Penulis →
          </button>
        </form>
      </div>

      <!-- Bottom Direct Links -->
      <div class="mt-6 pt-4 border-t border-[var(--rule)] flex items-center justify-between text-xs mono">
        <a href={`${basePath}/`} class="text-[var(--ink-faint)] hover:text-[var(--crimson)] no-underline flex items-center gap-1">
          ← Beranda
        </a>
        <a href={`${basePath}/kirim`} class="text-[var(--ink-faint)] hover:text-[var(--crimson)] no-underline">
          Kirim Naskah Langsung →
        </a>
      </div>

    </div>
  </div>

  <script>
    import { 
      loginAdmin, 
      getAdminUser, 
      logoutAdmin,
      loginPenulis,
      daftarPenulis,
      getPenulisUser,
      logoutPenulis 
    } from '../../lib/supabase';

    const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

    // DOM Elements
    const formLogin = document.getElementById('form-login') as HTMLFormElement;
    const usernameInput = document.getElementById('login-username') as HTMLInputElement;
    const passwordInput = document.getElementById('login-password') as HTMLInputElement;
    const btnLoginSubmit = document.getElementById('btn-login-submit') as HTMLButtonElement;
    const btnToggleEye = document.getElementById('btn-toggle-eye');
    const eyeText = document.getElementById('eye-text');
    const authAlert = document.getElementById('auth-alert');

    // Registration Elements
    const btnToggleDaftar = document.getElementById('btn-toggle-daftar');
    const formDaftarSantri = document.getElementById('form-daftar-santri') as HTMLFormElement;
    const daftarArrow = document.getElementById('daftar-arrow');
    const btnDaftarSubmit = document.getElementById('btn-daftar-submit') as HTMLButtonElement;

    // Session Elements
    const sessionCard = document.getElementById('session-active-card');
    const sessionUserEmail = document.getElementById('session-user-email');
    const sessionDirectBtn = document.getElementById('session-direct-btn') as HTMLAnchorElement;
    const btnSessionLogout = document.getElementById('btn-session-logout');

    // 1. Password Visibility Toggle
    btnToggleEye?.addEventListener('click', () => {
      if (!passwordInput) return;
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        if (eyeText) eyeText.textContent = 'Sembunyikan';
      } else {
        passwordInput.type = 'password';
        if (eyeText) eyeText.textContent = 'Lihat';
      }
    });

    // 2. Toggle Registration Accordion
    btnToggleDaftar?.addEventListener('click', () => {
      if (!formDaftarSantri) return;
      const isHidden = formDaftarSantri.classList.contains('hidden');
      if (isHidden) {
        formDaftarSantri.classList.remove('hidden');
        if (daftarArrow) daftarArrow.textContent = '↑';
      } else {
        formDaftarSantri.classList.add('hidden');
        if (daftarArrow) daftarArrow.textContent = '↓';
      }
    });

    // 3. Helper Alert
    function showAlert(message: string, type: 'error' | 'success' | 'info') {
      if (!authAlert) return;
      authAlert.textContent = message;
      authAlert.className = 'mb-4 p-3.5 rounded-xl text-xs mono border transition-all text-center';
      
      if (type === 'error') {
        authAlert.classList.add('bg-rose-50', 'text-rose-900', 'border-rose-300');
      } else if (type === 'success') {
        authAlert.classList.add('bg-emerald-50', 'text-emerald-900', 'border-emerald-300');
      } else {
        authAlert.classList.add('bg-amber-50', 'text-amber-900', 'border-amber-300');
      }
      authAlert.classList.remove('hidden');
    }

    // 4. Check Query Parameter (e.g. ?logout=1)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('logout')) {
      Promise.all([logoutAdmin(), logoutPenulis()]).then(() => {
        showAlert('Anda telah berhasil keluar dari sesi Studio Redaksi.', 'info');
        if (window.history && window.history.replaceState) {
          window.history.replaceState({}, document.title, window.location.pathname);
        }
      });
    }

    // 5. Check Existing Active Session
    async function checkCurrentSession() {
      const admin = await getAdminUser();
      if (admin && sessionCard && sessionUserEmail) {
        sessionUserEmail.textContent = admin.email;
        if (sessionDirectBtn) {
          sessionDirectBtn.href = `${basePath}/admin`;
          sessionDirectBtn.textContent = 'Buka Studio Redaksi →';
        }
        sessionCard.classList.remove('hidden');
        return;
      }

      const penulis = await getPenulisUser();
      if (penulis && sessionCard && sessionUserEmail) {
        sessionUserEmail.textContent = `${penulis.nama} (${penulis.kelas})`;
        if (sessionDirectBtn) {
          sessionDirectBtn.href = `${basePath}/kirim`;
          sessionDirectBtn.textContent = 'Buka Ruang Naskah →';
        }
        sessionCard.classList.remove('hidden');
      }
    }
    checkCurrentSession();

    // Session Logout
    btnSessionLogout?.addEventListener('click', async () => {
      await Promise.all([logoutAdmin(), logoutPenulis()]);
      sessionCard?.classList.add('hidden');
      showAlert('Sesi berhasil diakhiri. Silakan masukkan kredensial Anda.', 'info');
    });

    // 6. SUBMIT LOGIN HANDLER
    formLogin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const identifier = usernameInput.value.trim();
      const password = passwordInput.value;

      if (!identifier || !password) {
        showAlert('Harap isi nama pengguna / email dan kata sandi.', 'error');
        return;
      }

      btnLoginSubmit.disabled = true;
      btnLoginSubmit.innerHTML = `
        <svg class="w-4 h-4 animate-spin inline-block mr-1" width="16" height="16" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Memverifikasi kredensial...</span>
      `;

      try {
        // Coba Login Admin Redaksi terlebih dahulu
        const adminRes = await loginAdmin(identifier, password);
        if (adminRes.success) {
          showAlert('Kredensial redaksi valid! Mengalihkan ke Studio Redaksi...', 'success');
          setTimeout(() => {
            window.location.href = `${basePath}/admin`;
          }, 400);
          return;
        }

        // Jika bukan admin, coba login Penulis Santri
        const penulisRes = await loginPenulis(identifier, password);
        if (penulisRes.success) {
          showAlert('Selamat datang, ' + (penulisRes.user?.nama || 'Penulis') + '! Mengalihkan...', 'success');
          setTimeout(() => {
            window.location.href = `${basePath}/kirim`;
          }, 400);
          return;
        }

        // Gagal login di kedua kanal
        showAlert(adminRes.message || 'Nama pengguna atau kata sandi tidak cocok. Silakan periksa kembali.', 'error');
      } catch (err: any) {
        showAlert('Terjadi kendala jaringan: ' + (err.message || 'Coba lagi'), 'error');
      } finally {
        btnLoginSubmit.disabled = false;
        btnLoginSubmit.innerHTML = '<span>Masuk ke Studio Redaksi →</span>';
      }
    });

    // 7. SUBMIT DAFTAR SANTRI HANDLER
    formDaftarSantri?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nama = (document.getElementById('daftar-nama') as HTMLInputElement).value.trim();
      const kelas = (document.getElementById('daftar-kelas') as HTMLInputElement).value.trim();
      const kontak = (document.getElementById('daftar-kontak') as HTMLInputElement).value.trim();
      const email = (document.getElementById('daftar-email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('daftar-password') as HTMLInputElement).value;

      if (!nama || !kelas || !email || !password) {
        showAlert('Harap lengkapi semua kolom wajib pendaftaran.', 'error');
        return;
      }

      btnDaftarSubmit.disabled = true;
      btnDaftarSubmit.textContent = 'Mendaftarkan akun santri...';

      try {
        const res = await daftarPenulis({ nama, kelas, kontak, email, password });
        if (res.success) {
          showAlert(res.message + ' Mengalihkan ke formulir kirim naskah...', 'success');
          setTimeout(() => {
            window.location.href = `${basePath}/kirim`;
          }, 600);
        } else {
          showAlert(res.message, 'error');
        }
      } catch (err: any) {
        showAlert('Gagal mendaftar: ' + (err.message || 'Coba lagi'), 'error');
      } finally {
        btnDaftarSubmit.disabled = false;
        btnDaftarSubmit.textContent = 'Daftarkan Akun Penulis →';
      }
    });
  </script>
</Layout>
