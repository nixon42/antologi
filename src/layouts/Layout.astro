---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = "Ruang Sastra — SMPI Yambu'ul Qur'an",
  description = "Portal Literasi & Apresiasi Karya — Wadah publikasi karya tulis ilmiah, puisi & prosa, cerpen, antologi, naskah drama, dan quotes santri SMPI Yambu'ul Qur'an.",
  image = "/images/og-ruang-sastra.png",
  type = "website",
} = Astro.props;

const siteURL = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://sastra.ueeee.my.id';
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(image, siteURL).href;
const currentPath = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL.href} />

  <!-- Open Graph / Facebook / WhatsApp (Wajib Absolute URL & HTTPS) -->
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Ruang Sastra — SMPI Yambu'ul Qur'an" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:locale" content="id_ID" />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:secure_url" content={imageURL} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />

  <!-- Schema.org Microdata (WhatsApp / Google Crawlers) -->
  <meta itemprop="name" content={title} />
  <meta itemprop="description" content={description} />
  <meta itemprop="image" content={imageURL} />

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL.href} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  <!-- Mobile & Favicon Icons -->
  <link rel="apple-touch-icon" sizes="180x180" href={`${siteURL}/apple-touch-icon.png`} />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='46' fill='%23efeae0' stroke='%237c2d26' stroke-width='6'/><text x='50' y='62' font-family='serif' font-size='42' font-weight='bold' fill='%237c2d26' text-anchor='middle'>YQ</text></svg>" />

  <!-- Theme & Reader Font Early Script (Prevents FOUC) -->
  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('rs_theme') || 'paper';
      const savedFont = localStorage.getItem('rs_font') || 'serif';
      const savedSize = localStorage.getItem('rs_size') || '17';

      if (savedTheme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else if (savedTheme === 'sepia') {
        document.documentElement.setAttribute('data-theme', 'sepia');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }

      if (savedFont === 'sans') {
        document.documentElement.setAttribute('data-font', 'sans');
      }
      document.documentElement.style.setProperty('--reader-font-size', (savedSize / 16) + 'rem');
    })();
  </script>
</head>

<body>
  <!-- Reading Progress Bar (for articles) -->
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-1 bg-[var(--crimson)] z-50 w-0 transition-all duration-75" aria-hidden="true"></div>

  <!-- Masthead Header: Sleek, compact on mobile, majestic on desktop -->
  <header class="sticky top-0 z-40 bg-[var(--paper)]/95 backdrop-blur-md border-b border-[var(--rule-strong)] transition-colors duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-[4.25rem] flex items-center justify-between gap-4 lg:gap-8">
      
      <!-- Brand & Monogram -->
      <a href={`${basePath}/`} class="flex items-center gap-3 no-underline group flex-shrink-0" aria-label="Ruang Sastra — SMPI Yambu'ul Qur'an">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border-[1.5px] border-[var(--crimson)] flex items-center justify-center font-['Fraunces',serif] font-bold text-sm text-[var(--crimson)] group-hover:bg-[var(--crimson)] group-hover:text-[var(--paper)] transition-all duration-200 shadow-inner flex-shrink-0">
          YQ
        </div>
        <div class="flex flex-col">
          <span class="font-['Fraunces',serif] font-semibold text-lg sm:text-xl leading-none text-[var(--ink)] tracking-tight">
            Ruang <span class="italic font-normal text-[var(--crimson)]">Sastra</span>
          </span>
          <span class="hidden sm:block mono text-[0.66rem] uppercase tracking-widest text-[var(--ink-faint)] mt-1 font-medium">
            SMPI Yambu'ul Qur'an
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links (Clean, Serif, Never Wraps) -->
      <nav class="hidden md:flex items-center gap-5 lg:gap-7 text-sm font-['Source_Serif_4',serif]" aria-label="Navigasi Utama">
        <a 
          href={`${basePath}/karya`} 
          class={`no-underline whitespace-nowrap py-1 transition-colors relative font-medium ${currentPath.includes('/karya') ? 'text-[var(--crimson)] font-semibold border-b-2 border-[var(--crimson)]' : 'text-[var(--ink)] hover:text-[var(--crimson)] border-b-2 border-transparent hover:border-[var(--crimson)]'}`}
        >
          Pojok Baca
        </a>
        <a 
          href={`${basePath}/#karya-pilihan`} 
          class="no-underline whitespace-nowrap py-1 text-[var(--ink)] hover:text-[var(--crimson)] transition-colors font-medium border-b-2 border-transparent hover:border-[var(--crimson)]"
        >
          Karya Pilihan
        </a>
        <a 
          href={`${basePath}/panggung`} 
          class={`no-underline whitespace-nowrap py-1 transition-colors relative font-medium ${currentPath.includes('/panggung') ? 'text-[var(--crimson)] font-semibold border-b-2 border-[var(--crimson)]' : 'text-[var(--ink)] hover:text-[var(--crimson)] border-b-2 border-transparent hover:border-[var(--crimson)]'}`}
        >
          Panggung Sastra
        </a>
        <a 
          href={`${basePath}/quotes`} 
          class={`no-underline whitespace-nowrap py-1 transition-colors relative font-medium ${currentPath.includes('/quotes') ? 'text-[var(--crimson)] font-semibold border-b-2 border-[var(--crimson)]' : 'text-[var(--ink)] hover:text-[var(--crimson)] border-b-2 border-transparent hover:border-[var(--crimson)]'}`}
        >
          Quotes
        </a>
        <a 
          href={`${basePath}/#tentang`} 
          class="no-underline whitespace-nowrap py-1 text-[var(--ink)] hover:text-[var(--crimson)] transition-colors font-medium border-b-2 border-transparent hover:border-[var(--crimson)]"
        >
          Tentang
        </a>
      </nav>

      <!-- Right Utility Group + CTA -->
      <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
        <!-- Search Trigger Button -->
        <button 
          id="search-modal-trigger" 
          class="flex items-center gap-1.5 sm:gap-2 px-2.5 py-1.5 rounded-full border border-[var(--rule-strong)] hover:border-[var(--crimson)] bg-[var(--paper-card)] text-[var(--ink-soft)] hover:text-[var(--crimson)] transition-colors text-xs mono cursor-pointer shadow-2xs" 
          title="Cari Karya Sastra & Penulis (Ctrl+K)" 
          aria-label="Buka Pencarian"
        >
          <svg class="w-3.5 h-3.5" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span class="hidden xl:inline text-[0.72rem] text-[var(--ink-faint)]">Cari...</span>
          <kbd class="hidden xl:inline px-1 py-0.2 bg-[var(--paper-deep)] border border-[var(--rule)] rounded text-[0.62rem] text-[var(--ink-faint)]">⌘K</kbd>
        </button>

        <!-- Theme Mode Toggle Dropdown / Cycle -->
        <button 
          id="theme-cycle-button" 
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-full border border-[var(--rule-strong)] hover:border-[var(--crimson)] bg-[var(--paper-card)] text-[var(--ink-soft)] hover:text-[var(--crimson)] transition-colors text-xs mono cursor-pointer shadow-2xs" 
          title="Ganti Mode Tampilan (Kertas / Sepia / Tinta Malam)" 
          aria-label="Ganti Tema"
        >
          <svg class="w-3.5 h-3.5" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <span id="theme-label" class="hidden xl:inline text-[0.72rem]">Kertas</span>
        </button>

        <!-- Font Size Adjuster (Desktop Only) -->
        <div class="hidden lg:flex items-center rounded-full border border-[var(--rule-strong)] bg-[var(--paper-card)] px-1 py-0.5 text-xs mono shadow-2xs">
          <button id="font-dec-button" class="px-2 py-0.5 hover:text-[var(--crimson)] text-[var(--ink-soft)] transition-colors cursor-pointer text-[0.72rem] font-medium" title="Perkecil Ukuran Teks">A-</button>
          <span class="w-[1px] h-3 bg-[var(--rule-strong)]"></span>
          <button id="font-inc-button" class="px-2 py-0.5 hover:text-[var(--crimson)] text-[var(--ink-soft)] transition-colors cursor-pointer text-[0.72rem] font-medium" title="Perbesar Ukuran Teks">A+</button>
        </div>

        <!-- Vertical Divider (Desktop) -->
        <span class="hidden md:block w-[1px] h-5 bg-[var(--rule-strong)] mx-0.5"></span>

        <!-- Kirim Karya Solid CTA -->
        <a 
          href={`${basePath}/kirim`} 
          class="hidden md:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-[var(--crimson)] hover:bg-[var(--crimson-soft)] text-[var(--paper)] text-xs mono font-semibold tracking-wide transition-all shadow-xs whitespace-nowrap no-underline cursor-pointer"
        >
          <span>Kirim Karya</span>
          <span class="text-xs">→</span>
        </a>

        <!-- Mobile Menu Toggle Button (Hamburger / Close) -->
        <button 
          id="mobile-menu-toggle"
          class="md:hidden p-2 text-[var(--ink)] hover:text-[var(--crimson)] hover:bg-[var(--paper-deep)] rounded transition-colors"
          aria-label="Buka Menu Navigasi"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-5 h-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Drawer Menu (Collapsible, Sleek, Literary) -->
    <div 
      id="mobile-menu-drawer" 
      class="hidden md:hidden bg-[var(--paper-card)] border-t border-[var(--rule)] px-4 py-4 space-y-3 shadow-xl transition-all"
    >
      <nav class="flex flex-col space-y-1.5 text-sm font-medium" aria-label="Navigasi Mobile">
        <a href={`${basePath}/`} class="py-2 px-3 rounded hover:bg-[var(--paper-deep)] text-[var(--ink)] no-underline flex items-center justify-between">
          <span>Beranda</span>
          <span class="mono text-xs text-[var(--ink-faint)]">⌂</span>
        </a>
        <a href={`${basePath}/karya`} class="py-2 px-3 rounded hover:bg-[var(--paper-deep)] text-[var(--ink)] no-underline flex items-center justify-between">
          <span>Pojok Baca (Arsip Karya)</span>
          <span class="mono text-xs text-[var(--crimson)]">Katalog</span>
        </a>
        <a href={`${basePath}/#karya-pilihan`} class="py-2 px-3 rounded hover:bg-[var(--paper-deep)] text-[var(--ink)] no-underline flex items-center justify-between">
          <span>Karya Pilihan Redaksi</span>
          <span class="mono text-xs text-[var(--gold)]">★</span>
        </a>
        <a href={`${basePath}/panggung`} class="py-2 px-3 rounded hover:bg-[var(--paper-deep)] text-[var(--ink)] no-underline flex items-center justify-between">
          <span>Panggung Sastra &amp; Teater</span>
          <span class="mono text-xs text-[var(--ink-faint)]">▶</span>
        </a>
        <a href={`${basePath}/quotes`} class="py-2 px-3 rounded hover:bg-[var(--paper-deep)] text-[var(--ink)] no-underline flex items-center justify-between">
          <span>Quotes &amp; Mutiara Kata</span>
          <span class="mono text-xs text-[var(--ink-faint)]">“ ”</span>
        </a>
        <a href={`${basePath}/#tentang`} class="py-2 px-3 rounded hover:bg-[var(--paper-deep)] text-[var(--ink)] no-underline flex items-center justify-between">
          <span>Tentang Portal</span>
          <span class="mono text-xs text-[var(--ink-faint)]">❧</span>
        </a>
      </nav>

      <div class="border-t border-[var(--rule)] pt-3 flex items-center justify-between gap-2">
        <!-- Font Size for Mobile in Drawer -->
        <div class="flex items-center gap-2">
          <span class="mono text-[0.72rem] text-[var(--ink-faint)]">Ukuran Teks:</span>
          <div class="flex items-center border border-[var(--rule-strong)] rounded text-xs mono">
            <button id="font-dec-button-m" class="px-2 py-0.5 hover:bg-[var(--paper-deep)]">A-</button>
            <button id="font-inc-button-m" class="px-2 py-0.5 hover:bg-[var(--paper-deep)] border-l border-[var(--rule-strong)]">A+</button>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a href={`${basePath}/admin`} class="mono text-xs text-[var(--crimson)] font-semibold no-underline hover:underline flex items-center gap-1">
            <span>Studio Redaksi</span>
            <span>✎</span>
          </a>
          <span id="drawer-logout-divider" class="hidden text-[var(--ink-faint)] text-xs">·</span>
          <a id="drawer-logout-link" href={`${basePath}/admin/login?logout=1`} class="hidden mono text-xs text-[var(--crimson)] hover:underline">
            Keluar
          </a>
        </div>
      </div>

      <a href={`${basePath}/kirim`} class="btn-literary btn-literary-solid !w-full !py-2.5 !text-center text-xs block no-underline mt-2">
        Kirim Naskah Baru →
      </a>
    </div>
  </header>

  <!-- Main Slot Content -->
  <main id="main-content" class="min-h-[75vh]">
    <slot />
  </main>

  <!-- Search Modal Dialog Component -->
  <div id="search-modal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="Pencarian Karya">
    <div class="bg-[var(--paper)] border border-[var(--rule-strong)] w-full max-w-xl rounded shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
      <div class="p-4 border-b border-[var(--rule-strong)] flex items-center gap-3">
        <svg class="w-5 h-5 text-[var(--ink-faint)]" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input 
          id="search-input" 
          type="search" 
          placeholder="Cari judul, puisi, cerpen, penulis, atau kata kunci..." 
          class="w-full bg-transparent border-none outline-none text-[var(--ink)] font-['Source_Serif_4',serif] text-base placeholder:text-[var(--ink-faint)] placeholder:italic"
          autocomplete="off"
        />
        <button id="close-search-button" class="text-xs mono p-1 text-[var(--ink-faint)] hover:text-[var(--ink)]">
          ESC
        </button>
      </div>
      <div id="search-results" class="max-h-96 overflow-y-auto p-4 space-y-2">
        <p class="text-xs text-[var(--ink-faint)] mono text-center py-6">Ketik minimal 2 huruf untuk mulai mencari karya...</p>
      </div>
    </div>
  </div>

  <!-- Literary Colophon Footer -->
  <footer class="border-t border-[var(--rule-strong)] bg-[var(--paper)] mt-24 py-12 text-[var(--ink-faint)] font-['IBM_Plex_Mono',monospace] text-xs transition-colors">
    <div class="wrap space-y-8">
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2 space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full border border-[var(--crimson)] flex items-center justify-center font-['Fraunces',serif] font-semibold text-xs text-[var(--crimson)]">YQ</span>
            <span class="font-['Fraunces',serif] font-semibold text-base text-[var(--ink)]">Ruang Sastra</span>
          </div>
          <p class="text-[0.82rem] leading-relaxed max-w-md font-['Source_Serif_4',serif] italic text-[var(--ink-soft)]">
            "Di sini, tulisan bukan sekadar susunan huruf, dan panggung bukan sekadar tempat berakting. Portal ini adalah ruang apresiasi tempat para siswa mengasah nalar kritis, merajut imajinasi, dan menuangkan gagasan."
          </p>
          <p class="text-[0.72rem] text-[var(--ink-faint)]">
            Portal Literasi SMPI Yambu'ul Qur'an · Berbasis Git &amp; GitHub Pages
          </p>
        </div>

        <div>
          <h4 class="font-semibold text-[var(--ink)] text-xs uppercase tracking-wider mb-3">Ragam Karya</h4>
          <ul class="space-y-2 list-none p-0 m-0 text-[0.78rem]">
            <li><a href={`${basePath}/karya?kategori=ilmiah`} class="hover:text-[var(--crimson)] transition-colors">Karya Tulis Ilmiah</a></li>
            <li><a href={`${basePath}/karya?kategori=puisi`} class="hover:text-[var(--crimson)] transition-colors">Puisi &amp; Prosa</a></li>
            <li><a href={`${basePath}/karya?kategori=cerpen`} class="hover:text-[var(--crimson)] transition-colors">Cerpen Santri</a></li>
            <li><a href={`${basePath}/karya?kategori=drama`} class="hover:text-[var(--crimson)] transition-colors">Naskah Lakon Drama</a></li>
            <li><a href={`${basePath}/karya?kategori=antologi`} class="hover:text-[var(--crimson)] transition-colors">Antologi Bersama</a></li>
            <li><a href={`${basePath}/quotes`} class="hover:text-[var(--crimson)] transition-colors">Kutipan / Quotes</a></li>
          </ul>
        </div>

        <div>
          <h4 class="font-semibold text-[var(--ink)] text-xs uppercase tracking-wider mb-3">Redaksi &amp; Akses</h4>
          <ul class="space-y-2 list-none p-0 m-0 text-[0.78rem]">
            <li><a href={`${basePath}/#tentang`} class="hover:text-[var(--crimson)] transition-colors">Tentang Portal</a></li>
            <li><a href={`${basePath}/kirim`} class="hover:text-[var(--crimson)] transition-colors">Kirim Naskah Baru</a></li>
            <li><a href={`${basePath}/admin`} class="hover:text-[var(--crimson)] transition-colors font-semibold text-[var(--crimson)]">Studio Redaksi &amp; Live Editor ✎</a></li>
            <li><a href={`${basePath}/admin/login`} class="hover:text-[var(--crimson)] transition-colors">Masuk Redaksi (Login)</a></li>
            <li id="footer-logout-item" class="hidden"><a href={`${basePath}/admin/login?logout=1`} class="text-[var(--crimson)] hover:underline font-semibold">Keluar dari Sesi Redaksi →</a></li>
            <li><a href={`${basePath}/panggung`} class="hover:text-[var(--crimson)] transition-colors">Panggung Teater</a></li>
            <li><a href={`${basePath}/sitemap-index.xml`} class="hover:text-[var(--crimson)] transition-colors">Peta Situs (Sitemap)</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-[var(--rule)] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-[0.72rem]">
        <p>© Ekstrakurikuler Literatur &amp; Sastra — SMPI Yambu'ul Qur'an. Hak cipta setiap karya tetap menjadi milik penulisnya.</p>
        <p class="text-right">Dicetak di Ruang Sastra · Versi 1.0.0</p>
      </div>

    </div>
  </footer>

  <!-- Client Interaction Scripts -->
  <script>
    // Theme Switcher Cycle: Paper -> Sepia -> Dark -> Paper
    const themes = ['paper', 'sepia', 'dark'];
    const themeLabels: Record<string, string> = { paper: 'Kertas', sepia: 'Sepia', dark: 'Malam' };
    const themeButton = document.getElementById('theme-cycle-button');
    const themeLabel = document.getElementById('theme-label');

    function updateThemeUI(theme: string) {
      if (themeLabel) themeLabel.textContent = themeLabels[theme] || 'Kertas';
    }

    if (themeButton) {
      themeButton.addEventListener('click', () => {
        const currentTheme = localStorage.getItem('rs_theme') || 'paper';
        const nextIndex = (themes.indexOf(currentTheme) + 1) % themes.length;
        const nextTheme = themes[nextIndex];

        if (nextTheme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else if (nextTheme === 'sepia') {
          document.documentElement.setAttribute('data-theme', 'sepia');
        } else {
          document.documentElement.removeAttribute('data-theme');
        }

        localStorage.setItem('rs_theme', nextTheme);
        updateThemeUI(nextTheme);
      });
      updateThemeUI(localStorage.getItem('rs_theme') || 'paper');
    }

    // Font Sizing Controls
    let currentSize = parseInt(localStorage.getItem('rs_size') || '17', 10);
    const fontInc = document.getElementById('font-inc-button');
    const fontDec = document.getElementById('font-dec-button');
    const fontIncM = document.getElementById('font-inc-button-m');
    const fontDecM = document.getElementById('font-dec-button-m');

    function setFontSize(size: number) {
      currentSize = Math.max(14, Math.min(22, size));
      document.documentElement.style.setProperty('--reader-font-size', (currentSize / 16) + 'rem');
      localStorage.setItem('rs_size', currentSize.toString());
    }

    if (fontInc) fontInc.addEventListener('click', () => setFontSize(currentSize + 1));
    if (fontDec) fontDec.addEventListener('click', () => setFontSize(currentSize - 1));
    if (fontIncM) fontIncM.addEventListener('click', () => setFontSize(currentSize + 1));
    if (fontDecM) fontDecM.addEventListener('click', () => setFontSize(currentSize - 1));

    // Mobile Navigation Drawer Toggle
    const mobileToggle = document.getElementById('mobile-menu-toggle');
    const mobileDrawer = document.getElementById('mobile-menu-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    mobileToggle?.addEventListener('click', () => {
      const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
      const willExpand = !isExpanded;
      mobileToggle.setAttribute('aria-expanded', willExpand.toString());

      if (willExpand) {
        mobileDrawer?.classList.remove('hidden');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        mobileDrawer?.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    });

    // Close mobile menu on link click
    mobileDrawer?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileDrawer?.classList.add('hidden');
        mobileToggle?.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });

    // Reading Progress Indicator
    window.addEventListener('scroll', () => {
      const progressBar = document.getElementById('reading-progress-bar');
      if (!progressBar) return;
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      progressBar.style.width = scrolled + '%';
    });

    // Search Modal Controls (Ctrl+K or Button)
    const searchModal = document.getElementById('search-modal');
    const searchTrigger = document.getElementById('search-modal-trigger');
    const searchClose = document.getElementById('close-search-button');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;

    function openSearch() {
      if (!searchModal) return;
      searchModal.classList.remove('hidden');
      searchModal.classList.add('flex');
      setTimeout(() => searchInput?.focus(), 50);
    }

    function closeSearch() {
      if (!searchModal) return;
      searchModal.classList.add('hidden');
      searchModal.classList.remove('flex');
    }

    if (searchTrigger) searchTrigger.addEventListener('click', openSearch);
    if (searchClose) searchClose.addEventListener('click', closeSearch);

    searchModal?.addEventListener('click', (e) => {
      if (e.target === searchModal) closeSearch();
    });

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openSearch();
      } else if (e.key === 'Escape') {
        closeSearch();
      }
    });

    // Fetch search index and listen to input
    interface SearchResultItem {
      title: string;
      author: string;
      category?: string;
      categoryLabel?: string;
      description?: string;
      tags?: string[];
      url: string;
      type?: string;
    }

    let searchIndex: SearchResultItem[] | null = null;
    async function loadSearchIndex() {
      if (!searchIndex) {
        try {
          const res = await fetch(`${import.meta.env.BASE_URL}search-index.json`);
          if (res.ok) searchIndex = await res.json();
        } catch (e) {
          console.warn('Index pencarian belum tersedia:', e);
        }
      }
      return searchIndex || [];
    }

    searchInput?.addEventListener('input', async (e) => {
      const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      const resultsContainer = document.getElementById('search-results');
      if (!resultsContainer) return;

      if (query.length < 2) {
        resultsContainer.innerHTML = '<p class="text-xs text-[var(--ink-faint)] mono text-center py-6">Ketik minimal 2 huruf untuk mulai mencari karya...</p>';
        return;
      }

      const items = await loadSearchIndex();
      const matched = items.filter((item: SearchResultItem) => 
        item.title.toLowerCase().includes(query) ||
        item.author.toLowerCase().includes(query) ||
        (item.description && item.description.toLowerCase().includes(query)) ||
        (item.tags && item.tags.some((t: string) => t.toLowerCase().includes(query)))
      );

      if (matched.length === 0) {
        resultsContainer.innerHTML = `<p class="text-xs text-[var(--ink-faint)] mono text-center py-6">Tidak ditemukan karya yang cocok dengan "${query}".</p>`;
        return;
      }

      resultsContainer.innerHTML = matched.map((item: SearchResultItem) => `
        <a href="${item.url}" class="block p-3 rounded hover:bg-[var(--paper-deep)] border-b border-[var(--rule)] no-underline group transition-colors">
          <div class="flex items-center justify-between gap-2">
            <h5 class="text-sm font-semibold text-[var(--ink)] group-hover:text-[var(--crimson)] transition-colors m-0 font-['Fraunces',serif]">
              ${item.title}
            </h5>
            <span class="mono text-[0.68rem] px-2 py-0.5 rounded-full border border-[var(--rule-strong)] text-[var(--ink-soft)]">
              ${item.categoryLabel}
            </span>
          </div>
          <p class="text-xs text-[var(--ink-soft)] italic m-0 mt-1 line-clamp-1 font-['Source_Serif_4',serif]">
            ${item.description || item.author}
          </p>
        </a>
      `).join('');
    });

    // Tampilkan tombol keluar jika sesi redaksi sedang aktif
    try {
      if (typeof window !== 'undefined') {
        const hasSession = localStorage.getItem('rs_admin_session') || 
          Object.keys(localStorage).some(k => k.startsWith('sb-') && k.endsWith('-auth-token'));
        if (hasSession) {
          document.getElementById('drawer-logout-divider')?.classList.remove('hidden');
          document.getElementById('drawer-logout-link')?.classList.remove('hidden');
          document.getElementById('footer-logout-item')?.classList.remove('hidden');
        }
      }
    } catch {}
  </script>
</body>
</html>
