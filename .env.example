# Kredensial Firebase (Opsional - Jika ingin mengaktifkan fitur interaktif online)
# Dapatkan dari Firebase Console > Project Settings > General > Your apps > SDK setup/config

PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN="ruang-sastra-yq.firebaseapp.com"
PUBLIC_FIREBASE_PROJECT_ID="ruang-sastra-yq"
PUBLIC_FIREBASE_STORAGE_BUCKET="ruang-sastra-yq.appspot.com"
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""

# Base Path untuk GitHub Pages (jika di-host di https://<username>.github.io/<repo>/)
# Jika custom domain atau user page, biarkan kosong atau "/"
BASE_PATH="/"
