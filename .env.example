# Kredensial Supabase (Database PostgreSQL & File Storage Gratis)
# Dapatkan di: https://supabase.com > Dashboard > Project Settings > API
PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Base Path untuk GitHub Pages
# Jika di-host di https://<username>.github.io/<repo>/ maka isi "/<repo>/"
# Jika menggunakan custom domain atau root domain, biarkan "/"
BASE_PATH="/"
